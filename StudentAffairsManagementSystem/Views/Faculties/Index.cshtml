@model IEnumerable<StudentAffairsManagementSystem.Models.Faculty>

@{
    ViewData["Title"] = "إدارة الكليات";

    var faculties = Model?.ToList()
        ?? new List<StudentAffairsManagementSystem.Models.Faculty>();

    bool isAdmin = User.IsInRole("Admin");
}

<style>
    .faculties-page {
        max-width: 900px;
        margin: 0 auto;
        color: #142d4e;
    }

    /* عنوان الصفحة */

    .faculties-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 25px;
    }

        .faculties-header h2 {
            font-size: 25px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .faculties-header p {
            color: #718096;
            margin: 0;
        }

    /* زر إضافة كلية */

    .faculties-add {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        background: #c9a24d;
        color: #142d4e;
        border-radius: 11px;
        padding: 12px 20px;
        text-decoration: none;
        font-weight: 800;
        transition: background-color 0.2s ease;
    }

        .faculties-add:hover {
            background: #b9913d;
            color: #142d4e;
        }

    /* بطاقة اختيار الكلية */

    .faculties-card {
        background: white;
        border: 1px solid #e5eaf2;
        border-top: 4px solid #c9a24d;
        border-radius: 15px;
        padding: 28px;
    }

    .faculties-label {
        display: block;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .faculties-select {
        width: 100%;
        border: 1px solid #d9e1eb;
        border-radius: 10px;
        padding: 14px;
        background: white;
        color: #142d4e;
        font-size: 16px;
    }

        .faculties-select:focus {
            outline: none;
            border-color: #c9a24d;
            box-shadow: 0 0 0 3px rgba(201, 162, 77, 0.12);
        }

    /* بيانات الكلية المحددة */

    .faculty-details {
        display: none;
        margin-top: 25px;
        padding: 22px;
        background: #f8f9fc;
        border-radius: 12px;
    }

    .faculty-name {
        font-size: 22px;
        font-weight: 800;
        margin-bottom: 14px;
    }

    /* حالة الكلية */

    .faculty-status {
        display: inline-block;
        border-radius: 8px;
        padding: 7px 13px;
        font-size: 13px;
        font-weight: 700;
    }

    .faculty-active {
        background: #e8f6ee;
        color: #197647;
    }

    .faculty-inactive {
        background: #fff0ee;
        color: #b42318;
    }

    /* أزرار الإجراءات الموحدة */

    .faculty-actions {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
    }

    .faculty-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 43px;
        padding: 9px 15px;
        border-radius: 11px;
        border: 1px solid transparent;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        white-space: nowrap;
        transition: background-color 0.2s ease, transform 0.2s ease;
    }

        .faculty-action i {
            font-size: 16px;
        }

    /* زر عرض التفاصيل */

    .faculty-action-details {
        background: #eef2f8;
        color: #142d4e;
    }

        .faculty-action-details:hover {
            background: #dfe7f2;
            color: #142d4e;
            transform: translateY(-1px);
        }

    /* زر تعديل */

    .faculty-edit {
        background: #c9a24d;
        color: #142d4e;
    }

        .faculty-edit:hover {
            background: #b9913d;
            color: #142d4e;
            transform: translateY(-1px);
        }

    /* زر حذف */

    .faculty-delete {
        background: #fff0ee;
        color: #c62828;
        border-color: #ffc5bf;
    }

        .faculty-delete:hover {
            background: #ffe0dc;
            color: #a91e1e;
            border-color: #f2a8a0;
            transform: translateY(-1px);
        }

    .faculty-action:focus-visible {
        outline: 3px solid #142d4e;
        outline-offset: 3px;
    }

    /* الرسائل */

    .faculties-message {
        color: #718096;
        margin-top: 15px;
    }

    /* الشاشات الصغيرة */

    @@media (max-width: 600px) {
        .faculties-card {
            padding: 18px;
        }

        .faculty-details {
            padding: 16px;
        }

        .faculty-actions {
            gap: 8px;
        }
    }
</style>

<div class="faculties-page" dir="rtl">

    <!-- عنوان الصفحة -->

    <div class="faculties-header">

        <div>
            <h2>إدارة الكليات</h2>
            <p>اختر كلية لعرض بياناتها وإدارتها.</p>
        </div>

        @if (isAdmin)
        {
            <a asp-controller="Faculties"
               asp-action="Create"
               class="faculties-add">

                <i class="bi bi-plus-circle"></i>
                إضافة كلية جديدة

            </a>
        }

    </div>

    <!-- رسائل النظام -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- اختيار الكلية -->

    <div class="faculties-card">

        <label for="facultySelect"
               class="faculties-label">

            الكلية

        </label>

        <select id="facultySelect"
                class="faculties-select">

            <option value="">
                -- اختر الكلية --
            </option>

            @foreach (var faculty in faculties)
            {
                <option value="@faculty.Id">
                    @faculty.Name
                </option>
            }

        </select>

        @if (!faculties.Any())
        {
            <p class="faculties-message">
                لا توجد كليات مسجلة حاليًا.
            </p>
        }

        <!-- تفاصيل الكليات -->
        @foreach (var faculty in faculties)
        {
            <div class="faculty-details"
                 id="faculty-@faculty.Id">

                <div class="faculty-name">
                    @faculty.Name
                </div>

                <!-- حالة الكلية -->
                @if (faculty.IsActive)
                {
                    <span class="faculty-status faculty-active">
                        كلية فعّالة
                    </span>
                }
                else
                {
                    <span class="faculty-status faculty-inactive">
                        كلية غير فعّالة
                    </span>
                }

                <!-- أزرار الإجراءات -->

                <div class="faculty-actions">

                    <!-- عرض التفاصيل -->

                    <a asp-controller="Faculties"
                       asp-action="Details"
                       asp-route-id="@faculty.Id"
                       class="faculty-action faculty-action-details">

                        <i class="bi bi-eye"></i>
                        عرض التفاصيل

                    </a>

                    @if (isAdmin)
                    {
                        <!-- تعديل -->

                        <a asp-controller="Faculties"
                           asp-action="Edit"
                           asp-route-id="@faculty.Id"
                           class="faculty-action faculty-edit">

                            <i class="bi bi-pencil-square"></i>
                            تعديل

                        </a>

                        <!-- حذف -->

                        <a asp-controller="Faculties"
                           asp-action="Delete"
                           asp-route-id="@faculty.Id"
                           class="faculty-action faculty-delete">

                            <i class="bi bi-trash3"></i>
                            حذف

                        </a>
                    }

                </div>

            </div>
        }

    </div>

</div>

<!-- إظهار الكلية المحددة -->

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const select =
            document.getElementById("facultySelect");

        const details =
            document.querySelectorAll(".faculty-details");

        if (!select) {
            return;
        }

        function showSelectedFaculty() {

            details.forEach(function (item) {
                item.style.display = "none";
            });

            if (!select.value) {
                return;
            }

            const selected =
                document.getElementById(
                    "faculty-" + select.value
                );

            if (selected) {
                selected.style.display = "block";
            }
        }

        select.addEventListener(
            "change",
            showSelectedFaculty
        );

        showSelectedFaculty();

    });
</script>
