@model StudentAffairsManagementSystem.Models.CourseOffering

@{
    ViewData["Title"] = "تعديل المقرر المطروح";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 style="color:#142d4e; font-weight:800;">
                تعديل المقرر المطروح
            </h2>

            <p class="text-muted mb-0">
                تعديل المقرر الدراسي والفصل الدراسي والسعة الاستيعابية
            </p>
        </div>

        <a asp-controller="CourseOfferings"
           asp-action="Index"
           class="btn btn-outline-secondary px-4">
            العودة إلى القائمة
        </a>

    </div>

    <!-- نموذج التعديل -->
    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header py-3"
                     style="background:#142d4e; color:white;">
                    <h5 class="mb-0">
                        تعديل بيانات المقرر المطروح
                    </h5>
                </div>

                <div class="card-body p-4">

                    <form asp-controller="CourseOfferings"
                          asp-action="Edit"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="row g-4">

                            <!-- المقرر الدراسي -->
                            <div class="col-md-6">

                                <label asp-for="CourseId"
                                       class="form-label fw-bold">
                                    المقرر الدراسي
                                    <span class="text-danger">*</span>
                                </label>

                                <select asp-for="CourseId"
                                        asp-items="ViewBag.CourseId"
                                        class="form-select">

                                    <option value="">
                                        -- اختر المقرر الدراسي --
                                    </option>

                                </select>

                                <span asp-validation-for="CourseId"
                                      class="text-danger small"></span>

                            </div>

                            <!-- الفصل الدراسي -->
                            <div class="col-md-6">

                                <label asp-for="SemesterId"
                                       class="form-label fw-bold">
                                    الفصل الدراسي
                                    <span class="text-danger">*</span>
                                </label>

                                <select asp-for="SemesterId"
                                        asp-items="ViewBag.SemesterId"
                                        class="form-select">

                                    <option value="">
                                        -- اختر الفصل الدراسي --
                                    </option>

                                </select>

                                <span asp-validation-for="SemesterId"
                                      class="text-danger small"></span>

                            </div>

                            <!-- السعة الاستيعابية -->
                            <div class="col-md-6">

                                <label asp-for="Capacity"
                                       class="form-label fw-bold">
                                    السعة الاستيعابية
                                    <span class="text-danger">*</span>
                                </label>

                                <div class="input-group">

                                    <input asp-for="Capacity"
                                           type="number"
                                           min="1"
                                           step="1"
                                           class="form-control" />

                                    <span class="input-group-text">
                                        طالب
                                    </span>

                                </div>

                                <span asp-validation-for="Capacity"
                                      class="text-danger small"></span>

                                <div class="form-text">
                                    لا يمكن أن تقل السعة الاستيعابية
                                    عن عدد الطلاب المسجلين حاليًا في المقرر.
                                </div>

                            </div>

                        </div>

                        <!-- ملاحظات التعديل -->
                        <div class="alert alert-light border mt-4 mb-0">

                            <strong>ملاحظات مهمة قبل الحفظ:</strong>

                            <p class="mt-2 mb-2">
                                إذا كانت هناك تسجيلات طلاب مرتبطة
                                بهذا المقرر المطروح، فلن يسمح النظام
                                بتغيير المقرر الدراسي أو الفصل الدراسي.
                            </p>

                            <p class="mb-2">
                                يمكن تعديل السعة الاستيعابية بشرط
                                ألا تقل عن عدد الطلاب المسجلين حاليًا.
                            </p>

                            <p class="mb-2">
                                لا يمكن تكرار طرح المقرر الدراسي نفسه
                                في الفصل الدراسي ذاته.
                            </p>

                            <p class="mb-0">
                                لا يتطلب المقرر المطروح تعيين موظف مسؤول؛
                                يمكن للموظفين المخوّلين إدارة تسجيلاته
                                وفق صلاحيات النظام.
                            </p>

                        </div>

                        <!-- أزرار الإجراءات -->
                        <div class="d-flex justify-content-end gap-2 flex-wrap mt-4">

                            <a asp-controller="CourseOfferings"
                               asp-action="Details"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-secondary px-4">
                                إلغاء
                            </a>

                            <button type="submit"
                                    class="btn px-4"
                                    style="background:#c9a24d;
                                color:#142d4e;
                                font-weight:800;">
                                حفظ التعديلات
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
