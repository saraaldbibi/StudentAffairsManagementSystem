@model StudentAffairsManagementSystem.Models.CourseOffering

@{
    ViewData["Title"] = "تفاصيل المقرر المطروح";

    bool isAdmin = User.IsInRole("Admin");
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 style="color:#142d4e; font-weight:800;">
                تفاصيل المقرر المطروح
            </h2>

            <p class="text-muted mb-0">
                معلومات المقرر الدراسي والفصل الدراسي والسعة الاستيعابية
            </p>
        </div>

        <a asp-controller="CourseOfferings"
           asp-action="Index"
           class="btn btn-outline-secondary px-4">
            العودة إلى القائمة
        </a>

    </div>

    <div class="row g-4">

        <!-- بيانات المقرر الدراسي -->
        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header py-3"
                     style="background:#142d4e; color:white;">
                    <h5 class="mb-0">
                        بيانات المقرر الدراسي
                    </h5>
                </div>

                <div class="card-body p-4">

                    <div class="mb-4">
                        <div class="text-muted mb-2">
                            اسم المقرر
                        </div>

                        <h4 style="color:#142d4e; font-weight:800;">
                            @Model.Course.Name
                        </h4>
                    </div>

                    <hr />

                    <div class="mb-3">
                        <div class="text-muted mb-2">
                            رمز المقرر
                        </div>

                        <div class="fw-bold">
                            @Model.Course.Code
                        </div>
                    </div>

                    <hr />

                    <div>
                        <div class="text-muted mb-2">
                            الساعات المعتمدة
                        </div>

                        <div class="fw-bold">
                            @Model.Course.CreditHours ساعة
                        </div>
                    </div>

                </div>
            </div>

        </div>

        <!-- بيانات الفصل الدراسي -->
        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header py-3"
                     style="background:#142d4e; color:white;">
                    <h5 class="mb-0">
                        بيانات الفصل الدراسي
                    </h5>
                </div>

                <div class="card-body p-4">

                    <div class="mb-3">
                        <div class="text-muted mb-2">
                            الفصل الدراسي
                        </div>

                        <h4 style="color:#142d4e; font-weight:800;">
                            @Model.Semester.Name
                        </h4>
                    </div>

                    <hr />

                    <div class="mb-3">
                        <div class="text-muted mb-2">
                            العام الدراسي
                        </div>

                        <div class="fw-bold">
                            @Model.Semester.AcademicYear
                        </div>
                    </div>

                    <hr />

                    <div class="mb-3">
                        <div class="text-muted mb-2">
                            تاريخ بداية الفصل
                        </div>

                        <div class="fw-bold">
                            @Model.Semester.StartDate.ToString("yyyy/MM/dd")
                        </div>
                    </div>

                    <hr />

                    <div class="mb-3">
                        <div class="text-muted mb-2">
                            تاريخ نهاية الفصل
                        </div>

                        <div class="fw-bold">
                            @Model.Semester.EndDate.ToString("yyyy/MM/dd")
                        </div>
                    </div>

                    <hr />

                    <div>
                        <div class="text-muted mb-2">
                            حالة الفصل
                        </div>

                        @if (Model.Semester.IsActive)
                        {
                            <span class="badge bg-success px-3 py-2">
                                فعال
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary px-3 py-2">
                                غير فعال
                            </span>
                        }
                    </div>

                </div>
            </div>

        </div>

        <!-- السعة الاستيعابية -->
        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header py-3"
                     style="background:#142d4e; color:white;">
                    <h5 class="mb-0">
                        معلومات السعة الاستيعابية
                    </h5>
                </div>

                <div class="card-body p-4">

                    <div class="text-muted mb-3">
                        الحد الأقصى لعدد الطلاب
                    </div>

                    <h1 style="color:#c9a24d; font-weight:800;">
                        @Model.Capacity
                    </h1>

                    <p class="text-muted mb-0">
                        طالب كحد أقصى لهذا المقرر المطروح.
                    </p>

                    <div class="alert alert-light border mt-4 mb-0">
                        هذه السعة الكلية للمقرر، وليست عدد المقاعد
                        المتبقية أو عدد الطلاب المسجلين حاليًا.
                    </div>

                </div>
            </div>

        </div>

        <!-- معلومات إدارة التسجيل -->
        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header py-3"
                     style="background:#142d4e; color:white;">
                    <h5 class="mb-0">
                        إدارة تسجيل المقررات
                    </h5>
                </div>

                <div class="card-body p-4">

                    <div class="mb-3">
                        <div class="text-muted mb-2">
                            آلية إدارة التسجيل
                        </div>

                        <div class="fw-bold"
                             style="color:#142d4e;">
                            إدارة مشتركة وفق صلاحيات النظام
                        </div>
                    </div>

                    <hr />

                    <p class="text-muted mb-0">
                        لا يرتبط هذا المقرر المطروح بموظف مسؤول محدد.
                        يمكن للموظفين المخوّلين إدارة تسجيلات الطلاب
                        خلال فترة التسجيل التي تحددها إدارة الجامعة.
                    </p>

                </div>
            </div>

        </div>

    </div>

    <!-- أزرار الإجراءات -->
    <div class="d-flex justify-content-end gap-2 flex-wrap mt-4">

        <a asp-controller="CourseOfferings"
           asp-action="Index"
           class="btn btn-outline-secondary px-4">
            العودة إلى القائمة
        </a>

        @if (isAdmin)
        {
            <a asp-controller="CourseOfferings"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn px-4"
               style="background:#c9a24d;
                color:#142d4e;
                font-weight:800;">
                تعديل المقرر المطروح
            </a>

            <a asp-controller="CourseOfferings"
               asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-outline-danger px-4">
                حذف المقرر المطروح
            </a>
        }

    </div>

</div>
