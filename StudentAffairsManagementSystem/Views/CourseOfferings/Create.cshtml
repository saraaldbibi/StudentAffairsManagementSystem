@model StudentAffairsManagementSystem.Models.CourseOffering

@{
    ViewData["Title"] = "طرح مقرر جديد";
}

<div class="container-fluid py-4" dir="rtl">

    <div class="mb-4">
        <h2 style="color:#142d4e; font-weight:800;">
            طرح مقرر دراسي جديد
        </h2>

        <p class="text-muted mb-0">
            تحديد المقرر الدراسي والفصل الدراسي والسعة الاستيعابية
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header py-3"
                     style="background:#142d4e; color:white;">
                    <h5 class="mb-0">
                        بيانات المقرر المطروح
                    </h5>
                </div>

                <div class="card-body p-4">

                    <form asp-controller="CourseOfferings"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="row g-4">

                            <!-- المقرر الدراسي -->
                            <div class="col-md-6">

                                <label asp-for="CourseId"
                                       class="form-label fw-bold">
                                    المقرر الدراسي
                                    <span class="text-danger">*</span>
                                </label>

                                <select asp-for="CourseId"
                                        asp-items="ViewBag.CourseId"
                                        class="form-select">

                                    <option value="">
                                        -- اختر المقرر الدراسي --
                                    </option>

                                </select>

                                <span asp-validation-for="CourseId"
                                      class="text-danger small"></span>

                            </div>

                            <!-- الفصل الدراسي -->
                            <div class="col-md-6">

                                <label asp-for="SemesterId"
                                       class="form-label fw-bold">
                                    الفصل الدراسي
                                    <span class="text-danger">*</span>
                                </label>

                                <select asp-for="SemesterId"
                                        asp-items="ViewBag.SemesterId"
                                        class="form-select">

                                    <option value="">
                                        -- اختر الفصل الدراسي --
                                    </option>

                                </select>

                                <span asp-validation-for="SemesterId"
                                      class="text-danger small"></span>

                            </div>

                            <!-- السعة الاستيعابية -->
                            <div class="col-md-6">

                                <label asp-for="Capacity"
                                       class="form-label fw-bold">
                                    السعة الاستيعابية
                                    <span class="text-danger">*</span>
                                </label>

                                <div class="input-group">

                                    <input asp-for="Capacity"
                                           type="number"
                                           min="1"
                                           step="1"
                                           class="form-control"
                                           placeholder="أدخل عدد الطلاب" />

                                    <span class="input-group-text">
                                        طالب
                                    </span>

                                </div>

                                <span asp-validation-for="Capacity"
                                      class="text-danger small"></span>

                                <div class="form-text">
                                    يجب أن تكون السعة الاستيعابية أكبر من صفر.
                                </div>

                            </div>

                        </div>

                        <!-- ملاحظات مهمة -->
                        <div class="alert alert-light border mt-4 mb-0">

                            <strong>ملاحظات مهمة:</strong>

                            <p class="mb-1 mt-2">
                                لا يمكن طرح المقرر الدراسي نفسه أكثر من مرة
                                ضمن الفصل الدراسي ذاته وفق قواعد النظام الحالية.
                            </p>

                            <p class="mb-1">
                                يجب أن يكون المقرر الدراسي والفصل الدراسي
                                مسجلين مسبقًا في النظام.
                            </p>

                            <p class="mb-0">
                                لا يتطلب طرح المقرر تعيين موظف مسؤول؛
                                يمكن للموظفين المخوّلين إدارة تسجيلات الطلاب
                                وفق الصلاحيات المعتمدة في النظام.
                            </p>

                        </div>

                        <!-- الأزرار -->
                        <div class="d-flex justify-content-end gap-2 flex-wrap mt-4">

                            <a asp-controller="CourseOfferings"
                               asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                إلغاء والعودة
                            </a>

                            <button type="submit"
                                    class="btn px-4"
                                    style="background:#c9a24d;
                                color:#142d4e;
                                font-weight:800;">
                                حفظ المقرر المطروح
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
