@model IEnumerable<StudentAffairsManagementSystem.Models.Course>

@using StudentAffairsManagementSystem.Models

@{
    ViewData["Title"] = "المقررات الدراسية";

    var courses = Model?.ToList() ?? new List<Course>();

    var totalCourses = courses.Count;

    var totalHours = courses.Sum(c => c.CreditHours);

    var totalDepartments = courses
        .Select(c => c.DepartmentId)
        .Distinct()
        .Count();

    var isAdmin = User.IsInRole("Admin");

    var activeSemester = ViewBag.ActiveSemester as Semester;

    var hourPrices = ViewBag.HourPrices
        as Dictionary<long, decimal>
        ?? new Dictionary<long, decimal>();

    var departments = ViewBag.Departments as List<Department>
        ?? new List<Department>();
}

<style>
    .courses-page {
        color: #142d4e;
    }

    .courses-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        flex-wrap: wrap;
        margin-bottom: 25px;
    }

        .courses-header h2 {
            font-size: 25px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .courses-header p {
            color: #718096;
            margin: 0;
        }

    /* زر إضافة مقرر */

    .courses-add-btn {
        background: #c9a24d;
        color: #142d4e;
        border-radius: 11px;
        padding: 12px 20px;
        text-decoration: none;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        transition: background-color 0.2s ease;
    }

        .courses-add-btn:hover {
            background: #b9913d;
            color: #142d4e;
        }

    /* بطاقات الإحصائيات */

    .courses-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 25px;
    }

    .courses-stat-card {
        background: white;
        border: 1px solid #e5eaf2;
        border-top: 4px solid #c9a24d;
        border-radius: 14px;
        padding: 22px;
    }

    .courses-stat-label {
        color: #718096;
        font-size: 14px;
        margin-bottom: 10px;
    }

    .courses-stat-value {
        color: #142d4e;
        font-size: 28px;
        font-weight: 800;
    }

    /* قائمة المقررات */

    .courses-table-card {
        background: white;
        border: 1px solid #e5eaf2;
        border-radius: 15px;
        overflow: hidden;
    }

    .courses-table-header {
        padding: 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        flex-wrap: wrap;
        border-bottom: 1px solid #e5eaf2;
    }

        .courses-table-header h3 {
            margin: 0;
            font-size: 19px;
            font-weight: 800;
        }

    /* البحث والفلترة */

    .courses-filters {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .courses-search {
        width: 280px;
        max-width: 100%;
        padding: 11px 14px;
        border: 1px solid #d9e1eb;
        border-radius: 9px;
        outline: none;
    }

    .courses-filters select {
        width: 240px;
        max-width: 100%;
        padding: 11px 14px;
        border: 1px solid #d9e1eb;
        border-radius: 9px;
        background: white;
        color: #142d4e;
        outline: none;
        cursor: pointer;
    }

        .courses-search:focus,
        .courses-filters select:focus {
            border-color: #c9a24d;
            box-shadow: 0 0 0 3px rgba(201, 162, 77, 0.12);
        }

    /* الجدول */

    .courses-table {
        width: 100%;
        border-collapse: collapse;
    }

        .courses-table th {
            background: #142d4e;
            color: #ffffff;
            padding: 17px;
            text-align: right;
            font-size: 14px;
            font-weight: 800;
            white-space: nowrap;
        }

        .courses-table td {
            padding: 15px 17px;
            border-top: 1px solid #e5eaf2;
            vertical-align: middle;
            color: #142d4e;
            font-size: 14px;
        }

        .courses-table tbody tr {
            background: #ffffff;
            transition: background-color 0.2s ease;
        }

            .courses-table tbody tr:hover {
                background: #f8f9fc;
            }

    /* رمز المقرر */

    .courses-code {
        display: inline-block;
        background: #eef2f8;
        color: #304661;
        border-radius: 7px;
        padding: 6px 10px;
        font-weight: 700;
        direction: ltr;
    }

    /* الساعات المعتمدة */

    .courses-hours {
        display: inline-block;
        background: #f8f2e7;
        color: #8b6b37;
        border-radius: 7px;
        padding: 6px 12px;
        white-space: nowrap;
    }

    /* سعر الساعة */

    .courses-price {
        display: inline-block;
        background: #eaf5ee;
        color: #217348;
        border-radius: 7px;
        padding: 7px 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .courses-price-missing {
        display: inline-block;
        background: #f0f1f4;
        color: #718096;
        border-radius: 7px;
        padding: 7px 12px;
        font-size: 13px;
        white-space: nowrap;
    }

    /* ملاحظة الفصل الدراسي */

    .courses-semester-note {
        background: #fff9ed;
        color: #826329;
        border: 1px solid #efdfbb;
        border-radius: 10px;
        padding: 13px 17px;
        margin-bottom: 20px;
        line-height: 1.8;
    }

    /* أزرار الإجراءات الموحدة */

    .courses-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .courses-action-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 43px;
        padding: 9px 15px;
        border-radius: 11px;
        border: 1px solid transparent;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        white-space: nowrap;
        transition: background-color 0.2s ease, transform 0.2s ease;
    }

        .courses-action-link i {
            font-size: 16px;
        }

    /* عرض التفاصيل */

    .courses-action-details {
        background: #eef2f8;
        color: #142d4e;
    }

        .courses-action-details:hover {
            background: #dfe7f2;
            color: #142d4e;
            transform: translateY(-1px);
        }

    /* تعديل */

    .courses-action-edit {
        background: #c9a24d;
        color: #142d4e;
    }

        .courses-action-edit:hover {
            background: #b9913d;
            color: #142d4e;
            transform: translateY(-1px);
        }

    /* حذف */

    .courses-action-delete {
        background: #fff0ee;
        color: #c62828;
        border-color: #ffc5bf;
    }

        .courses-action-delete:hover {
            background: #ffe0dc;
            color: #a91e1e;
            border-color: #f2a8a0;
            transform: translateY(-1px);
        }

    .courses-action-link:focus-visible {
        outline: 3px solid #142d4e;
        outline-offset: 3px;
    }

    /* لا توجد نتائج */

    .courses-empty {
        padding: 45px 20px;
        text-align: center;
        color: #718096;
    }

        .courses-empty i {
            display: block;
            font-size: 40px;
            color: #c9a24d;
            margin-bottom: 12px;
        }

    /* الشاشات الصغيرة */

    @@media (max-width: 800px) {
        .courses-stats {
            grid-template-columns: 1fr;
        }

        .courses-table {
            min-width: 1050px;
        }
    }

    @@media (max-width: 600px) {
        .courses-filters {
            width: 100%;
        }

            .courses-filters select,
            .courses-filters input {
                width: 100%;
            }
    }
</style>

<div class="courses-page" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="courses-header">

        <div>
            <h2>إدارة المقررات الدراسية</h2>

            <p>
                عرض المقررات الأكاديمية المسجلة في النظام.
            </p>
        </div>

        @if (isAdmin)
        {
            <a asp-controller="Courses"
               asp-action="Create"
               class="courses-add-btn">

                <i class="bi bi-plus-circle"></i>
                إضافة مقرر جديد

            </a>
        }

    </div>

    <!-- بطاقات الإحصائيات -->
    <div class="courses-stats">

        <div class="courses-stat-card">
            <div class="courses-stat-label">
                إجمالي المقررات
            </div>

            <div class="courses-stat-value">
                @totalCourses
            </div>
        </div>

        <div class="courses-stat-card">
            <div class="courses-stat-label">
                مجموع الساعات المعتمدة
            </div>

            <div class="courses-stat-value">
                @totalHours
            </div>
        </div>

        <div class="courses-stat-card">
            <div class="courses-stat-label">
                الأقسام المرتبطة بالمقررات
            </div>

            <div class="courses-stat-value">
                @totalDepartments
            </div>
        </div>

    </div>

    <!-- معلومات الفصل الدراسي -->
    <div class="courses-semester-note">

        @if (activeSemester != null)
        {
            <i class="bi bi-calendar3"></i>

            <strong>أسعار الساعات المعروضة تخص الفصل:</strong>

            @activeSemester.Name

            <span> - </span>

            @activeSemester.AcademicYear
        }
        else
        {
            <i class="bi bi-exclamation-circle"></i>

            <strong>لا يوجد فصل دراسي فعّال حاليًا.</strong>

            <span>
                سيتم عرض سعر الساعة على أنه غير محدد
                حتى يتم تفعيل فصل دراسي وتسجيل أسعار الساعات له.
            </span>
        }

    </div>

    <!-- قائمة المقررات -->
    <div class="courses-table-card">

        <div class="courses-table-header">

            <h3>قائمة المقررات</h3>

            <div class="courses-filters">

                <!-- فلترة الأقسام -->
                <select id="departmentFilter"
                        aria-label="تصفية حسب القسم الأكاديمي">

                    <option value="">
                        جميع الأقسام
                    </option>

                    @foreach (var department in departments)
                    {
                        <option value="@department.Id">
                            @department.Name
                        </option>
                    }

                </select>

                <!-- البحث -->
                <input type="search"
                       id="courseSearch"
                       class="courses-search"
                       placeholder="ابحث عن مقرر أو رمز أو قسم..."
                       aria-label="البحث في المقررات" />

            </div>

        </div>

        <div style="overflow-x:auto;">

            <table class="courses-table" id="coursesTable">

                <thead>
                    <tr>
                        <th>رمز المقرر</th>
                        <th>اسم المقرر</th>
                        <th>القسم الأكاديمي</th>
                        <th>الساعات المعتمدة</th>
                        <th>سعر الساعة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var course in courses)
                    {
                        bool hasPrice = hourPrices.TryGetValue(
                            course.DepartmentId,
                            out decimal pricePerHour);

                        <tr class="course-data-row"
                            data-department-id="@course.DepartmentId">

                            <!-- رمز المقرر -->
                            <td>
                                <span class="courses-code">
                                    @course.Code
                                </span>
                            </td>

                            <!-- اسم المقرر -->
                            <td>
                                <strong>@course.Name</strong>
                            </td>

                            <!-- القسم الأكاديمي -->
                            <td>
                                @(course.Department?.Name ?? "غير محدد")
                            </td>

                            <!-- الساعات المعتمدة -->
                            <td>
                                <span class="courses-hours">
                                    @course.CreditHours ساعات
                                </span>
                            </td>

                            <!-- سعر الساعة -->
                            <td>

                                @if (hasPrice)
                                {
                                    <span class="courses-price" dir="ltr">
                                        @pricePerHour.ToString("N2")
                                    </span>
                                }
                                else
                                {
                                    <span class="courses-price-missing">
                                        غير محدد
                                    </span>
                                }

                            </td>

                            <!-- الإجراءات -->
                            <td>

                                <div class="courses-actions">

                                    <!-- عرض التفاصيل -->
                                    <a asp-controller="Courses"
                                       asp-action="Details"
                                       asp-route-id="@course.Id"
                                       class="courses-action-link courses-action-details">

                                        <i class="bi bi-eye"></i>
                                        عرض التفاصيل

                                    </a>

                                    @if (isAdmin)
                                    {
                                        <!-- تعديل -->
                                        <a asp-controller="Courses"
                                           asp-action="Edit"
                                           asp-route-id="@course.Id"
                                           class="courses-action-link courses-action-edit">

                                            <i class="bi bi-pencil-square"></i>
                                            تعديل

                                        </a>

                                        <!-- حذف -->
                                        <a asp-controller="Courses"
                                           asp-action="Delete"
                                           asp-route-id="@course.Id"
                                           class="courses-action-link courses-action-delete">

                                            <i class="bi bi-trash3"></i>
                                            حذف

                                        </a>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            @if (!courses.Any())
            {
                <div class="courses-empty">

                    <i class="bi bi-journal-x"></i>

                    لا توجد مقررات دراسية مسجلة حاليًا.

                </div>
            }

            <div id="noSearchResults"
                 class="courses-empty"
                 style="display:none;">

                لا توجد مقررات مطابقة للبحث أو القسم المحدد.

            </div>

        </div>

    </div>

</div>

<!-- البحث والفلترة -->
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const searchInput =
            document.getElementById("courseSearch");

        const departmentFilter =
            document.getElementById("departmentFilter");

        const rows =
            document.querySelectorAll(".course-data-row");

        const noResults =
            document.getElementById("noSearchResults");

        if (!searchInput || !departmentFilter) {
            return;
        }

        function filterCourses() {

            const searchTerm =
                searchInput.value.trim().toLowerCase();

            const selectedDepartment =
                departmentFilter.value;

            let visibleCount = 0;

            rows.forEach(function (row) {

                const rowText =
                    row.textContent.toLowerCase();

                const departmentId =
                    row.getAttribute("data-department-id");

                const matchesSearch =
                    rowText.includes(searchTerm);

                const matchesDepartment =
                    selectedDepartment === "" ||
                    departmentId === selectedDepartment;

                const showRow =
                    matchesSearch && matchesDepartment;

                row.style.display = showRow ? "" : "none";

                if (showRow) {
                    visibleCount++;
                }
            });

            if (noResults) {
                noResults.style.display =
                    rows.length > 0 && visibleCount === 0
                        ? "block"
                        : "none";
            }
        }

        searchInput.addEventListener(
            "input",
            filterCourses
        );

        departmentFilter.addEventListener(
            "change",
            filterCourses
        );

    });
</script>
