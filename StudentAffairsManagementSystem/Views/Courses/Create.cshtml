@model StudentAffairsManagementSystem.Models.Course

@{
    ViewData["Title"] = "إضافة مقرر دراسي";
}

<style>
    .course-create-page {
        direction: rtl;
        max-width: 900px;
        margin: 20px auto;
        color: #142d4e;
    }

    /* رأس الصفحة */

    .course-create-header {
        background: linear-gradient(135deg, #142d4e, #304661);
        color: #ffffff;
        padding: 28px 32px;
        border-radius: 16px 16px 0 0;
        border-bottom: 4px solid #c9a24d;
    }

        .course-create-header h2 {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 25px;
            font-weight: 800;
            margin: 0 0 10px;
        }

            .course-create-header h2 i {
                color: #c9a24d;
                font-size: 27px;
            }

        .course-create-header p {
            color: #d6dfeb;
            font-size: 14px;
            line-height: 1.9;
            margin: 0;
        }

    /* بطاقة النموذج */

    .course-create-body {
        background: #ffffff;
        padding: 30px;
        border: 1px solid #e5eaf2;
        border-top: none;
        border-radius: 0 0 16px 16px;
        box-shadow: 0 5px 25px rgba(20,45,78,.05);
    }

    /* عنوان القسم */

    .course-create-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #142d4e;
        font-size: 18px;
        font-weight: 800;
        border-right: 4px solid #c9a24d;
        padding-right: 13px;
        margin-bottom: 25px;
    }

        .course-create-section-title i {
            color: #b9913d;
            font-size: 20px;
        }

    /* حقول النموذج */

    .course-create-field {
        margin-bottom: 25px;
    }

    .course-create-label {
        display: block;
        color: #142d4e;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 9px;
    }

    .course-create-required {
        color: #b42318;
    }

    .course-create-input {
        width: 100%;
        min-height: 46px;
        padding: 11px 14px;
        border: 1px solid #dce3ed;
        border-radius: 11px;
        background: #ffffff;
        color: #142d4e;
        font-size: 14px;
        font-family: inherit;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .course-create-input:focus {
            outline: none;
            border-color: #c9a24d;
            box-shadow: 0 0 0 3px rgba(201,162,77,.14);
        }

        .course-create-input::placeholder {
            color: #98a4b5;
        }

        .course-create-input.input-validation-error {
            border-color: #dc756e;
        }

    /* النصوص الإرشادية */

    .course-create-hint {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        color: #718096;
        font-size: 13px;
        line-height: 1.9;
        margin-top: 9px;
    }

        .course-create-hint i {
            color: #b9913d;
            margin-top: 2px;
            flex-shrink: 0;
        }

    /* رسائل التحقق */

    .course-create-error {
        display: block;
        color: #b42318;
        font-size: 13px;
        line-height: 1.7;
        margin-top: 7px;
    }

    .course-create-validation-summary {
        background: #fff0ee;
        border: 1px solid #f1d8d5;
        border-radius: 11px;
        padding: 15px 18px;
        margin-bottom: 22px;
        color: #b42318;
        font-size: 14px;
    }

        .course-create-validation-summary.validation-summary-valid {
            display: none;
        }

        .course-create-validation-summary ul {
            margin: 0;
            padding-right: 20px;
        }

    /* ملاحظة */

    .course-create-note {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        background: #f7f9fc;
        border: 1px solid #e9edf3;
        border-right: 4px solid #c9a24d;
        border-radius: 11px;
        padding: 17px 19px;
        margin-bottom: 28px;
        color: #42536c;
        font-size: 14px;
        line-height: 1.9;
    }

        .course-create-note i {
            color: #b9913d;
            font-size: 20px;
            flex-shrink: 0;
        }

    /* الأزرار */

    .course-create-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 25px;
        border-top: 1px solid #e9edf3;
    }

    .course-create-save,
    .course-create-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 45px;
        padding: 11px 22px;
        border-radius: 11px;
        font-size: 14px;
        font-weight: 800;
        font-family: inherit;
        text-decoration: none;
        transition: background-color .2s ease;
    }

    /* زر الحفظ */

    .course-create-save {
        background: #c9a24d;
        color: #142d4e;
        border: 1px solid transparent;
        cursor: pointer;
    }

        .course-create-save:hover {
            background: #b9913d;
            color: #142d4e;
        }

    /* زر الإلغاء */

    .course-create-cancel {
        background: #edf1f7;
        color: #142d4e;
        border: 1px solid #dfe6ef;
    }

        .course-create-cancel:hover {
            background: #e1e8f2;
            color: #142d4e;
        }

        .course-create-save:focus-visible,
        .course-create-cancel:focus-visible {
            outline: 3px solid #142d4e;
            outline-offset: 3px;
        }

    /* الشاشات الصغيرة */

    @@media (max-width: 650px) {
        .course-create-page {
            margin: 15px auto;
        }

        .course-create-header,
        .course-create-body {
            padding: 22px;
        }

            .course-create-header h2 {
                font-size: 21px;
            }

        .course-create-actions {
            flex-direction: column;
        }

        .course-create-save,
        .course-create-cancel {
            width: 100%;
        }
    }
</style>

<div class="course-create-page">

    <!-- رأس الصفحة -->

    <div class="course-create-header">

        <h2>
            <i class="bi bi-journal-plus"></i>
            إضافة مقرر دراسي جديد
        </h2>

        <p>
            أدخل بيانات المقرر الدراسي
            واربطه بالقسم الأكاديمي المناسب.
        </p>

    </div>

    <!-- نموذج الإضافة -->

    <div class="course-create-body">

        <form asp-controller="Courses"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <!-- رسائل التحقق العامة -->

            <div asp-validation-summary="ModelOnly"
                 class="course-create-validation-summary"></div>

            <!-- عنوان البيانات -->

            <h3 class="course-create-section-title">
                <i class="bi bi-journal-bookmark"></i>
                بيانات المقرر الدراسي
            </h3>

            <!-- اسم المقرر -->

            <div class="course-create-field">

                <label asp-for="Name"
                       class="course-create-label">

                    اسم المقرر الدراسي
                    <span class="course-create-required">*</span>

                </label>

                <input asp-for="Name"
                       class="course-create-input"
                       placeholder="أدخل اسم المقرر الدراسي"
                       required />

                <span asp-validation-for="Name"
                      class="course-create-error"></span>

            </div>

            <!-- رمز المقرر -->

            <div class="course-create-field">

                <label asp-for="Code"
                       class="course-create-label">

                    رمز المقرر
                    <span class="course-create-required">*</span>

                </label>

                <input asp-for="Code"
                       class="course-create-input"
                       placeholder="أدخل رمز المقرر"
                       required />

                <span asp-validation-for="Code"
                      class="course-create-error"></span>

            </div>

            <!-- عدد الساعات -->

            <div class="course-create-field">

                <label asp-for="CreditHours"
                       class="course-create-label">

                    عدد الساعات المعتمدة
                    <span class="course-create-required">*</span>

                </label>

                <input asp-for="CreditHours"
                       type="number"
                       min="1"
                       step="1"
                       class="course-create-input"
                       required />

                <span asp-validation-for="CreditHours"
                      class="course-create-error"></span>

                <div class="course-create-hint">

                    <i class="bi bi-info-circle"></i>

                    <span>
                        أدخل عدد الساعات المعتمدة للمقرر
                        كعدد صحيح أكبر من الصفر.
                    </span>

                </div>

            </div>

            <!-- القسم الأكاديمي -->

            <div class="course-create-field">

                <label asp-for="DepartmentId"
                       class="course-create-label">

                    القسم الأكاديمي
                    <span class="course-create-required">*</span>

                </label>

                <select asp-for="DepartmentId"
                        asp-items="ViewBag.DepartmentId"
                        class="course-create-input"
                        required>

                    <option value="">
                        -- اختر القسم الأكاديمي --
                    </option>

                </select>

                <span asp-validation-for="DepartmentId"
                      class="course-create-error"></span>

                <div class="course-create-hint">

                    <i class="bi bi-info-circle"></i>

                    <span>
                        تظهر الأقسام الأكاديمية المتاحة
                        من قاعدة البيانات.
                    </span>

                </div>

            </div>

            <!-- ملاحظة -->

            <div class="course-create-note">

                <i class="bi bi-info-circle"></i>

                <span>
                    سيتم ربط المقرر الدراسي بالقسم
                    الأكاديمي الذي تختاره عند حفظ البيانات.
                </span>

            </div>

            <!-- أزرار الحفظ والإلغاء -->

            <div class="course-create-actions">

                <button type="submit"
                        class="course-create-save">

                    <i class="bi bi-check-circle"></i>
                    حفظ المقرر

                </button>

                <a asp-controller="Courses"
                   asp-action="Index"
                   class="course-create-cancel">

                    <i class="bi bi-x-circle"></i>
                    إلغاء والعودة

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
