@using Microsoft.AspNetCore.Identity
@using StudentAffairsManagementSystem.Models
@inject UserManager<Account> UserManager

@{
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Admin");
    var isEmployee = User.IsInRole("Employee");
    var isStudent = User.IsInRole("Student");

    var account = isLoggedIn
        ? await UserManager.GetUserAsync(User)
        : null;

    var displayName = account?.UserName ?? "مستخدم";
    var pageTitle = ViewData["Title"]?.ToString() ?? "الرئيسية";

    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string MenuClass(string controller, string? action = null)
    {
        bool controllerMatches = currentController.Equals(
            controller,
            StringComparison.OrdinalIgnoreCase);

        bool actionMatches = action == null ||
            currentAction.Equals(
                action,
                StringComparison.OrdinalIgnoreCase);

        return controllerMatches && actionMatches
            ? "menu-link active"
            : "menu-link";
    }
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle - الجامعة الدولية للعلوم والنهضة</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" />

    <link rel="stylesheet"
          href="~/StudentAffairsManagementSystem.styles.css" />

    <style>
            :root {
                --navy: #142d4e;
                --navy-hover: #263f60;
                --gold: #c9a24d;
                --gold-hover: #b9913d;
                --background: #f5f7fb;
                --border: #e5eaf2;
                --muted: #718096;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: var(--background);
                color: var(--navy);
                font-family: Tahoma, Arial, sans-serif;
            }

            /* الهيكل العام */

            .app-layout {
                display: flex;
                min-height: 100vh;
            }

            /* القائمة الجانبية */

            .app-sidebar {
                width: 270px;
                flex-shrink: 0;
                min-height: 100vh;
                background: var(--navy);
                color: #ffffff;
                padding: 22px 14px;
            }

            /* شعار الجامعة */

            .brand-area {
                text-align: center;
                padding: 12px 8px 25px;
                border-bottom: 1px solid rgba(255,255,255,.15);
                margin-bottom: 20px;
            }

            .brand-logo {
                width: 95px;
                height: 95px;
                object-fit: contain;
                background: #ffffff;
                border-radius: 50%;
                padding: 5px;
                margin-bottom: 14px;
                border: 3px solid rgba(201,162,77,.35);
            }

            .brand-name {
                color: #ffffff;
                font-size: 17px;
                font-weight: 800;
                line-height: 1.8;
                margin-bottom: 8px;
            }

            .brand-subtitle {
                color: var(--gold);
                font-size: 13px;
                font-weight: 700;
            }

            /* عناوين مجموعات القائمة */

            .menu-heading {
                color: #aab8cb;
                font-size: 12px;
                font-weight: 700;
                margin: 22px 14px 10px;
            }

            /* روابط القائمة */

            .menu-link {
                display: flex;
                align-items: center;
                gap: 13px;
                min-height: 43px;
                padding: 11px 15px;
                margin-bottom: 5px;
                border-radius: 11px;
                border-right: 3px solid transparent;
                color: #e4ebf6;
                text-decoration: none;
                font-size: 14px;
                transition: background-color .2s ease, color .2s ease, border-color .2s ease;
            }

                .menu-link:hover {
                    background: var(--navy-hover);
                    color: #ffffff;
                }

                .menu-link.active {
                    background: #304661;
                    color: #ffffff;
                    border-right-color: var(--gold);
                    font-weight: 800;
                }

                .menu-link i {
                    width: 24px;
                    font-size: 19px;
                    text-align: center;
                    color: var(--gold);
                    flex-shrink: 0;
                }

                .menu-link span {
                    flex: 1;
                    min-width: 0;
                }

                .menu-link:focus-visible {
                    outline: 2px solid var(--gold);
                    outline-offset: 2px;
                }

            /* المحتوى الرئيسي */

            .app-main {
                flex: 1;
                min-width: 0;
                display: flex;
                flex-direction: column;
            }

            /* الشريط العلوي */

            .app-topbar {
                min-height: 85px;
                background: #ffffff;
                border-bottom: 1px solid var(--border);
                padding: 18px 30px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
            }

            .page-title {
                font-size: 20px;
                font-weight: 800;
                color: var(--navy);
                margin: 0;
            }

            /* بيانات المستخدم */

            .topbar-user {
                display: flex;
                align-items: center;
                gap: 13px;
            }

            .user-avatar {
                width: 43px;
                height: 43px;
                border-radius: 50%;
                background: var(--gold);
                color: var(--navy);
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 800;
                font-size: 18px;
                flex-shrink: 0;
            }

            .user-details {
                display: flex;
                flex-direction: column;
                gap: 3px;
            }

                .user-details strong {
                    color: var(--navy);
                    font-size: 14px;
                    font-weight: 800;
                    overflow-wrap: anywhere;
                }

                .user-details small {
                    color: var(--muted);
                    font-size: 12px;
                }

            /* زر تسجيل الخروج */

            .logout-button {
                min-height: 43px;
                border: 1px solid #f1d8d5;
                border-radius: 11px;
                padding: 9px 15px;
                background: #fff0ee;
                color: #b33b30;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                font-size: 13px;
                font-weight: 700;
                cursor: pointer;
                transition: background-color .2s ease;
            }

                .logout-button:hover {
                    background: #fbe0dc;
                    color: #9d3027;
                }

                .logout-button:focus-visible {
                    outline: 3px solid var(--navy);
                    outline-offset: 2px;
                }

            /* مساحة الصفحات */

            .app-content {
                flex: 1;
                padding: 30px;
                min-width: 0;
            }

            /* التذييل */

            .app-footer {
                text-align: center;
                padding: 20px;
                color: #8590a0;
                font-size: 12px;
            }

            /* تنسيقات مشتركة للبطاقات */

            .university-card {
                background: #ffffff;
                border: 1px solid var(--border);
                border-radius: 15px;
                padding: 24px;
                box-shadow: 0 3px 12px rgba(20,45,78,.04);
            }

            /* الزر الذهبي العام */

            .btn-university {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                min-height: 43px;
                background: var(--gold);
                color: var(--navy);
                border: 1px solid transparent;
                border-radius: 11px;
                padding: 9px 18px;
                font-weight: 700;
                text-decoration: none;
                transition: background-color .2s ease;
            }

                .btn-university:hover {
                    background: var(--gold-hover);
                    color: var(--navy);
                }

                .btn-university:focus-visible {
                    outline: 3px solid var(--navy);
                    outline-offset: 2px;
                }

            /* الشاشات المتوسطة والصغيرة */

            @@media (max-width: 850px) {
                .app-layout {
                    flex-direction: column;
                }

                .app-sidebar {
                    width: 100%;
                    min-height: auto;
                    padding: 16px;
                }

                .brand-area {
                    padding: 10px 8px 18px;
                    margin-bottom: 15px;
                }

                .brand-logo {
                    width: 75px;
                    height: 75px;
                }

                .brand-name {
                    font-size: 15px;
                }

                .app-sidebar nav {
                    display: grid;
                    grid-template-columns: repeat( 2, minmax(0, 1fr) );
                    gap: 6px 10px;
                }

                .menu-heading {
                    grid-column: 1 / -1;
                    margin: 14px 5px 5px;
                }

                .menu-link {
                    margin-bottom: 0;
                    font-size: 13px;
                    padding: 10px;
                }

                .app-topbar {
                    flex-wrap: wrap;
                    padding: 18px;
                }

                .app-content {
                    padding: 18px;
                }

                .topbar-user {
                    flex-wrap: wrap;
                }
            }

            @@media (max-width: 500px) {
                .app-sidebar nav {
                    grid-template-columns: 1fr;
                }

                .app-topbar {
                    align-items: flex-start;
                    flex-direction: column;
                    gap: 15px;
                }

                .topbar-user {
                    width: 100%;
                }

                    .topbar-user form {
                        margin-right: auto;
                    }

                .app-content {
                    padding: 15px;
                }

                .page-title {
                    font-size: 18px;
                }
            }
    </style>
</head>

<body>

    @if (isLoggedIn)
    {
        <div class="app-layout">

            <!-- القائمة الجانبية -->

            <aside class="app-sidebar">

                <!-- شعار الجامعة -->

                <div class="brand-area">

                    <img src="~/images/iusr-logo.jfif"
                         class="brand-logo"
                         alt="شعار الجامعة الدولية للعلوم والنهضة" />

                    <div class="brand-name">
                        الجامعة الدولية للعلوم والنهضة
                    </div>

                    <div class="brand-subtitle">
                        نظام إدارة شؤون الطلاب
                    </div>

                </div>

                <nav aria-label="القائمة الرئيسية">

                    <!-- قائمة مدير النظام -->
                    @if (isAdmin)
                    {
                        <div class="menu-heading">
                            القائمة الرئيسية
                        </div>

                        <a asp-controller="AdminDashboard"
                           asp-action="Index"
                           class="@MenuClass("AdminDashboard", "Index")">

                            <i class="bi bi-grid-1x2-fill"></i>
                            <span>لوحة التحكم</span>

                        </a>
                    }

                    <!-- قائمة الموظف -->
                    @if (isEmployee && !isAdmin)
                    {
                        <div class="menu-heading">
                            القائمة الرئيسية
                        </div>

                        <a asp-controller="Registrations"
                           asp-action="Manage"
                           class="@MenuClass("Registrations", "Manage")">

                            <i class="bi bi-card-checklist"></i>
                            <span>إدارة التسجيلات</span>

                        </a>
                    }

                    <!-- الشؤون الأكاديمية للمدير والموظف -->
                    @if (isAdmin || isEmployee)
                    {
                        <div class="menu-heading">
                            الشؤون الأكاديمية
                        </div>

                        <!-- إدارة الطلاب -->

                        <a asp-controller="Students"
                           asp-action="Index"
                           class="@MenuClass("Students")">

                            <i class="bi bi-mortarboard"></i>
                            <span>إدارة الطلاب</span>

                        </a>

                        <!-- المقررات الدراسية -->

                        <a asp-controller="Courses"
                           asp-action="Index"
                           class="@MenuClass("Courses")">

                            <i class="bi bi-book"></i>
                            <span>المقررات الدراسية</span>

                        </a>

                        <!-- تسجيل المقررات -->

                        <a asp-controller="Registrations"
                           asp-action="Index"
                           class="@MenuClass("Registrations", "Index")">

                            <i class="bi bi-clipboard-check"></i>
                            <span>تسجيل المقررات الدراسية</span>

                        </a>

                        <!-- الشعب المطروحة -->

                        <a asp-controller="CourseOfferings"
                           asp-action="Index"
                           class="@MenuClass("CourseOfferings")">

                            <i class="bi bi-collection"></i>
                            <span>الشعب المطروحة</span>

                        </a>
                    }

                    <!-- إدارة الجامعة للمدير فقط -->
                    @if (isAdmin)
                    {
                        <div class="menu-heading">
                            إدارة الجامعة
                        </div>

                        <!-- الموظفون -->

                        <a asp-controller="Employees"
                           asp-action="Index"
                           class="@MenuClass("Employees")">

                            <i class="bi bi-people"></i>
                            <span>إدارة الموظفين</span>

                        </a>

                        <!-- الصلاحيات -->

                        <a asp-controller="EmployeePermissions"
                           asp-action="Index"
                           class="@MenuClass("EmployeePermissions")">

                            <i class="bi bi-shield-lock"></i>
                            <span>صلاحيات الموظفين</span>

                        </a>

                        <!-- الكليات -->

                        <a asp-controller="Faculties"
                           asp-action="Index"
                           class="@MenuClass("Faculties")">

                            <i class="bi bi-bank"></i>
                            <span>الكليات</span>

                        </a>

                        <!-- الأقسام -->

                        <a asp-controller="Departments"
                           asp-action="Index"
                           class="@MenuClass("Departments")">

                            <i class="bi bi-diagram-3"></i>
                            <span>الأقسام</span>

                        </a>

                        <!-- الفصول الدراسية -->

                        <a asp-controller="Semesters"
                           asp-action="Index"
                           class="@MenuClass("Semesters")">

                            <i class="bi bi-calendar3"></i>
                            <span>الفصول الدراسية</span>

                        </a>

                        <!-- أسعار الساعات -->

                        <a asp-controller="HourPrices"
                           asp-action="Index"
                           class="@MenuClass("HourPrices")">

                            <i class="bi bi-cash-stack"></i>
                            <span>أسعار الساعات</span>

                        </a>
                    }

                    <!-- خدمات الطالب -->
                    @if (isStudent)
                    {
                        <div class="menu-heading">
                            خدمات الطالب
                        </div>

                        <!-- بوابة الطالب -->

                        <a asp-controller="StudentDashboard"
                           asp-action="Index"
                           class="@MenuClass("StudentDashboard", "Index")">

                            <i class="bi bi-person-circle"></i>
                            <span>بوابة الطالب</span>

                        </a>

                        <!-- تسجيل المقررات -->

                        <a asp-controller="StudentDashboard"
                           asp-action="Courses"
                           class="@MenuClass("StudentDashboard", "Courses")">

                            <i class="bi bi-journal-plus"></i>
                            <span>تسجيل المقررات</span>

                        </a>

                        <!-- الرسوم الجامعية -->

                        <a asp-controller="StudentDashboard"
                           asp-action="Fees"
                           class="@MenuClass("StudentDashboard", "Fees")">

                            <i class="bi bi-wallet2"></i>
                            <span>الرسوم الجامعية</span>

                        </a>
                    }

                </nav>

            </aside>

            <!-- المحتوى الرئيسي -->

            <div class="app-main">

                <!-- الشريط العلوي -->

                <header class="app-topbar">

                    <h1 class="page-title">
                        @pageTitle
                    </h1>

                    <div class="topbar-user">

                        <!-- صورة رمزية للمستخدم -->

                        <div class="user-avatar">
                            @(displayName.Length > 0
                                ? displayName.Substring(0, 1).ToUpper()
                                : "م")
                        </div>

                        <!-- اسم المستخدم ودوره -->

                        <div class="user-details">

                            <strong>@displayName</strong>

                            <small>
                                @(isAdmin ? "مدير النظام" :
                                  isEmployee ? "موظف" :
                                  isStudent ? "طالب" : "مستخدم")
                            </small>

                        </div>

                        <!-- تسجيل الخروج -->

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="logout-button">

                                <i class="bi bi-box-arrow-left"></i>
                                <span>تسجيل الخروج</span>

                            </button>

                        </form>

                    </div>

                </header>

                <!-- محتوى الصفحة -->

                <main class="app-content">
                    @RenderBody()
                </main>

                <!-- تذييل الصفحة -->

                <footer class="app-footer">
                    © @DateTime.Now.Year
                    الجامعة الدولية للعلوم والنهضة
                </footer>

            </div>

        </div>
    }
    else
    {
        <main>
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
