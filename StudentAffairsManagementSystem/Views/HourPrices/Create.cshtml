@model StudentAffairsManagementSystem.Models.HourPrice

@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Text.Json

@{
    ViewData["Title"] = "إضافة سعر ساعة دراسية";

    var faculties = ViewBag.Faculties as IEnumerable<SelectListItem>
        ?? Enumerable.Empty<SelectListItem>();

    var departments = ViewBag.DepartmentsWithFaculties
        as IEnumerable<StudentAffairsManagementSystem.Models.Department>
        ?? Enumerable.Empty<StudentAffairsManagementSystem.Models.Department>();

    var departmentData = departments.Select(d => new
    {
        id = d.Id,
        name = d.Name,
        facultyId = d.FacultyId
    }).ToList();

    var departmentJson = JsonSerializer.Serialize(departmentData);

    var selectedDepartmentJson = JsonSerializer.Serialize(
        Model?.DepartmentId.ToString() ?? ""
    );
}

<style>
    .hourprice-create-page {
        direction: rtl;
        max-width: 950px;
        margin: 20px auto;
        color: #142d4e;
    }

    /* رأس الصفحة */

    .hourprice-create-header {
        background: linear-gradient(135deg, #142d4e, #304661);
        color: #ffffff;
        padding: 28px 32px;
        border-radius: 16px 16px 0 0;
        border-bottom: 4px solid #c9a24d;
    }

        .hourprice-create-header h2 {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 25px;
            font-weight: 800;
            margin: 0 0 10px;
        }

            .hourprice-create-header h2 i {
                color: #c9a24d;
                font-size: 27px;
            }

        .hourprice-create-header p {
            color: #d6dfeb;
            font-size: 14px;
            line-height: 1.9;
            margin: 0;
        }

    /* جسم الصفحة */

    .hourprice-create-body {
        background: #ffffff;
        padding: 30px;
        border: 1px solid #e5eaf2;
        border-top: none;
        border-radius: 0 0 16px 16px;
        box-shadow: 0 5px 25px rgba(20,45,78,.05);
    }

    /* الأقسام */

    .hourprice-create-section {
        margin-bottom: 32px;
    }

    .hourprice-create-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #142d4e;
        font-size: 18px;
        font-weight: 800;
        border-right: 4px solid #c9a24d;
        padding-right: 13px;
        margin: 0 0 23px;
    }

        .hourprice-create-section-title i {
            color: #b9913d;
            font-size: 20px;
        }

    /* شبكة الحقول */

    .hourprice-create-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
    }

    .hourprice-create-field {
        min-width: 0;
    }

    .hourprice-create-field-full {
        grid-column: 1 / -1;
    }

    .hourprice-create-label {
        display: block;
        color: #142d4e;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 9px;
    }

    .hourprice-create-required {
        color: #b42318;
    }

    .hourprice-create-input {
        display: block;
        width: 100%;
        min-height: 46px;
        padding: 11px 14px;
        border: 1px solid #dce3ed;
        border-radius: 11px;
        background: #ffffff;
        color: #142d4e;
        font-size: 14px;
        font-family: inherit;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .hourprice-create-input:focus {
            outline: none;
            border-color: #c9a24d;
            box-shadow: 0 0 0 3px rgba(201,162,77,.14);
        }

        .hourprice-create-input::placeholder {
            color: #98a4b5;
        }

        .hourprice-create-input:disabled {
            background: #f1f4f8;
            color: #8794a5;
            cursor: not-allowed;
        }

        .hourprice-create-input.input-validation-error {
            border-color: #dc756e;
        }

    /* النصوص الإرشادية */

    .hourprice-create-hint {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        color: #718096;
        font-size: 13px;
        line-height: 1.9;
        margin-top: 9px;
    }

        .hourprice-create-hint i {
            color: #b9913d;
            margin-top: 2px;
            flex-shrink: 0;
        }

    /* رسائل التحقق */

    .hourprice-create-error {
        display: block;
        color: #b42318;
        font-size: 13px;
        line-height: 1.7;
        margin-top: 7px;
    }

    .hourprice-create-validation-summary {
        background: #fff0ee;
        border: 1px solid #f1d8d5;
        border-radius: 11px;
        padding: 15px 18px;
        margin-bottom: 25px;
        color: #b42318;
        font-size: 14px;
    }

        .hourprice-create-validation-summary.validation-summary-valid {
            display: none;
        }

        .hourprice-create-validation-summary ul {
            margin: 0;
            padding-right: 20px;
        }

    /* بطاقة السعر */

    .hourprice-create-price-box {
        background: #f8fafc;
        border: 1px solid #e5eaf2;
        border-radius: 13px;
        padding: 23px;
    }

        .hourprice-create-price-box .hourprice-create-field {
            max-width: 450px;
        }

    /* ملاحظة */

    .hourprice-create-note {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        background: #fff9eb;
        border: 1px solid #eadbb5;
        border-right: 4px solid #c9a24d;
        border-radius: 11px;
        padding: 17px 19px;
        margin-bottom: 28px;
        color: #735b30;
        font-size: 14px;
        line-height: 1.9;
    }

        .hourprice-create-note i {
            color: #b9913d;
            font-size: 20px;
            flex-shrink: 0;
        }

    /* أزرار الإجراءات */

    .hourprice-create-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 25px;
        border-top: 1px solid #e9edf3;
    }

    .hourprice-create-save,
    .hourprice-create-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 45px;
        padding: 11px 22px;
        border-radius: 11px;
        font-size: 14px;
        font-weight: 800;
        font-family: inherit;
        text-decoration: none;
        transition: background-color .2s ease;
    }

    .hourprice-create-save {
        background: #c9a24d;
        color: #142d4e;
        border: 1px solid transparent;
        cursor: pointer;
    }

        .hourprice-create-save:hover {
            background: #b9913d;
            color: #142d4e;
        }

    .hourprice-create-cancel {
        background: #edf1f7;
        color: #142d4e;
        border: 1px solid #dfe6ef;
    }

        .hourprice-create-cancel:hover {
            background: #e1e8f2;
            color: #142d4e;
        }

        .hourprice-create-save:focus-visible,
        .hourprice-create-cancel:focus-visible {
            outline: 3px solid #142d4e;
            outline-offset: 3px;
        }

    /* الشاشات الصغيرة */

    @@media (max-width: 650px) {
        .hourprice-create-page {
            margin: 15px auto;
        }

        .hourprice-create-header,
        .hourprice-create-body {
            padding: 22px;
        }

            .hourprice-create-header h2 {
                font-size: 21px;
            }

        .hourprice-create-grid {
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .hourprice-create-field-full {
            grid-column: auto;
        }

        .hourprice-create-price-box {
            padding: 18px;
        }

        .hourprice-create-actions {
            flex-direction: column;
        }

        .hourprice-create-save,
        .hourprice-create-cancel {
            width: 100%;
        }
    }
</style>

<div class="hourprice-create-page">

    <!-- رأس الصفحة -->

    <div class="hourprice-create-header">

        <h2>
            <i class="bi bi-cash-coin"></i>
            إضافة سعر ساعة دراسية
        </h2>

        <p>
            تحديد سعر الساعة الدراسية لقسم أكاديمي
            ضمن كلية وفصل دراسي محددين.
        </p>

    </div>

    <!-- نموذج الإضافة -->

    <div class="hourprice-create-body">

        <form asp-controller="HourPrices"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <!-- رسائل التحقق -->

            <div asp-validation-summary="All"
                 class="hourprice-create-validation-summary"></div>

            <!-- اختيار الكلية والقسم -->

            <section class="hourprice-create-section">

                <h3 class="hourprice-create-section-title">
                    <i class="bi bi-building"></i>
                    الكلية والقسم الدراسي
                </h3>

                <div class="hourprice-create-grid">

                    <!-- الكلية -->

                    <div class="hourprice-create-field">

                        <label for="FacultyId"
                               class="hourprice-create-label">

                            الكلية
                            <span class="hourprice-create-required">*</span>

                        </label>

                        <select id="FacultyId"
                                class="hourprice-create-input"
                                required>

                            <option value="">
                                -- اختاروا الكلية --
                            </option>

                            @foreach (var faculty in faculties)
                            {
                                <option value="@faculty.Value">
                                    @faculty.Text
                                </option>
                            }

                        </select>

                        <div class="hourprice-create-hint">

                            <i class="bi bi-info-circle"></i>

                            <span>
                                اختاروا الكلية لعرض الأقسام التابعة لها.
                            </span>

                        </div>

                    </div>

                    <!-- القسم الدراسي -->

                    <div class="hourprice-create-field">

                        <label asp-for="DepartmentId"
                               class="hourprice-create-label">

                            القسم الدراسي
                            <span class="hourprice-create-required">*</span>

                        </label>

                        <select asp-for="DepartmentId"
                                id="DepartmentId"
                                class="hourprice-create-input"
                                required
                                disabled>

                            <option value="">
                                -- اختاروا الكلية أولًا --
                            </option>

                        </select>

                        <span asp-validation-for="DepartmentId"
                              class="hourprice-create-error"></span>

                        <div class="hourprice-create-hint">

                            <i class="bi bi-info-circle"></i>

                            <span>
                                تظهر الأقسام التابعة للكلية المختارة فقط.
                            </span>

                        </div>

                    </div>

                </div>

            </section>

            <!-- اختيار الفصل الدراسي -->

            <section class="hourprice-create-section">

                <h3 class="hourprice-create-section-title">
                    <i class="bi bi-calendar3"></i>
                    الفصل الدراسي
                </h3>

                <div class="hourprice-create-grid">

                    <div class="hourprice-create-field hourprice-create-field-full">

                        <label asp-for="SemesterId"
                               class="hourprice-create-label">

                            الفصل الدراسي
                            <span class="hourprice-create-required">*</span>

                        </label>

                        <select asp-for="SemesterId"
                                asp-items="ViewBag.SemesterId"
                                class="hourprice-create-input"
                                required>

                            <option value="">
                                -- اختاروا الفصل الدراسي --
                            </option>

                        </select>

                        <span asp-validation-for="SemesterId"
                              class="hourprice-create-error"></span>

                    </div>

                </div>

            </section>

            <!-- سعر الساعة -->

            <section class="hourprice-create-section">

                <h3 class="hourprice-create-section-title">
                    <i class="bi bi-currency-exchange"></i>
                    قيمة الساعة الدراسية
                </h3>

                <div class="hourprice-create-price-box">

                    <div class="hourprice-create-field">

                        <label asp-for="PricePerHour"
                               class="hourprice-create-label">

                            سعر الساعة الدراسية
                            <span class="hourprice-create-required">*</span>

                        </label>

                        <input asp-for="PricePerHour"
                               type="number"
                               min="0.01"
                               step="0.01"
                               class="hourprice-create-input"
                               dir="ltr"
                               placeholder="أدخلوا سعر الساعة"
                               required />

                        <span asp-validation-for="PricePerHour"
                              class="hourprice-create-error"></span>

                        <div class="hourprice-create-hint">

                            <i class="bi bi-info-circle"></i>

                            <span>
                                يجب إدخال قيمة أكبر من صفر.
                            </span>

                        </div>

                    </div>

                </div>

            </section>

            <!-- ملاحظة -->

            <div class="hourprice-create-note">

                <i class="bi bi-exclamation-circle"></i>

                <span>
                    لا يمكن تسجيل أكثر من سعر ساعة واحد
                    لنفس القسم ضمن نفس الفصل الدراسي.
                    تأكدوا من اختيار القسم والفصل الصحيحين
                    قبل حفظ البيانات.
                </span>

            </div>

            <!-- أزرار الإجراءات -->

            <div class="hourprice-create-actions">

                <button type="submit"
                        class="hourprice-create-save">

                    <i class="bi bi-check-circle"></i>
                    حفظ سعر الساعة

                </button>

                <a asp-controller="HourPrices"
                   asp-action="Index"
                   class="hourprice-create-cancel">

                    <i class="bi bi-x-circle"></i>
                    إلغاء والعودة

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const facultiesSelect =
                document.getElementById("FacultyId");

            const departmentsSelect =
                document.getElementById("DepartmentId");

            // الأقسام الحقيقية المرسلة من Controller
            const departments = @Html.Raw(departmentJson);

            // اختيار القسم السابق عند وجود خطأ في النموذج
            const previouslySelectedDepartment =
                        @Html.Raw(selectedDepartmentJson);

            function loadDepartments(selectedDepartmentId = "") {

                const facultyId = facultiesSelect.value;

                departmentsSelect.innerHTML = "";

                const defaultOption =
                    document.createElement("option");

                defaultOption.value = "";

                if (!facultyId) {

                    defaultOption.textContent =
                        "-- اختاروا الكلية أولًا --";

                    departmentsSelect.appendChild(defaultOption);

                    departmentsSelect.disabled = true;

                    return;
                }

                const filteredDepartments = departments.filter(
                    d => String(d.facultyId) === String(facultyId)
                );

                defaultOption.textContent =
                    filteredDepartments.length > 0
                        ? "-- اختاروا القسم الدراسي --"
                        : "-- لا توجد أقسام في هذه الكلية --";

                departmentsSelect.appendChild(defaultOption);

                filteredDepartments.forEach(function (department) {

                    const option =
                        document.createElement("option");

                    option.value = department.id;
                    option.textContent = department.name;

                    if (
                        String(department.id) ===
                        String(selectedDepartmentId)
                    ) {
                        option.selected = true;
                    }

                    departmentsSelect.appendChild(option);
                });

                departmentsSelect.disabled =
                    filteredDepartments.length === 0;
            }

            // عند تغيير الكلية، يتم تحديث الأقسام
            facultiesSelect.addEventListener("change", function () {
                loadDepartments();
            });

            // استرجاع الكلية والقسم المختارين سابقًا
            if (
                previouslySelectedDepartment &&
                previouslySelectedDepartment !== "0"
            ) {

                const selectedDepartment = departments.find(
                    d => String(d.id) ===
                        String(previouslySelectedDepartment)
                );

                if (selectedDepartment) {

                    facultiesSelect.value =
                        String(selectedDepartment.facultyId);

                    loadDepartments(previouslySelectedDepartment);
                }
            }

        });
    </script>
}
