@model StudentAffairsManagementSystem.Models.HourPrice

@{
    ViewData["Title"] = "حذف سعر الساعة الدراسية";
}

<style>
    .hourprice-delete-page {
        direction: rtl;
        max-width: 950px;
        margin: 20px auto;
        color: #142d4e;
    }

    /* رأس الصفحة */

    .hourprice-delete-header {
        background: linear-gradient(135deg, #142d4e, #304661);
        color: #ffffff;
        padding: 28px 32px;
        border-radius: 16px 16px 0 0;
        border-bottom: 4px solid #c9a24d;
    }

        .hourprice-delete-header h2 {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 25px;
            font-weight: 800;
            margin: 0 0 10px;
        }

            .hourprice-delete-header h2 i {
                color: #c9a24d;
                font-size: 27px;
            }

        .hourprice-delete-header p {
            color: #d6dfeb;
            font-size: 14px;
            line-height: 1.9;
            margin: 0;
        }

    /* جسم الصفحة */

    .hourprice-delete-body {
        background: #ffffff;
        padding: 30px;
        border: 1px solid #e5eaf2;
        border-top: none;
        border-radius: 0 0 16px 16px;
        box-shadow: 0 5px 25px rgba(20,45,78,.05);
    }

    /* رسالة التحذير */

    .hourprice-delete-warning {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        padding: 22px;
        background: #fff1ef;
        border: 1px solid #f0d3cf;
        border-right: 5px solid #c64b42;
        border-radius: 13px;
        margin-bottom: 32px;
    }

    .hourprice-delete-warning-icon {
        color: #b93e36;
        font-size: 28px;
        flex-shrink: 0;
        line-height: 1;
    }

    .hourprice-delete-warning-content {
        min-width: 0;
    }

    .hourprice-delete-warning-title {
        color: #a5352f;
        font-size: 18px;
        font-weight: 800;
        margin: 0 0 12px;
    }

    .hourprice-delete-warning-content p {
        color: #82423d;
        font-size: 14px;
        line-height: 2;
        margin: 0 0 10px;
    }

        .hourprice-delete-warning-content p:last-child {
            margin-bottom: 0;
        }

    /* عناوين الأقسام */

    .hourprice-delete-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #142d4e;
        font-size: 18px;
        font-weight: 800;
        border-right: 4px solid #c9a24d;
        padding-right: 13px;
        margin: 0 0 23px;
    }

        .hourprice-delete-section-title i {
            color: #b9913d;
            font-size: 20px;
        }

    /* شبكة المعلومات */

    .hourprice-delete-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 30px;
    }

    .hourprice-delete-item {
        background: #f8fafc;
        border: 1px solid #e7ecf3;
        border-radius: 12px;
        padding: 19px 20px;
        min-width: 0;
    }

    .hourprice-delete-item-label {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #718096;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 11px;
    }

        .hourprice-delete-item-label i {
            color: #b9913d;
            font-size: 16px;
        }

    .hourprice-delete-item-value {
        color: #142d4e;
        font-size: 17px;
        font-weight: 800;
        line-height: 1.7;
        overflow-wrap: anywhere;
    }

    /* حالة الفصل */

    .hourprice-delete-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 14px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 800;
    }

    .hourprice-delete-badge-active {
        background: #e7f5eb;
        color: #247247;
    }

    .hourprice-delete-badge-inactive {
        background: #edf1f5;
        color: #64748b;
    }

    /* بطاقة السعر */

    .hourprice-delete-price-box {
        background: linear-gradient(135deg, #f8fafc, #f4f0e5);
        border: 1px solid #e7dfc8;
        border-right: 5px solid #c9a24d;
        border-radius: 14px;
        padding: 25px 28px;
        margin-bottom: 30px;
    }

    .hourprice-delete-price-label {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #5d6b7d;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 12px;
    }

        .hourprice-delete-price-label i {
            color: #b9913d;
            font-size: 20px;
        }

    .hourprice-delete-price-value {
        color: #142d4e;
        font-size: 36px;
        font-weight: 900;
        line-height: 1.5;
        direction: ltr;
        unicode-bidi: isolate;
        display: inline-block;
    }

    /* ملاحظة */

    .hourprice-delete-note {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        background: #fff9eb;
        border: 1px solid #eadbb5;
        border-right: 4px solid #c9a24d;
        border-radius: 11px;
        padding: 17px 19px;
        margin-bottom: 28px;
        color: #735b30;
        font-size: 14px;
        line-height: 1.9;
    }

        .hourprice-delete-note i {
            color: #b9913d;
            font-size: 20px;
            flex-shrink: 0;
        }

    /* أزرار الإجراءات */

    .hourprice-delete-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 25px;
        border-top: 1px solid #e9edf3;
    }

    .hourprice-delete-confirm,
    .hourprice-delete-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 45px;
        padding: 11px 22px;
        border-radius: 11px;
        font-size: 14px;
        font-weight: 800;
        font-family: inherit;
        text-decoration: none;
        transition: background-color .2s ease;
    }

    .hourprice-delete-confirm {
        background: #b93e36;
        color: #ffffff;
        border: 1px solid transparent;
        cursor: pointer;
    }

        .hourprice-delete-confirm:hover {
            background: #9d302a;
            color: #ffffff;
        }

    .hourprice-delete-cancel {
        background: #edf1f7;
        color: #142d4e;
        border: 1px solid #dfe6ef;
    }

        .hourprice-delete-cancel:hover {
            background: #e1e8f2;
            color: #142d4e;
        }

        .hourprice-delete-confirm:focus-visible,
        .hourprice-delete-cancel:focus-visible {
            outline: 3px solid #142d4e;
            outline-offset: 3px;
        }

    /* الشاشات الصغيرة */

    @@media (max-width: 650px) {
        .hourprice-delete-page {
            margin: 15px auto;
        }

        .hourprice-delete-header,
        .hourprice-delete-body {
            padding: 22px;
        }

            .hourprice-delete-header h2 {
                font-size: 21px;
            }

        .hourprice-delete-warning {
            padding: 18px;
        }

        .hourprice-delete-warning-title {
            font-size: 16px;
        }

        .hourprice-delete-grid {
            grid-template-columns: 1fr;
        }

        .hourprice-delete-price-box {
            padding: 22px;
        }

        .hourprice-delete-price-value {
            font-size: 32px;
        }

        .hourprice-delete-actions {
            flex-direction: column;
        }

        .hourprice-delete-confirm,
        .hourprice-delete-cancel {
            width: 100%;
        }
    }
</style>

<div class="hourprice-delete-page">

    <!-- رأس الصفحة -->

    <div class="hourprice-delete-header">

        <h2>
            <i class="bi bi-trash3"></i>
            حذف سعر الساعة الدراسية
        </h2>

        <p>
            مراجعة بيانات سعر الساعة الدراسية
            قبل تأكيد عملية الحذف النهائي.
        </p>

    </div>

    <div class="hourprice-delete-body">

        <!-- رسالة التحذير -->

        <div class="hourprice-delete-warning"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill hourprice-delete-warning-icon"></i>

            <div class="hourprice-delete-warning-content">

                <h3 class="hourprice-delete-warning-title">
                    تأكيد حذف سعر الساعة الدراسية
                </h3>

                <p>
                    هل أنتم متأكدون من رغبتكم في حذف
                    سعر الساعة الدراسية المسجل؟
                </p>

                <p>
                    سيتم حذف هذا السجل نهائيًا من قاعدة البيانات
                    إذا سمحت العلاقات الموجودة بذلك.
                </p>

                <p>
                    يُفضّل التأكد من عدم الحاجة إلى هذا السعر
                    في السجلات المالية قبل المتابعة.
                </p>

            </div>

        </div>

        <!-- بيانات السعر -->

        <h3 class="hourprice-delete-section-title">

            <i class="bi bi-info-circle"></i>
            بيانات سعر الساعة المطلوب حذفه

        </h3>

        <div class="hourprice-delete-grid">

            <!-- القسم الدراسي -->

            <div class="hourprice-delete-item">

                <div class="hourprice-delete-item-label">
                    <i class="bi bi-building"></i>
                    القسم الدراسي
                </div>

                <div class="hourprice-delete-item-value">
                    @Model.Department?.Name
                </div>

            </div>

            <!-- الفصل الدراسي -->

            <div class="hourprice-delete-item">

                <div class="hourprice-delete-item-label">
                    <i class="bi bi-calendar3"></i>
                    الفصل الدراسي
                </div>

                <div class="hourprice-delete-item-value">
                    @Model.Semester?.Name
                </div>

            </div>

            <!-- العام الدراسي -->

            <div class="hourprice-delete-item">

                <div class="hourprice-delete-item-label">
                    <i class="bi bi-calendar-range"></i>
                    العام الدراسي
                </div>

                <div class="hourprice-delete-item-value">
                    @Model.Semester?.AcademicYear
                </div>

            </div>

            <!-- رقم الفصل -->

            <div class="hourprice-delete-item">

                <div class="hourprice-delete-item-label">
                    <i class="bi bi-hash"></i>
                    رقم الفصل الدراسي
                </div>

                <div class="hourprice-delete-item-value">
                    @Model.Semester?.SemesterNumber
                </div>

            </div>

            <!-- حالة الفصل -->

            <div class="hourprice-delete-item">

                <div class="hourprice-delete-item-label">
                    <i class="bi bi-toggle-on"></i>
                    حالة الفصل الدراسي
                </div>

                <div class="hourprice-delete-item-value">

                    @if (Model.Semester?.IsActive == true)
                    {
                        <span class="hourprice-delete-badge hourprice-delete-badge-active">

                            <i class="bi bi-check-circle"></i>
                            فعّال

                        </span>
                    }
                    else
                    {
                        <span class="hourprice-delete-badge hourprice-delete-badge-inactive">

                            <i class="bi bi-dash-circle"></i>
                            غير فعّال

                        </span>
                    }

                </div>

            </div>

        </div>

        <!-- السعر المسجل -->

        <h3 class="hourprice-delete-section-title">

            <i class="bi bi-currency-exchange"></i>
            السعر المسجل

        </h3>

        <div class="hourprice-delete-price-box">

            <div class="hourprice-delete-price-label">

                <i class="bi bi-cash-coin"></i>
                سعر الساعة الدراسية

            </div>

            <div class="hourprice-delete-price-value">
                @Model.PricePerHour.ToString("N2")
            </div>

        </div>

        <!-- ملاحظة مهمة -->

        <div class="hourprice-delete-note">

            <i class="bi bi-info-circle"></i>

            <span>
                الحذف النهائي لا يمكن التراجع عنه.
                تأكدوا من صحة القسم والفصل الدراسي
                والسعر المعروض قبل المتابعة.
                يبقى التحقق من إمكانية الحذف
                مسؤولية النظام عند إرسال الطلب.
            </span>

        </div>

        <!-- نموذج تأكيد الحذف -->

        <form asp-controller="HourPrices"
              asp-action="Delete"
              asp-route-id="@Model.Id"
              method="post"
              onsubmit="return confirm('هل أنتم متأكدون من حذف سعر الساعة الدراسية نهائيًا؟');">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="Id" />

            <div class="hourprice-delete-actions">

                <button type="submit"
                        class="hourprice-delete-confirm">

                    <i class="bi bi-trash3"></i>
                    تأكيد حذف سعر الساعة

                </button>

                <a asp-controller="HourPrices"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="hourprice-delete-cancel">

                    <i class="bi bi-x-circle"></i>
                    إلغاء والعودة للتفاصيل

                </a>

            </div>

        </form>

    </div>

</div>
