
@model StudentAffairsManagementSystem.Models.HourPrice

@{
    ViewData["Title"] = "حذف سعر الساعة الدراسية";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 style="color:#142d4e; font-weight:800;">
                حذف سعر الساعة الدراسية
            </h2>

            <p class="text-muted mb-0">
                مراجعة بيانات سعر الساعة قبل تأكيد الحذف
            </p>
        </div>

        <a asp-controller="HourPrices"
           asp-action="Index"
           class="btn btn-outline-secondary">
            العودة إلى أسعار الساعات
        </a>

    </div>

    <!-- رسالة التحذير -->
    <div class="alert alert-danger mb-4" role="alert">

        <h5 class="fw-bold mb-2">
            ⚠️ تأكيد حذف سعر الساعة
        </h5>

        <p class="mb-2">
            هل أنتم متأكدون من رغبتكم في حذف سعر الساعة الدراسية؟
        </p>

        <p class="mb-0">
            سيتم حذف هذا السجل نهائيًا من قاعدة البيانات
            إذا سمحت العلاقات الموجودة بذلك.
            يُفضّل التأكد من عدم الحاجة إلى السعر في السجلات المالية.
        </p>

    </div>

    <!-- بطاقة البيانات -->
    <div class="card border-0 shadow-sm">

        <div class="card-header py-3"
             style="background:#142d4e; color:white;">

            <h5 class="mb-0">
                بيانات سعر الساعة المطلوب حذفه
            </h5>

        </div>

        <div class="card-body p-4">

            <div class="row g-4">

                <!-- القسم الدراسي -->
                <div class="col-md-6">

                    <div class="text-muted mb-2">
                        القسم الدراسي
                    </div>

                    <div class="fw-bold fs-5">
                        @Model.Department.Name
                    </div>

                </div>

                <!-- الفصل الدراسي -->
                <div class="col-md-6">

                    <div class="text-muted mb-2">
                        الفصل الدراسي
                    </div>

                    <div class="fw-bold fs-5">
                        @Model.Semester.Name
                    </div>

                </div>

                <!-- العام الدراسي -->
                <div class="col-md-6">

                    <div class="text-muted mb-2">
                        العام الدراسي
                    </div>

                    <div class="fw-bold fs-5">
                        @Model.Semester.AcademicYear
                    </div>

                </div>

                <!-- رقم الفصل -->
                <div class="col-md-6">

                    <div class="text-muted mb-2">
                        رقم الفصل الدراسي
                    </div>

                    <div class="fw-bold fs-5">
                        @Model.Semester.SemesterNumber
                    </div>

                </div>

                <!-- السعر -->
                <div class="col-md-6">

                    <div class="text-muted mb-2">
                        سعر الساعة الدراسية
                    </div>

                    <div style="color:#142d4e; font-size:28px; font-weight:800;">
                        @Model.PricePerHour.ToString("N2")
                    </div>

                </div>

                <!-- حالة الفصل -->
                <div class="col-md-6">

                    <div class="text-muted mb-2">
                        حالة الفصل الدراسي
                    </div>

                    @if (Model.Semester.IsActive)
                    {
                        <span class="badge bg-success px-3 py-2">
                            فعال
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary px-3 py-2">
                            غير فعال
                        </span>
                    }

                </div>

            </div>

            <hr class="my-4" />

            <!-- نموذج تأكيد الحذف -->
            <form asp-controller="HourPrices"
                  asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div class="d-flex flex-wrap gap-3">

                    <button type="submit"
                            class="btn btn-danger px-4 py-2">
                        تأكيد حذف سعر الساعة
                    </button>

                    <a asp-controller="HourPrices"
                       asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary px-4 py-2">
                        إلغاء والعودة للتفاصيل
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>
