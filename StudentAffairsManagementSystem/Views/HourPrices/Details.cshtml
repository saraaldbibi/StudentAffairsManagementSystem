@model StudentAffairsManagementSystem.Models.HourPrice

@{
    ViewData["Title"] = "تفاصيل سعر الساعة الدراسية";

    bool isAdmin = User.IsInRole("Admin");
}

<style>
    .hourprice-details-page {
        direction: rtl;
        max-width: 950px;
        margin: 20px auto;
        color: #142d4e;
    }

    /* رأس الصفحة */

    .hourprice-details-header {
        background: linear-gradient(135deg, #142d4e, #304661);
        color: #ffffff;
        padding: 28px 32px;
        border-radius: 16px 16px 0 0;
        border-bottom: 4px solid #c9a24d;
    }

        .hourprice-details-header h2 {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 25px;
            font-weight: 800;
            margin: 0 0 10px;
        }

            .hourprice-details-header h2 i {
                color: #c9a24d;
                font-size: 27px;
            }

        .hourprice-details-header p {
            color: #d6dfeb;
            font-size: 14px;
            line-height: 1.9;
            margin: 0;
        }

    /* جسم الصفحة */

    .hourprice-details-body {
        background: #ffffff;
        padding: 30px;
        border: 1px solid #e5eaf2;
        border-top: none;
        border-radius: 0 0 16px 16px;
        box-shadow: 0 5px 25px rgba(20,45,78,.05);
    }

    /* بطاقة القسم */

    .hourprice-details-department {
        display: flex;
        align-items: center;
        gap: 18px;
        background: #f8fafc;
        border: 1px solid #e5eaf2;
        border-radius: 13px;
        padding: 23px;
        margin-bottom: 32px;
    }

    .hourprice-details-department-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        background: #f5ebd2;
        border-radius: 13px;
        color: #a9822c;
        font-size: 27px;
    }

    .hourprice-details-department-label {
        color: #718096;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .hourprice-details-department-name {
        color: #142d4e;
        font-size: 21px;
        font-weight: 800;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

    /* عناوين الأقسام */

    .hourprice-details-section {
        margin-bottom: 32px;
    }

    .hourprice-details-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #142d4e;
        font-size: 18px;
        font-weight: 800;
        border-right: 4px solid #c9a24d;
        padding-right: 13px;
        margin: 0 0 23px;
    }

        .hourprice-details-section-title i {
            color: #b9913d;
            font-size: 20px;
        }

    /* شبكة المعلومات */

    .hourprice-details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .hourprice-details-item {
        background: #f8fafc;
        border: 1px solid #e7ecf3;
        border-radius: 12px;
        padding: 19px 20px;
        min-width: 0;
    }

    .hourprice-details-item-label {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #718096;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 11px;
    }

        .hourprice-details-item-label i {
            color: #b9913d;
            font-size: 16px;
        }

    .hourprice-details-item-value {
        color: #142d4e;
        font-size: 17px;
        font-weight: 800;
        line-height: 1.7;
        overflow-wrap: anywhere;
    }

    /* حالة الفصل */

    .hourprice-details-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 14px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 800;
    }

    .hourprice-details-badge-active {
        background: #e7f5eb;
        color: #247247;
    }

    .hourprice-details-badge-inactive {
        background: #edf1f5;
        color: #64748b;
    }

    /* بطاقة السعر */

    .hourprice-details-price-box {
        background: linear-gradient(135deg, #f8fafc, #f4f0e5);
        border: 1px solid #e7dfc8;
        border-right: 5px solid #c9a24d;
        border-radius: 14px;
        padding: 28px;
    }

    .hourprice-details-price-label {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #5d6b7d;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 13px;
    }

        .hourprice-details-price-label i {
            color: #b9913d;
            font-size: 20px;
        }

    .hourprice-details-price-value {
        color: #142d4e;
        font-size: 38px;
        font-weight: 900;
        line-height: 1.5;
        direction: ltr;
        unicode-bidi: isolate;
        display: inline-block;
    }

    .hourprice-details-price-hint {
        color: #718096;
        font-size: 13px;
        line-height: 1.9;
        margin-top: 9px;
    }

    /* أزرار الإجراءات */

    .hourprice-details-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 25px;
        margin-top: 30px;
        border-top: 1px solid #e9edf3;
    }

    .hourprice-details-edit,
    .hourprice-details-delete,
    .hourprice-details-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 45px;
        padding: 11px 22px;
        border-radius: 11px;
        font-size: 14px;
        font-weight: 800;
        font-family: inherit;
        text-decoration: none;
        transition: background-color .2s ease;
    }

    .hourprice-details-edit {
        background: #c9a24d;
        color: #142d4e;
        border: 1px solid transparent;
    }

        .hourprice-details-edit:hover {
            background: #b9913d;
            color: #142d4e;
        }

    .hourprice-details-delete {
        background: #fff0ee;
        color: #b42318;
        border: 1px solid #f0d4d0;
    }

        .hourprice-details-delete:hover {
            background: #fce0dc;
            color: #a31d15;
        }

    .hourprice-details-back {
        background: #edf1f7;
        color: #142d4e;
        border: 1px solid #dfe6ef;
    }

        .hourprice-details-back:hover {
            background: #e1e8f2;
            color: #142d4e;
        }

        .hourprice-details-edit:focus-visible,
        .hourprice-details-delete:focus-visible,
        .hourprice-details-back:focus-visible {
            outline: 3px solid #142d4e;
            outline-offset: 3px;
        }

    /* الشاشات الصغيرة */

    @@media (max-width: 650px) {
        .hourprice-details-page {
            margin: 15px auto;
        }

        .hourprice-details-header,
        .hourprice-details-body {
            padding: 22px;
        }

            .hourprice-details-header h2 {
                font-size: 21px;
            }

        .hourprice-details-department {
            padding: 18px;
            gap: 13px;
        }

        .hourprice-details-department-icon {
            width: 48px;
            height: 48px;
            font-size: 23px;
        }

        .hourprice-details-department-name {
            font-size: 18px;
        }

        .hourprice-details-grid {
            grid-template-columns: 1fr;
        }

        .hourprice-details-price-box {
            padding: 22px;
        }

        .hourprice-details-price-value {
            font-size: 32px;
        }

        .hourprice-details-actions {
            flex-direction: column;
        }

        .hourprice-details-edit,
        .hourprice-details-delete,
        .hourprice-details-back {
            width: 100%;
        }
    }
</style>

<div class="hourprice-details-page">

    <!-- رأس الصفحة -->

    <div class="hourprice-details-header">

        <h2>
            <i class="bi bi-info-circle"></i>
            تفاصيل سعر الساعة الدراسية
        </h2>

        <p>
            عرض معلومات سعر الساعة الدراسية
            المسجل في النظام للقسم والفصل المحددين.
        </p>

    </div>

    <div class="hourprice-details-body">

        <!-- القسم الدراسي -->

        <div class="hourprice-details-department">

            <div class="hourprice-details-department-icon">
                <i class="bi bi-building"></i>
            </div>

            <div>

                <div class="hourprice-details-department-label">
                    القسم الدراسي
                </div>

                <div class="hourprice-details-department-name">
                    @Model.Department?.Name
                </div>

            </div>

        </div>

        <!-- معلومات الفصل الدراسي -->

        <section class="hourprice-details-section">

            <h3 class="hourprice-details-section-title">
                <i class="bi bi-calendar3"></i>
                معلومات الفصل الدراسي
            </h3>

            <div class="hourprice-details-grid">

                <!-- اسم الفصل -->

                <div class="hourprice-details-item">

                    <div class="hourprice-details-item-label">
                        <i class="bi bi-calendar-event"></i>
                        اسم الفصل الدراسي
                    </div>

                    <div class="hourprice-details-item-value">
                        @Model.Semester?.Name
                    </div>

                </div>

                <!-- العام الدراسي -->

                <div class="hourprice-details-item">

                    <div class="hourprice-details-item-label">
                        <i class="bi bi-calendar-range"></i>
                        العام الدراسي
                    </div>

                    <div class="hourprice-details-item-value">
                        @Model.Semester?.AcademicYear
                    </div>

                </div>

                <!-- رقم الفصل -->

                <div class="hourprice-details-item">

                    <div class="hourprice-details-item-label">
                        <i class="bi bi-hash"></i>
                        رقم الفصل الدراسي
                    </div>

                    <div class="hourprice-details-item-value">
                        @Model.Semester?.SemesterNumber
                    </div>

                </div>

                <!-- حالة الفصل -->

                <div class="hourprice-details-item">

                    <div class="hourprice-details-item-label">
                        <i class="bi bi-toggle-on"></i>
                        حالة الفصل الدراسي
                    </div>

                    <div class="hourprice-details-item-value">

                        @if (Model.Semester?.IsActive == true)
                        {
                            <span class="hourprice-details-badge hourprice-details-badge-active">

                                <i class="bi bi-check-circle"></i>
                                فعّال

                            </span>
                        }
                        else
                        {
                            <span class="hourprice-details-badge hourprice-details-badge-inactive">

                                <i class="bi bi-dash-circle"></i>
                                غير فعّال

                            </span>
                        }

                    </div>

                </div>

            </div>

        </section>

        <!-- السعر المسجل -->

        <section class="hourprice-details-section">

            <h3 class="hourprice-details-section-title">
                <i class="bi bi-currency-exchange"></i>
                السعر المسجل
            </h3>

            <div class="hourprice-details-price-box">

                <div class="hourprice-details-price-label">

                    <i class="bi bi-cash-coin"></i>
                    سعر الساعة الدراسية

                </div>

                <div class="hourprice-details-price-value">
                    @Model.PricePerHour.ToString("N2")
                </div>

                <div class="hourprice-details-price-hint">
                    السعر المحدد لهذا القسم
                    خلال الفصل الدراسي المذكور.
                </div>

            </div>

        </section>

        <!-- أزرار الإجراءات -->

        <div class="hourprice-details-actions">

            @if (isAdmin)
            {
                <a asp-controller="HourPrices"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="hourprice-details-edit">

                    <i class="bi bi-pencil-square"></i>
                    تعديل سعر الساعة

                </a>

                <a asp-controller="HourPrices"
                   asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="hourprice-details-delete">

                    <i class="bi bi-trash3"></i>
                    حذف سعر الساعة

                </a>
            }

            <a asp-controller="HourPrices"
               asp-action="Index"
               class="hourprice-details-back">

                <i class="bi bi-arrow-right"></i>
                العودة إلى أسعار الساعات

            </a>

        </div>

    </div>

</div>
