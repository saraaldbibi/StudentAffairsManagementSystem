@model List<StudentAffairsManagementSystem.Models.Employee>

@using System
@using System.Collections.Generic
@using System.Linq

@{
    ViewData["Title"] = "إدارة الصلاحيات";

    var employeePermissions =
        ViewBag.EmployeePermissions as Dictionary<long, List<string>>
        ?? new Dictionary<long, List<string>>();

    int totalStudents = ViewBag.TotalStudents is int total
        ? total : 0;

    int studentsWithPermission =
        ViewBag.StudentsWithRegistrationPermission is int granted
            ? granted : 0;

    int studentsWithoutPermission =
        ViewBag.StudentsWithoutRegistrationPermission is int missing
            ? missing
            : Math.Max(0, totalStudents - studentsWithPermission);

    var permissionDefinitions = new[]
    {
        new
        {
            Code = "Students.Delete",
            Name = "حذف طالب",
            Description = "السماح بحذف سجل الطالب وفق ضوابط النظام.",
            Icon = "bi-trash3"
        },
        new
        {
            Code = "Students.Create",
            Name = "إنشاء حسابات الطلاب",
            Description = "السماح بإضافة الطلاب وإنشاء حساباتهم.",
            Icon = "bi-person-plus"
        },
        new
        {
            Code = "Registrations.Manage",
            Name = "تسجيل المقررات الدراسية",
            Description = "السماح بتسجيل المقررات وإدارة تسجيلات الطلاب.",
            Icon = "bi-journal-check"
        }
    };
}

<style>
    .permissions-page {
        direction: rtl;
        color: #142d4e;
    }

    /* عنوان الصفحة */

    .permissions-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 25px;
    }

        .permissions-heading h2 {
            font-size: 25px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .permissions-heading p {
            margin: 0;
            color: #718198;
        }

    .heading-icon {
        width: 56px;
        height: 56px;
        background: #142d4e;
        color: #c9a24d;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
    }

    /* البطاقات */

    .permissions-panel {
        background: #fff;
        border: 1px solid #e4e9f0;
        border-radius: 15px;
        overflow: hidden;
        margin-bottom: 24px;
        box-shadow: 0 3px 12px rgba(20,45,78,.04);
    }

    .panel-header {
        background: #142d4e;
        color: #fff;
        padding: 18px 22px;
        font-size: 17px;
        font-weight: 800;
    }

        .panel-header i {
            color: #c9a24d;
            margin-left: 8px;
        }

    .panel-body {
        padding: 24px;
    }

    /* البحث عن موظف */

    .search-label {
        display: block;
        font-weight: 700;
        font-size: 14px;
        margin-bottom: 11px;
    }

    .search-container {
        position: relative;
    }

        .search-container > i {
            position: absolute;
            right: 16px;
            top: 23px;
            color: #718198;
            z-index: 1;
        }

    .search-input {
        width: 100%;
        padding: 13px 45px 13px 15px;
        border: 1px solid #dce3ed;
        border-radius: 11px;
        outline: none;
        color: #142d4e;
        background: #fff;
    }

        .search-input:focus {
            border-color: #c9a24d;
            box-shadow: 0 0 0 3px rgba(201,162,77,.13);
        }

    .search-results {
        margin-top: 10px;
        border: 1px solid #e4e9f0;
        border-radius: 11px;
        overflow: hidden;
        max-height: 300px;
        overflow-y: auto;
        background: #fff;
    }

    .search-result {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        width: 100%;
        text-align: right;
        padding: 14px 17px;
        border: none;
        border-bottom: 1px solid #edf0f5;
        background: white;
        color: #142d4e;
        cursor: pointer;
    }

        .search-result:last-child {
            border-bottom: none;
        }

        .search-result:hover,
        .search-result:focus {
            background: #f5f7fb;
        }

    .search-result-name {
        font-size: 14px;
        font-weight: 700;
    }

    .search-result-number {
        font-size: 12px;
        color: #718198;
        margin-top: 5px;
    }

    .search-hint {
        font-size: 12px;
        color: #718198;
        margin-top: 12px;
    }

    /* الموظف المحدد */

    .selected-employee {
        display: none;
    }

    .employee-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        padding: 20px 24px;
        background: #f5f7fa;
        border-bottom: 1px solid #e4e9f0;
    }

    .employee-identity {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .employee-avatar {
        width: 49px;
        height: 49px;
        flex-shrink: 0;
        border-radius: 12px;
        background: #142d4e;
        color: #c9a24d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .employee-name {
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .employee-number {
        color: #718198;
        font-size: 12px;
    }

    .permission-count {
        background: #eaf0f7;
        color: #142d4e;
        border-radius: 25px;
        padding: 8px 13px;
        font-size: 12px;
        font-weight: 700;
    }

    /* صفوف الصلاحيات */

    .permission-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
    }

        .permission-row:last-child {
            border-bottom: none;
        }

    .permission-info {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .permission-icon {
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #f0f3f8;
        color: #142d4e;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .permission-name {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .permission-description {
        font-size: 12px;
        color: #718198;
    }

    .permission-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
    }

    .permission-status {
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

        .permission-status.active {
            color: #218653;
        }

        .permission-status.inactive {
            color: #8b96a6;
        }

    /* التصميم الموحد للأزرار */

    .permission-button,
    .change-employee {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 43px;
        padding: 9px 15px;
        border-radius: 11px;
        border: 1px solid transparent;
        font-size: 14px;
        font-weight: 700;
        white-space: nowrap;
        cursor: pointer;
        transition: background-color .2s ease, transform .2s ease;
    }

    .permission-button {
        min-width: 145px;
    }

        .permission-button i,
        .change-employee i {
            font-size: 16px;
        }

        .permission-button:hover:not(:disabled),
        .change-employee:hover {
            transform: translateY(-1px);
        }

        .permission-button:focus-visible,
        .change-employee:focus-visible {
            outline: 3px solid #142d4e;
            outline-offset: 3px;
        }

        /* منح الصلاحية */

        .permission-button.grant {
            background: #c9a24d;
            color: #142d4e;
        }

            .permission-button.grant:hover:not(:disabled) {
                background: #b9913d;
            }

        /* سحب الصلاحية */

        .permission-button.revoke {
            background: #fff0ee;
            color: #c62828;
            border-color: #ffc5bf;
        }

            .permission-button.revoke:hover:not(:disabled) {
                background: #ffe0dc;
                color: #a91e1e;
                border-color: #f2a8a0;
            }

        .permission-button:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    /* تغيير الموظف */

    .change-employee {
        background: #eef2f8;
        color: #142d4e;
    }

        .change-employee:hover {
            background: #dfe7f2;
        }

    .empty-message {
        text-align: center;
        padding: 20px;
        color: #718198;
        font-size: 13px;
    }

    /* صلاحيات تسجيل الطلاب */

    .student-permissions-description {
        color: #718198;
        font-size: 14px;
        line-height: 1.9;
        margin-bottom: 22px;
    }

    .student-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 22px;
    }

    .student-stat-card {
        background: #f7f9fc;
        border: 1px solid #e4e9f0;
        border-radius: 12px;
        padding: 19px;
    }

        .student-stat-card .stat-label {
            font-size: 13px;
            color: #718198;
            margin-bottom: 12px;
        }

        .student-stat-card .stat-number {
            font-size: 27px;
            font-weight: 800;
            color: #142d4e;
        }

        .student-stat-card.granted .stat-number {
            color: #218653;
        }

        .student-stat-card.not-granted .stat-number {
            color: #b54a3a;
        }

    .student-permission-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 18px;
    }

        .student-permission-actions form {
            margin: 0;
        }

        .student-permission-actions .permission-button {
            padding: 12px 19px;
            min-width: 270px;
        }

    .student-permission-note {
        background: #f8f5ec;
        border-right: 4px solid #c9a24d;
        border-radius: 8px;
        padding: 14px 17px;
        color: #69582e;
        font-size: 13px;
        line-height: 1.9;
    }

    /* الشاشات الصغيرة */

    @@media (max-width: 850px) {
        .permission-row {
            flex-direction: column;
            align-items: stretch;
        }

        .permission-actions {
            justify-content: space-between;
            flex-wrap: wrap;
        }

        .student-stats {
            grid-template-columns: 1fr;
        }

        .student-permission-actions {
            flex-direction: column;
            align-items: stretch;
        }

            .student-permission-actions form,
            .student-permission-actions .permission-button {
                width: 100%;
            }
    }

    @@media (max-width: 600px) {
        .panel-body {
            padding: 18px;
        }

        .employee-header {
            padding: 18px;
        }

        .permission-row {
            padding: 18px;
        }

        .permissions-heading h2 {
            font-size: 23px;
        }
    }
</style>

<div class="container-fluid py-4 permissions-page">

    <!-- عنوان الصفحة -->

    <div class="permissions-heading">

        <div>
            <h2>إدارة الصلاحيات</h2>
            <p>
                إدارة صلاحيات الموظفين والتحكم في إمكانية
                تسجيل المقررات الدراسية للطلاب.
            </p>
        </div>

        <div class="heading-icon">
            <i class="bi bi-shield-lock"></i>
        </div>

    </div>

    <!-- رسائل النظام -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- صلاحيات تسجيل المقررات لجميع الطلاب -->

    <div class="permissions-panel" id="studentPermissionsPanel">

        <div class="panel-header">
            <i class="bi bi-mortarboard"></i>
            صلاحيات تسجيل المقررات للطلاب
        </div>

        <div class="panel-body">

            <p class="student-permissions-description">
                يمكن لمدير النظام منح صلاحية تسجيل المقررات
                الدراسية لجميع الطلاب النشطين أو سحبها منهم
                دفعة واحدة، دون الحاجة إلى تعديل صلاحية كل طالب
                بشكل منفصل.
            </p>

            <!-- إحصائيات الطلاب -->

            <div class="student-stats">

                <div class="student-stat-card">

                    <div class="stat-label">
                        <i class="bi bi-people"></i>
                        إجمالي الطلاب النشطين
                    </div>

                    <div class="stat-number">
                        @totalStudents
                    </div>

                </div>

                <div class="student-stat-card granted">

                    <div class="stat-label">
                        <i class="bi bi-check-circle"></i>
                        الطلاب الممنوحون صلاحية التسجيل
                    </div>

                    <div class="stat-number">
                        @studentsWithPermission
                    </div>

                </div>

                <div class="student-stat-card not-granted">

                    <div class="stat-label">
                        <i class="bi bi-x-circle"></i>
                        الطلاب غير الممنوحين صلاحية التسجيل
                    </div>

                    <div class="stat-number">
                        @studentsWithoutPermission
                    </div>

                </div>

            </div>

            <!-- أزرار منح وسحب صلاحية جميع الطلاب -->

            <div class="student-permission-actions">

                <form asp-controller="EmployeePermissions"
                      asp-action="GrantAllStudents"
                      method="post"
                      onsubmit="return confirm('هل تريد منح صلاحية تسجيل المقررات لجميع الطلاب النشطين؟');">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="permission-button grant"
                            disabled="@(studentsWithoutPermission == 0)">

                        <i class="bi bi-person-check"></i>
                        منح صلاحية التسجيل لجميع الطلاب

                    </button>

                </form>

                <form asp-controller="EmployeePermissions"
                      asp-action="RevokeAllStudents"
                      method="post"
                      onsubmit="return confirm('هل أنت متأكد من سحب صلاحية تسجيل المقررات من جميع الطلاب النشطين؟ لن يتمكن الطلاب من تسجيل مقررات جديدة حتى إعادة منح الصلاحية.');">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="permission-button revoke"
                            disabled="@(studentsWithPermission == 0)">

                        <i class="bi bi-person-x"></i>
                        سحب صلاحية التسجيل من جميع الطلاب

                    </button>

                </form>

            </div>

            <!-- ملاحظة مهمة -->

            <div class="student-permission-note">

                <i class="bi bi-info-circle"></i>

                <strong>تنبيه:</strong>

                منح صلاحية التسجيل لا يعني فتح فترة تسجيل المقررات.
                يجب أن تكون فترة التسجيل مفتوحة ضمن الفصل الدراسي
                النشط حتى يتمكن الطالب من تسجيل مقرراته.
                كما أن سحب الصلاحية لا يلغي المقررات المسجلة مسبقًا.

            </div>

        </div>
    </div>

    <!-- البحث عن موظف -->

    <div class="permissions-panel" id="searchPanel">

        <div class="panel-header">
            <i class="bi bi-search"></i>
            البحث عن موظف
        </div>

        <div class="panel-body">

            <label for="employeeSearch" class="search-label">
                اسم الموظف أو الرقم الوظيفي
            </label>

            <div class="search-container">

                <i class="bi bi-search"></i>

                <input type="search"
                       id="employeeSearch"
                       class="search-input"
                       placeholder="أدخل اسم الموظف أو الرقم الوظيفي"
                       autocomplete="off"
                       aria-controls="searchResults" />

                <!-- نتائج البحث -->

                <div id="searchResults"
                     class="search-results"
                     style="display:none;">

                    @foreach (var employee in Model)
                    {
                        var fullName = string.Join(" ", new[]
                        {
                            employee.FirstName,
                            employee.FatherName,
                            employee.LastName
                        }.Where(x => !string.IsNullOrWhiteSpace(x)));

                        <button type="button"
                                class="search-result"
                                data-employee-id="@employee.Id"
                                data-employee-name="@fullName"
                                data-employee-number="@employee.EmployeeNumber">

                            <div>

                                <div class="search-result-name">
                                    @fullName
                                </div>

                                <div class="search-result-number">
                                    الرقم الوظيفي:
                                    @employee.EmployeeNumber
                                </div>

                            </div>

                            <i class="bi bi-chevron-left"></i>

                        </button>
                    }

                    <div id="noResults"
                         class="empty-message"
                         style="display:none;">

                        لا يوجد موظفون مطابقون لمعايير البحث.

                    </div>

                </div>

            </div>

            <div class="search-hint">
                تظهر نتائج البحث أثناء الكتابة.
                يرجى اختيار الموظف المطلوب لعرض صلاحياته.
            </div>

        </div>
    </div>

    <!-- بطاقة صلاحيات الموظف المحدد -->

    <div class="permissions-panel selected-employee"
         id="selectedEmployeePanel">

        <div class="panel-header">
            <i class="bi bi-person-check"></i>
            صلاحيات الموظف المحدد
        </div>

        @foreach (var employee in Model)
        {
            var fullName = string.Join(" ", new[]
            {
                employee.FirstName,
                employee.FatherName,
                employee.LastName
            }.Where(x => !string.IsNullOrWhiteSpace(x)));

            var grantedCodes =
                employeePermissions.TryGetValue(
                    employee.AccountId,
                    out var codes)
                ? codes
                : new List<string>();

            var grantedCount = permissionDefinitions.Count(
                p => grantedCodes.Contains(p.Code));

            <div class="employee-details"
                 data-employee-id="@employee.Id"
                 style="display:none;">

                <!-- بيانات الموظف -->

                <div class="employee-header">

                    <div class="employee-identity">

                        <div class="employee-avatar">
                            <i class="bi bi-person"></i>
                        </div>

                        <div>

                            <div class="employee-name">
                                @fullName
                            </div>

                            <div class="employee-number">
                                الرقم الوظيفي:
                                @employee.EmployeeNumber
                            </div>

                        </div>

                    </div>

                    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">

                        <span class="permission-count">
                            @grantedCount من @permissionDefinitions.Length صلاحيات
                        </span>

                        <!-- زر تغيير الموظف -->

                        <button type="button"
                                class="change-employee"
                                id="changeEmployee_@employee.Id">

                            <i class="bi bi-arrow-repeat"></i>
                            تغيير الموظف

                        </button>

                    </div>

                </div>

                <!-- قائمة صلاحيات الموظف -->
                @foreach (var permission in permissionDefinitions)
                {
                    bool isGranted =
                        grantedCodes.Contains(permission.Code);

                    <div class="permission-row">

                        <div class="permission-info">

                            <div class="permission-icon">
                                <i class="bi @permission.Icon"></i>
                            </div>

                            <div>

                                <div class="permission-name">
                                    @permission.Name
                                </div>

                                <div class="permission-description">
                                    @permission.Description
                                </div>

                            </div>

                        </div>

                        <!-- حالة الصلاحية والإجراء -->

                        <div class="permission-actions">

                            @if (isGranted)
                            {
                                <span class="permission-status active">
                                    مفعّلة
                                </span>

                                <form asp-controller="EmployeePermissions"
                                      asp-action="Revoke"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="employeeId"
                                           value="@employee.Id" />

                                    <input type="hidden"
                                           name="permissionCode"
                                           value="@permission.Code" />

                                    <button type="submit"
                                            class="permission-button revoke"
                                            onclick="return confirm('هل تريد سحب هذه الصلاحية من الموظف؟');">

                                        <i class="bi bi-x-circle"></i>
                                        سحب الصلاحية

                                    </button>

                                </form>
                            }
                            else
                            {
                                <span class="permission-status inactive">
                                    غير مفعّلة
                                </span>

                                <form asp-controller="EmployeePermissions"
                                      asp-action="Grant"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="employeeId"
                                           value="@employee.Id" />

                                    <input type="hidden"
                                           name="permissionCode"
                                           value="@permission.Code" />

                                    <button type="submit"
                                            class="permission-button grant">

                                        <i class="bi bi-check-circle"></i>
                                        منح الصلاحية

                                    </button>

                                </form>
                            }

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("employeeSearch");

            const searchResults =
                document.getElementById("searchResults");

            const noResults =
                document.getElementById("noResults");

            const selectedPanel =
                document.getElementById("selectedEmployeePanel");

            const employeeButtons =
                document.querySelectorAll(".search-result");

            const employeeDetails =
                document.querySelectorAll(".employee-details");

            const changeButtons =
                document.querySelectorAll(".change-employee");

            function filterEmployees() {

                const query =
                    searchInput.value.trim().toLowerCase();

                let count = 0;

                if (query.length === 0) {
                    searchResults.style.display = "none";
                    return;
                }

                employeeButtons.forEach(function (button) {

                    const name =
                        (button.dataset.employeeName || "")
                            .toLowerCase();

                    const number =
                        (button.dataset.employeeNumber || "")
                            .toLowerCase();

                    const matches =
                        name.includes(query) ||
                        number.includes(query);

                    button.style.display =
                        matches ? "flex" : "none";

                    if (matches) count++;
                });

                searchResults.style.display = "block";

                noResults.style.display =
                    count === 0 ? "block" : "none";
            }

            function selectEmployee(employeeId) {

                employeeDetails.forEach(function (details) {

                    details.style.display =
                        details.dataset.employeeId === employeeId
                            ? "block"
                            : "none";
                });

                selectedPanel.style.display = "block";
                searchResults.style.display = "none";
                searchInput.value = "";

                selectedPanel.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });
            }

            function resetSelection() {

                selectedPanel.style.display = "none";

                employeeDetails.forEach(function (details) {
                    details.style.display = "none";
                });

                searchInput.value = "";
                searchResults.style.display = "none";

                searchInput.focus();
            }

            searchInput.addEventListener(
                "input",
                filterEmployees
            );

            employeeButtons.forEach(function (button) {

                button.addEventListener("click", function () {
                    selectEmployee(this.dataset.employeeId);
                });
            });

            changeButtons.forEach(function (button) {

                button.addEventListener(
                    "click",
                    resetSelection
                );
            });

            // الاحتفاظ بالموظف المحدد بعد تعديل صلاحياته

            const savedEmployeeId =
                sessionStorage.getItem(
                    "permissionsSelectedEmployee"
                );

            if (savedEmployeeId) {

                const exists =
                    Array.from(employeeDetails).some(
                        d => d.dataset.employeeId ===
                            savedEmployeeId
                    );

                if (exists) {
                    selectEmployee(savedEmployeeId);
                }

                sessionStorage.removeItem(
                    "permissionsSelectedEmployee"
                );
            }

            document.querySelectorAll(
                ".employee-details form"
            ).forEach(function (form) {

                form.addEventListener("submit", function () {

                    const employeeId =
                        this.closest(".employee-details")
                            .dataset.employeeId;

                    sessionStorage.setItem(
                        "permissionsSelectedEmployee",
                        employeeId
                    );
                });

            });

        });
    </script>
}
