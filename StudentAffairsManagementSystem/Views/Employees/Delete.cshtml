
@model StudentAffairsManagementSystem.Models.Employee

@{
    ViewData["Title"] = "حذف الموظف";

    string fullName =
        $"{Model.FirstName} {Model.FatherName} {Model.LastName}";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="mb-4">
        <h2 style="color:#142d4e; font-weight:800;">
            حذف الموظف
        </h2>

        <p class="text-muted">
            تأكيد حذف الموظف من قائمة الموظفين النشطين
        </p>
    </div>

    <!-- رسالة التحذير -->
    <div class="alert alert-warning border-0 shadow-sm mb-4">
        <h5 class="fw-bold mb-2">
            ⚠️ هل أنت متأكد من حذف هذا الموظف؟
        </h5>

        <p class="mb-2">
            عند تأكيد الحذف، سيتم إخفاء الموظف من قائمة الموظفين،
            وتعطيل حساب الدخول والصلاحيات المرتبطة به.
        </p>

        <p class="mb-0">
            <strong>ملاحظة:</strong>
            لن يتم حذف سجل الموظف نهائيًا من قاعدة البيانات،
            وستبقى بياناته محفوظة لأغراض التوثيق.
        </p>
    </div>

    <!-- بطاقة بيانات الموظف -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header py-3"
             style="background:#142d4e; color:white;">
            <h5 class="mb-0">
                بيانات الموظف المراد حذفه
            </h5>
        </div>

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-md-6">
                    <div class="text-muted mb-1">
                        الاسم الكامل
                    </div>

                    <div class="fw-bold">
                        @fullName
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted mb-1">
                        الرقم الوظيفي
                    </div>

                    <div class="fw-bold">
                        @Model.EmployeeNumber
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted mb-1">
                        رقم الهاتف
                    </div>

                    <div class="fw-bold">
                        @(string.IsNullOrWhiteSpace(Model.Phone)
                            ? "غير مسجل"
                            : Model.Phone)
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted mb-1">
                        العنوان
                    </div>

                    <div class="fw-bold">
                        @(string.IsNullOrWhiteSpace(Model.Address)
                            ? "غير مسجل"
                            : Model.Address)
                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- نموذج تأكيد الحذف -->
    <form asp-controller="Employees"
          asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="id"
               value="@Model.Id" />

        <div class="d-flex flex-wrap gap-3">

            <button type="submit"
                    class="btn btn-danger px-5 py-2 fw-bold"
                    onclick="return confirm('هل أنت متأكد من حذف هذا الموظف وتعطيل حسابه؟');">
                تأكيد حذف الموظف
            </button>

            <a asp-controller="Employees"
               asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-outline-secondary px-4 py-2">
                إلغاء والعودة
            </a>

        </div>

    </form>

</div>
