
@model IEnumerable<StudentAffairsManagementSystem.Models.Employee>

@{
    ViewData["Title"] = "إدارة الموظفين";

    var employees = Model.ToList();
}

<div class="container-fluid py-4" dir="rtl">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 style="color:#142d4e; font-weight:800;">
                إدارة الموظفين
            </h2>
            <p class="text-muted mb-0">
                عرض وإدارة موظفي الجامعة
            </p>
        </div>

        <a asp-controller="Employees"
           asp-action="Create"
           class="btn px-4 py-2"
           style="background:#c9a24d; color:#142d4e; font-weight:bold;">
            + إضافة موظف جديد
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body d-flex align-items-center gap-3 p-4">
            <div style="background:#142d4e; color:#fff; padding:15px 22px; border-radius:12px; font-size:24px;">
                👥
            </div>
            <div>
                <div class="text-muted">إجمالي الموظفين الحاليين</div>
                <h3 class="mb-0" style="color:#142d4e; font-weight:800;">
                    @employees.Count
                </h3>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header py-3"
             style="background:#142d4e; color:white;">
            <h5 class="mb-0">قائمة الموظفين</h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center mb-0">
                    <thead style="background:#f5f6f8;">
                        <tr>
                            <th>الرقم الوظيفي</th>
                            <th>الاسم الكامل</th>
                            <th>رقم الهاتف</th>
                            <th>العنوان</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (employees.Any())
                        {
                            @foreach (var employee in employees)
                            {
                                <tr>
                                    <td>
                                        <strong>@employee.EmployeeNumber</strong>
                                    </td>

                                    <td>
                                        @employee.FirstName
                                        @employee.FatherName
                                        @employee.LastName
                                    </td>

                                    <td>@employee.Phone</td>
                                    <td>@employee.Address</td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-2 flex-wrap">

                                            <a asp-controller="Employees"
                                               asp-action="Details"
                                               asp-route-id="@employee.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                التفاصيل
                                            </a>

                                            <a asp-controller="Employees"
                                               asp-action="Edit"
                                               asp-route-id="@employee.Id"
                                               class="btn btn-sm btn-outline-warning">
                                                تعديل
                                            </a>

                                            <a asp-controller="Employees"
                                               asp-action="Delete"
                                               asp-route-id="@employee.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                حذف
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="py-5 text-muted">
                                    لا يوجد موظفون مسجلون حاليًا.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
