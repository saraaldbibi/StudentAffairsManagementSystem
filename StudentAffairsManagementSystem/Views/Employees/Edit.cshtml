@model StudentAffairsManagementSystem.Models.Employee

@{
    ViewData["Title"] = "تعديل بيانات الموظف";
}

<style>
    .employee-edit-page {
        direction: rtl;
        max-width: 1100px;
        margin: 20px auto;
        color: #142d4e;
    }

    /* رأس الصفحة */

    .employee-edit-header {
        background: linear-gradient(135deg, #142d4e, #304661);
        color: #ffffff;
        padding: 28px 32px;
        border-radius: 16px 16px 0 0;
        border-bottom: 4px solid #c9a24d;
    }

        .employee-edit-header h2 {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 25px;
            font-weight: 800;
            margin: 0 0 10px;
        }

            .employee-edit-header h2 i {
                color: #c9a24d;
                font-size: 27px;
            }

        .employee-edit-header p {
            color: #d6dfeb;
            font-size: 14px;
            line-height: 1.9;
            margin: 0;
        }

    /* بطاقة النموذج */

    .employee-edit-body {
        background: #ffffff;
        padding: 30px;
        border: 1px solid #e5eaf2;
        border-radius: 0 0 16px 16px;
        box-shadow: 0 5px 25px rgba(20,45,78,.05);
    }

    /* الرقم الوظيفي */

    .employee-number-box {
        background: #f8f5ec;
        border: 1px solid #eadbb7;
        border-right: 4px solid #c9a24d;
        border-radius: 11px;
        padding: 20px 22px;
        margin-bottom: 30px;
    }

        .employee-number-box label {
            display: block;
            color: #80642e;
            font-size: 14px;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .employee-number-box .form-control {
            width: 100%;
            min-height: 46px;
            padding: 11px 14px;
            background: #ffffff;
            border: 1px solid #e3d7b9;
            border-radius: 11px;
            color: #142d4e;
            font-size: 16px;
            font-weight: 800;
        }

            .employee-number-box .form-control:focus {
                outline: none;
                box-shadow: none;
            }

        .employee-number-box small {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #80642e;
            font-size: 12px;
            line-height: 1.8;
            margin-top: 10px;
        }

    /* أقسام النموذج */

    .employee-edit-section {
        margin-bottom: 30px;
        padding-bottom: 26px;
        border-bottom: 1px solid #e9edf3;
    }

        .employee-edit-section h3 {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 18px;
            font-weight: 800;
            color: #142d4e;
            border-right: 4px solid #c9a24d;
            padding-right: 13px;
            margin-bottom: 23px;
        }

            .employee-edit-section h3 i {
                color: #b9913d;
                font-size: 20px;
            }

    /* شبكة الحقول */

    .employee-edit-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .employee-edit-field {
        min-width: 0;
    }

        .employee-edit-field label {
            display: block;
            color: #142d4e;
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 9px;
        }

        .employee-edit-field .form-control {
            width: 100%;
            min-height: 46px;
            padding: 11px 14px;
            border: 1px solid #dce3ed;
            border-radius: 11px;
            background-color: #ffffff;
            color: #142d4e;
            font-size: 14px;
            font-family: inherit;
            transition: border-color .2s ease, box-shadow .2s ease;
        }

            .employee-edit-field .form-control:focus {
                border-color: #c9a24d;
                box-shadow: 0 0 0 3px rgba(201,162,77,.14);
                outline: none;
            }

    .employee-edit-required {
        color: #b42318;
    }

    /* رسائل التحقق */

    .employee-edit-validation {
        display: block;
        color: #b42318;
        font-size: 13px;
        line-height: 1.7;
        margin-top: 6px;
    }

    .employee-edit-validation-summary {
        background: #fff0ee;
        border: 1px solid #f1d8d5;
        border-radius: 11px;
        padding: 15px 18px;
        margin-bottom: 22px;
        color: #b42318;
        font-size: 14px;
    }

        .employee-edit-validation-summary.validation-summary-valid {
            display: none;
        }

        .employee-edit-validation-summary ul {
            margin: 0;
            padding-right: 20px;
        }

    .employee-edit-field .input-validation-error {
        border-color: #dc756e;
    }

    /* أزرار النموذج */

    .employee-edit-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
    }

    .employee-edit-save,
    .employee-edit-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 45px;
        border-radius: 11px;
        padding: 11px 22px;
        font-size: 14px;
        font-weight: 800;
        font-family: inherit;
        text-decoration: none;
        transition: background-color .2s ease;
    }

    .employee-edit-save {
        background: #c9a24d;
        color: #142d4e;
        border: 1px solid transparent;
        cursor: pointer;
    }

        .employee-edit-save:hover {
            background: #b9913d;
            color: #142d4e;
        }

    .employee-edit-cancel {
        background: #edf1f7;
        color: #142d4e;
        border: 1px solid #dfe6ef;
    }

        .employee-edit-cancel:hover {
            background: #e1e8f2;
            color: #142d4e;
        }

        .employee-edit-save:focus-visible,
        .employee-edit-cancel:focus-visible {
            outline: 3px solid #142d4e;
            outline-offset: 3px;
        }

    /* الشاشات الصغيرة */

    @@media (max-width: 700px) {
        .employee-edit-grid {
            grid-template-columns: 1fr;
        }

        .employee-edit-body {
            padding: 20px;
        }

        .employee-edit-header {
            padding: 22px;
        }

            .employee-edit-header h2 {
                font-size: 21px;
            }

        .employee-edit-actions {
            flex-direction: column;
        }

        .employee-edit-save,
        .employee-edit-cancel {
            width: 100%;
        }
    }
</style>

<div class="employee-edit-page">

    <!-- عنوان الصفحة -->

    <div class="employee-edit-header">

        <h2>
            <i class="bi bi-pencil-square"></i>
            تعديل بيانات الموظف
        </h2>

        <p>
            تحديث المعلومات الشخصية ومعلومات التواصل
            الخاصة بالموظف.
        </p>

    </div>

    <div class="employee-edit-body">

        <!-- نموذج تعديل الموظف -->

        <form asp-controller="Employees"
              asp-action="Edit"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="employee-edit-validation-summary"></div>

            <!-- الرقم الوظيفي للعرض فقط -->

            <div class="employee-number-box">

                <label for="employeeNumberDisplay">
                    الرقم الوظيفي
                </label>

                <input id="employeeNumberDisplay"
                       value="@Model.EmployeeNumber"
                       class="form-control"
                       readonly
                       dir="ltr" />

                <small>
                    <i class="bi bi-lock"></i>
                    لا يمكن تعديل الرقم الوظيفي من هذه الصفحة.
                </small>

            </div>

            <!-- المعلومات الشخصية -->

            <div class="employee-edit-section">

                <h3>
                    <i class="bi bi-person-vcard"></i>
                    المعلومات الشخصية
                </h3>

                <div class="employee-edit-grid">

                    <div class="employee-edit-field">

                        <label asp-for="FirstName">
                            الاسم الأول
                            <span class="employee-edit-required">*</span>
                        </label>

                        <input asp-for="FirstName"
                               class="form-control" />

                        <span asp-validation-for="FirstName"
                              class="employee-edit-validation"></span>

                    </div>

                    <div class="employee-edit-field">

                        <label asp-for="FatherName">
                            اسم الأب
                            <span class="employee-edit-required">*</span>
                        </label>

                        <input asp-for="FatherName"
                               class="form-control" />

                        <span asp-validation-for="FatherName"
                              class="employee-edit-validation"></span>

                    </div>

                    <div class="employee-edit-field">

                        <label asp-for="LastName">
                            الكنية
                            <span class="employee-edit-required">*</span>
                        </label>

                        <input asp-for="LastName"
                               class="form-control" />

                        <span asp-validation-for="LastName"
                              class="employee-edit-validation"></span>

                    </div>

                </div>

            </div>

            <!-- معلومات التواصل -->

            <div class="employee-edit-section">

                <h3>
                    <i class="bi bi-telephone-fill"></i>
                    معلومات التواصل
                </h3>

                <div class="employee-edit-grid">

                    <div class="employee-edit-field">

                        <label asp-for="Phone">
                            رقم الهاتف
                        </label>

                        <input asp-for="Phone"
                               type="tel"
                               class="form-control"
                               dir="ltr" />

                        <span asp-validation-for="Phone"
                              class="employee-edit-validation"></span>

                    </div>

                    <div class="employee-edit-field">

                        <label asp-for="Address">
                            العنوان
                        </label>

                        <input asp-for="Address"
                               class="form-control" />

                        <span asp-validation-for="Address"
                              class="employee-edit-validation"></span>

                    </div>

                </div>

            </div>

            <!-- أزرار الحفظ والإلغاء -->

            <div class="employee-edit-actions">

                <button type="submit"
                        class="employee-edit-save">

                    <i class="bi bi-check-circle"></i>
                    حفظ التعديلات

                </button>

                <a asp-controller="Employees"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="employee-edit-cancel">

                    <i class="bi bi-x-circle"></i>
                    إلغاء

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
