
@model StudentAffairsManagementSystem.Models.Semester

@{
    ViewData["Title"] = "تفاصيل الفصل الدراسي";

    bool isAdmin = User.IsInRole("Admin");
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 style="color:#142d4e; font-weight:800;">
                تفاصيل الفصل الدراسي
            </h2>

            <p class="text-muted mb-0">
                عرض المعلومات المسجلة للفصل الدراسي
            </p>
        </div>

        <a asp-controller="Semesters"
           asp-action="Index"
           class="btn btn-outline-secondary">
            العودة إلى الفصول الدراسية
        </a>

    </div>

    <!-- بطاقة التفاصيل -->
    <div class="card border-0 shadow-sm">

        <div class="card-header py-3"
             style="background:#142d4e; color:white;">

            <h5 class="mb-0">
                معلومات الفصل الدراسي
            </h5>

        </div>

        <div class="card-body p-4">

            <!-- الاسم والحالة -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

                <div>
                    <h3 style="color:#142d4e; font-weight:800;">
                        @Model.Name
                    </h3>

                    <span class="text-muted">
                        العام الدراسي: @Model.AcademicYear
                    </span>
                </div>

                <div>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success px-4 py-2">
                            فصل فعال
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary px-4 py-2">
                            فصل غير فعال
                        </span>
                    }
                </div>

            </div>

            <hr />

            <!-- المعلومات الأساسية -->
            <h5 class="mb-3"
                style="color:#142d4e; font-weight:700;">
                المعلومات الأساسية
            </h5>

            <div class="row g-4 mb-4">

                <div class="col-md-6">
                    <div class="text-muted mb-2">
                        رقم الفصل الدراسي
                    </div>

                    <div class="fw-bold fs-5">
                        @Model.SemesterNumber
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted mb-2">
                        العام الدراسي
                    </div>

                    <div class="fw-bold fs-5">
                        @Model.AcademicYear
                    </div>
                </div>

            </div>

            <hr />

            <!-- التواريخ -->
            <h5 class="mb-3"
                style="color:#142d4e; font-weight:700;">
                مواعيد الفصل الدراسي
            </h5>

            <div class="row g-4 mb-4">

                <div class="col-md-6">

                    <div class="text-muted mb-2">
                        تاريخ بداية الفصل
                    </div>

                    <div class="fw-bold fs-5" dir="ltr"
                         style="text-align:right;">
                        @Model.StartDate.ToString("yyyy/MM/dd")
                    </div>

                </div>

                <div class="col-md-6">

                    <div class="text-muted mb-2">
                        تاريخ نهاية الفصل
                    </div>

                    <div class="fw-bold fs-5" dir="ltr"
                         style="text-align:right;">
                        @Model.EndDate.ToString("yyyy/MM/dd")
                    </div>

                </div>

            </div>

            <hr />

            <!-- حالة الفصل -->
            <h5 class="mb-3"
                style="color:#142d4e; font-weight:700;">
                حالة الفصل الدراسي
            </h5>

            <div class="mb-4">

                @if (Model.IsActive)
                {
                    <div class="alert alert-success mb-0">
                        هذا الفصل مسجل في النظام بحالة فعال.
                    </div>
                }
                else
                {
                    <div class="alert alert-secondary mb-0">
                        هذا الفصل مسجل في النظام بحالة غير فعال.
                    </div>
                }

            </div>

            <!-- الأزرار -->
            <div class="d-flex flex-wrap gap-3 mt-4">

                @if (isAdmin)
                {
                    <a asp-controller="Semesters"
                       asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn px-4 py-2"
                       style="background:#c9a24d; color:#142d4e; font-weight:800;">
                        تعديل الفصل الدراسي
                    </a>

                    <a asp-controller="Semesters"
                       asp-action="Delete"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-danger px-4 py-2">
                        حذف الفصل الدراسي
                    </a>
                }

                <a asp-controller="Semesters"
                   asp-action="Index"
                   class="btn btn-outline-secondary px-4 py-2">
                    رجوع
                </a>

            </div>

        </div>

    </div>

</div>
