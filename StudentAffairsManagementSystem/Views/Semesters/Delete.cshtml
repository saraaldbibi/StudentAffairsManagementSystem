
@model StudentAffairsManagementSystem.Models.Semester

@{
    ViewData["Title"] = "حذف فصل دراسي";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 style="color:#142d4e; font-weight:800;">
                حذف فصل دراسي
            </h2>

            <p class="text-muted mb-0">
                مراجعة بيانات الفصل قبل تأكيد الحذف
            </p>
        </div>

        <a asp-controller="Semesters"
           asp-action="Index"
           class="btn btn-outline-secondary">
            العودة إلى الفصول الدراسية
        </a>

    </div>

    <!-- رسالة التحذير -->
    <div class="alert alert-danger mb-4" role="alert">

        <h5 class="fw-bold mb-2">
            ⚠️ تأكيد حذف الفصل الدراسي
        </h5>

        <p class="mb-2">
            هل أنت متأكد من رغبتك في حذف هذا الفصل الدراسي؟
        </p>

        <p class="mb-0">
            سيتم حذف الفصل نهائيًا من قاعدة البيانات إذا لم يكن
            مرتبطًا بطلاب أو مقررات مطروحة أو أسعار ساعات.
            إذا كان مرتبطًا بهذه البيانات، سيمنع النظام الحذف.
        </p>

    </div>

    <!-- بيانات الفصل -->
    <div class="card border-0 shadow-sm">

        <div class="card-header py-3"
             style="background:#142d4e; color:white;">

            <h5 class="mb-0">
                بيانات الفصل المطلوب حذفه
            </h5>

        </div>

        <div class="card-body p-4">

            <div class="row g-4">

                <!-- رقم الفصل -->
                <div class="col-md-6">

                    <div class="text-muted mb-2">
                        رقم الفصل الدراسي
                    </div>

                    <div class="fw-bold fs-5">
                        @Model.SemesterNumber
                    </div>

                </div>

                <!-- اسم الفصل -->
                <div class="col-md-6">

                    <div class="text-muted mb-2">
                        اسم الفصل الدراسي
                    </div>

                    <div class="fw-bold fs-5">
                        @Model.Name
                    </div>

                </div>

                <!-- العام الدراسي -->
                <div class="col-md-6">

                    <div class="text-muted mb-2">
                        العام الدراسي
                    </div>

                    <div class="fw-bold fs-5">
                        @Model.AcademicYear
                    </div>

                </div>

                <!-- الحالة -->
                <div class="col-md-6">

                    <div class="text-muted mb-2">
                        حالة الفصل
                    </div>

                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success px-3 py-2">
                            فعال
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary px-3 py-2">
                            غير فعال
                        </span>
                    }

                </div>

                <!-- تاريخ البداية -->
                <div class="col-md-6">

                    <div class="text-muted mb-2">
                        تاريخ بداية الفصل
                    </div>

                    <div class="fw-bold fs-5">
                        @Model.StartDate.ToString("yyyy/MM/dd")
                    </div>

                </div>

                <!-- تاريخ النهاية -->
                <div class="col-md-6">

                    <div class="text-muted mb-2">
                        تاريخ نهاية الفصل
                    </div>

                    <div class="fw-bold fs-5">
                        @Model.EndDate.ToString("yyyy/MM/dd")
                    </div>

                </div>

            </div>

            <hr class="my-4" />

            <!-- نموذج تأكيد الحذف -->
            <form asp-controller="Semesters"
                  asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div class="d-flex flex-wrap gap-3">

                    <button type="submit"
                            class="btn btn-danger px-4 py-2">
                        تأكيد حذف الفصل
                    </button>

                    <a asp-controller="Semesters"
                       asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary px-4 py-2">
                        إلغاء والعودة للتفاصيل
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>
