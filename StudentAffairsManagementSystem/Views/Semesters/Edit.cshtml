@model StudentAffairsManagementSystem.Models.Semester

@{
    ViewData["Title"] = "تعديل الفصل الدراسي";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 style="color:#142d4e; font-weight:800;">
                تعديل الفصل الدراسي
            </h2>

            <p class="text-muted mb-0">
                تعديل بيانات الفصل الدراسي والتحكم بفترة تسجيل المقررات
            </p>
        </div>

        <a asp-controller="Semesters"
           asp-action="Index"
           class="btn btn-outline-secondary">
            العودة إلى الفصول الدراسية
        </a>

    </div>

    <!-- نموذج التعديل -->
    <div class="card border-0 shadow-sm">

        <div class="card-header py-3"
             style="background:#142d4e; color:white;">

            <h5 class="mb-0">
                <i class="bi bi-calendar3"></i>
                بيانات الفصل الدراسي
            </h5>

        </div>

        <div class="card-body p-4">

            <form asp-controller="Semesters"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <!-- رسائل التحقق -->
                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <!-- رقم الفصل والاسم -->
                <div class="row g-3 mb-4">

                    <div class="col-md-6">

                        <label asp-for="SemesterNumber"
                               class="form-label fw-bold">
                            رقم الفصل الدراسي
                        </label>

                        <input asp-for="SemesterNumber"
                               type="number"
                               min="1"
                               class="form-control" />

                        <span asp-validation-for="SemesterNumber"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Name"
                               class="form-label fw-bold">
                            اسم الفصل الدراسي
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="اسم الفصل الدراسي" />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>

                    </div>

                </div>

                <!-- العام الدراسي -->
                <div class="mb-4">

                    <label asp-for="AcademicYear"
                           class="form-label fw-bold">
                        العام الدراسي
                    </label>

                    <input asp-for="AcademicYear"
                           class="form-control"
                           dir="ltr"
                           placeholder="مثال: 2026-2027" />

                    <span asp-validation-for="AcademicYear"
                          class="text-danger"></span>

                </div>

                <!-- مواعيد الفصل -->
                <h5 class="mb-3"
                    style="color:#142d4e; font-weight:700;">
                    <i class="bi bi-calendar-range"></i>
                    مواعيد الفصل الدراسي
                </h5>

                <div class="row g-3 mb-4">

                    <div class="col-md-6">

                        <label asp-for="StartDate"
                               class="form-label fw-bold">
                            تاريخ بداية الفصل
                        </label>

                        <input asp-for="StartDate"
                               type="date"
                               asp-format="{0:yyyy-MM-dd}"
                               class="form-control"
                               dir="ltr" />

                        <span asp-validation-for="StartDate"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="EndDate"
                               class="form-label fw-bold">
                            تاريخ نهاية الفصل
                        </label>

                        <input asp-for="EndDate"
                               type="date"
                               asp-format="{0:yyyy-MM-dd}"
                               class="form-control"
                               dir="ltr" />

                        <span asp-validation-for="EndDate"
                              class="text-danger"></span>

                    </div>

                </div>

                <!-- حالة الفصل -->
                <div class="card border mb-4">

                    <div class="card-body">

                        <div class="form-check form-switch">

                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   type="checkbox"
                                   role="switch" />

                            <label asp-for="IsActive"
                                   class="form-check-label fw-bold">
                                الفصل الدراسي فعّال
                            </label>

                        </div>

                        <small class="text-muted d-block mt-2">
                            تفعيل الفصل الدراسي لا يعني فتح تسجيل المقررات.
                            فتح التسجيل يتم بشكل مستقل من القسم التالي.
                        </small>

                    </div>

                </div>

                <!-- ====================================== -->
                <!-- التحكم بفترة تسجيل المقررات -->
                <!-- ====================================== -->

                <div class="card mb-4"
                     style="border:1px solid #d9c397; border-radius:12px; overflow:hidden;">

                    <div class="card-header py-3"
                         style="background:#142d4e; color:white;">

                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-journal-plus"
                               style="color:#c9a24d;"></i>

                            التحكم بفترة تسجيل المقررات
                        </h5>

                    </div>

                    <div class="card-body p-4">

                        <p class="text-muted mb-4">
                            من هنا تحدد إدارة الجامعة المدة التي
                            يُسمح خلالها للطلاب بتسجيل المقررات.
                            خارج هذه المدة، يجب أن يكون التسجيل مغلقًا.
                        </p>

                        <!-- بداية ونهاية التسجيل -->
                        <div class="row g-3 mb-4">

                            <div class="col-md-6">

                                <label asp-for="RegistrationStartDate"
                                       class="form-label fw-bold">
                                    <i class="bi bi-calendar-plus"></i>
                                    بداية فترة التسجيل
                                </label>

                                <input asp-for="RegistrationStartDate"
                                       type="datetime-local"
                                       asp-format="{0:yyyy-MM-ddTHH:mm}"
                                       class="form-control"
                                       dir="ltr" />

                                <span asp-validation-for="RegistrationStartDate"
                                      class="text-danger"></span>

                                <small class="text-muted d-block mt-2">
                                    حدد تاريخ وساعة بدء التسجيل.
                                </small>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="RegistrationEndDate"
                                       class="form-label fw-bold">
                                    <i class="bi bi-calendar-x"></i>
                                    نهاية فترة التسجيل
                                </label>

                                <input asp-for="RegistrationEndDate"
                                       type="datetime-local"
                                       asp-format="{0:yyyy-MM-ddTHH:mm}"
                                       class="form-control"
                                       dir="ltr" />

                                <span asp-validation-for="RegistrationEndDate"
                                      class="text-danger"></span>

                                <small class="text-muted d-block mt-2">
                                    حدد تاريخ وساعة انتهاء التسجيل.
                                </small>

                            </div>

                        </div>

                        <!-- فتح أو إغلاق التسجيل -->
                        <div class="p-3"
                             style="background:#f7f9fc;
                            border:1px solid #e3e8f0;
                            border-radius:10px;">

                            <div class="form-check form-switch">

                                <input asp-for="IsRegistrationOpen"
                                       class="form-check-input"
                                       type="checkbox"
                                       role="switch" />

                                <label asp-for="IsRegistrationOpen"
                                       class="form-check-label fw-bold"
                                       style="color:#142d4e;">
                                    السماح للطلاب بتسجيل المقررات
                                </label>

                            </div>

                            <span asp-validation-for="IsRegistrationOpen"
                                  class="text-danger"></span>

                            <small class="text-muted d-block mt-2">
                                عند تفعيل هذا الخيار، يُسمح بالتسجيل
                                فقط إذا كان الفصل فعّالًا والوقت الحالي
                                ضمن الفترة المحددة، بعد تطبيق التحقق
                                في بوابة الطالب.
                            </small>

                        </div>

                        <!-- ملاحظة -->
                        <div class="alert mt-4 mb-0"
                             style="background:#fff8e8;
                            border:1px solid #ead7a6;
                            color:#775b29;">

                            <i class="bi bi-info-circle"></i>

                            <strong>ملاحظة:</strong>

                            يجب تحديد تاريخ بداية ونهاية التسجيل
                            قبل تفعيل السماح بالتسجيل.

                            يمكن للإدارة إغلاق التسجيل في أي وقت
                            بإلغاء تفعيل الخيار، حتى لو لم تنتهِ
                            الفترة المحددة بعد.

                        </div>

                    </div>

                </div>

                <!-- أزرار الحفظ والإلغاء -->
                <div class="d-flex flex-wrap gap-3 mt-4">

                    <button type="submit"
                            class="btn px-5 py-2"
                            style="background:#c9a24d;
                        color:#142d4e;
                        font-weight:800;">

                        <i class="bi bi-check-circle"></i>
                        حفظ التعديلات

                    </button>

                    <a asp-controller="Semesters"
                       asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary px-4 py-2">

                        إلغاء

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}