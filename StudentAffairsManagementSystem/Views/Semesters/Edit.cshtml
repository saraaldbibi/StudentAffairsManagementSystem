@model StudentAffairsManagementSystem.Models.Semester

@{
    ViewData["Title"] = "تعديل الفصل الدراسي";
}

<style>
    .semester-edit-page {
        direction: rtl;
        max-width: 950px;
        margin: 20px auto;
        color: #142d4e;
    }

    /* رأس الصفحة */

    .semester-edit-header {
        background: linear-gradient(135deg, #142d4e, #304661);
        color: #ffffff;
        padding: 28px 32px;
        border-radius: 16px 16px 0 0;
        border-bottom: 4px solid #c9a24d;
    }

        .semester-edit-header h2 {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 25px;
            font-weight: 800;
            margin: 0 0 10px;
        }

            .semester-edit-header h2 i {
                color: #c9a24d;
                font-size: 27px;
            }

        .semester-edit-header p {
            color: #d6dfeb;
            font-size: 14px;
            line-height: 1.9;
            margin: 0;
        }

    /* جسم الصفحة */

    .semester-edit-body {
        background: #ffffff;
        padding: 30px;
        border: 1px solid #e5eaf2;
        border-top: none;
        border-radius: 0 0 16px 16px;
        box-shadow: 0 5px 25px rgba(20,45,78,.05);
    }

    /* أقسام النموذج */

    .semester-edit-section {
        margin-bottom: 32px;
    }

    .semester-edit-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #142d4e;
        font-size: 18px;
        font-weight: 800;
        border-right: 4px solid #c9a24d;
        padding-right: 13px;
        margin: 0 0 23px;
    }

        .semester-edit-section-title i {
            color: #b9913d;
            font-size: 20px;
        }

    /* شبكة الحقول */

    .semester-edit-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
    }

    .semester-edit-field {
        min-width: 0;
    }

    .semester-edit-field-full {
        grid-column: 1 / -1;
    }

    .semester-edit-label {
        display: block;
        color: #142d4e;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 9px;
    }

    .semester-edit-required {
        color: #b42318;
    }

    .semester-edit-input {
        display: block;
        width: 100%;
        min-height: 46px;
        padding: 11px 14px;
        border: 1px solid #dce3ed;
        border-radius: 11px;
        background: #ffffff;
        color: #142d4e;
        font-size: 14px;
        font-family: inherit;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .semester-edit-input:focus {
            outline: none;
            border-color: #c9a24d;
            box-shadow: 0 0 0 3px rgba(201,162,77,.14);
        }

        .semester-edit-input::placeholder {
            color: #98a4b5;
        }

        .semester-edit-input.input-validation-error {
            border-color: #dc756e;
        }

    /* النصوص الإرشادية */

    .semester-edit-hint {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        color: #718096;
        font-size: 13px;
        line-height: 1.9;
        margin-top: 9px;
    }

        .semester-edit-hint i {
            color: #b9913d;
            margin-top: 2px;
            flex-shrink: 0;
        }

    /* رسائل التحقق */

    .semester-edit-error {
        display: block;
        color: #b42318;
        font-size: 13px;
        line-height: 1.7;
        margin-top: 7px;
    }

    .semester-edit-validation-summary {
        background: #fff0ee;
        border: 1px solid #f1d8d5;
        border-radius: 11px;
        padding: 15px 18px;
        margin-bottom: 25px;
        color: #b42318;
        font-size: 14px;
    }

        .semester-edit-validation-summary.validation-summary-valid {
            display: none;
        }

        .semester-edit-validation-summary ul {
            margin: 0;
            padding-right: 20px;
        }

    /* خيارات التفعيل */

    .semester-edit-option {
        background: #f8fafc;
        border: 1px solid #e5eaf2;
        border-radius: 12px;
        padding: 20px;
    }

    .semester-edit-option-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .semester-edit-checkbox {
        width: 20px;
        height: 20px;
        accent-color: #c9a24d;
        cursor: pointer;
        flex-shrink: 0;
    }

    .semester-edit-option-label {
        color: #142d4e;
        font-size: 15px;
        font-weight: 800;
        cursor: pointer;
    }

    .semester-edit-option p {
        color: #718096;
        font-size: 13px;
        line-height: 1.9;
        margin: 11px 0 0;
    }

    /* بطاقة التسجيل */

    .semester-edit-registration {
        border: 1px solid #e3d4b5;
        border-radius: 13px;
        overflow: hidden;
        margin-bottom: 30px;
    }

    .semester-edit-registration-header {
        background: #f8f4eb;
        padding: 17px 22px;
        border-bottom: 1px solid #e9ddc5;
    }

        .semester-edit-registration-header h3 {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #142d4e;
            font-size: 18px;
            font-weight: 800;
            margin: 0;
        }

        .semester-edit-registration-header i {
            color: #b9913d;
            font-size: 20px;
        }

    .semester-edit-registration-body {
        padding: 23px;
    }

    .semester-edit-registration-description {
        color: #718096;
        font-size: 14px;
        line-height: 1.9;
        margin: 0 0 25px;
    }

    /* ملاحظة التسجيل */

    .semester-edit-note {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        background: #fff9eb;
        border: 1px solid #eadbb5;
        border-right: 4px solid #c9a24d;
        border-radius: 11px;
        padding: 17px 19px;
        margin-top: 23px;
        color: #735b30;
        font-size: 14px;
        line-height: 1.9;
    }

        .semester-edit-note i {
            color: #b9913d;
            font-size: 20px;
            flex-shrink: 0;
        }

    /* أزرار الإجراءات */

    .semester-edit-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 25px;
        border-top: 1px solid #e9edf3;
    }

    .semester-edit-save,
    .semester-edit-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 45px;
        padding: 11px 22px;
        border-radius: 11px;
        font-size: 14px;
        font-weight: 800;
        font-family: inherit;
        text-decoration: none;
        transition: background-color .2s ease;
    }

    .semester-edit-save {
        background: #c9a24d;
        color: #142d4e;
        border: 1px solid transparent;
        cursor: pointer;
    }

        .semester-edit-save:hover {
            background: #b9913d;
            color: #142d4e;
        }

    .semester-edit-cancel {
        background: #edf1f7;
        color: #142d4e;
        border: 1px solid #dfe6ef;
    }

        .semester-edit-cancel:hover {
            background: #e1e8f2;
            color: #142d4e;
        }

        .semester-edit-save:focus-visible,
        .semester-edit-cancel:focus-visible {
            outline: 3px solid #142d4e;
            outline-offset: 3px;
        }

    /* الشاشات الصغيرة */

    @@media (max-width: 650px) {
        .semester-edit-page {
            margin: 15px auto;
        }

        .semester-edit-header,
        .semester-edit-body {
            padding: 22px;
        }

            .semester-edit-header h2 {
                font-size: 21px;
            }

        .semester-edit-grid {
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .semester-edit-field-full {
            grid-column: auto;
        }

        .semester-edit-registration-header,
        .semester-edit-registration-body {
            padding: 18px;
        }

        .semester-edit-actions {
            flex-direction: column;
        }

        .semester-edit-save,
        .semester-edit-cancel {
            width: 100%;
        }
    }
</style>

<div class="semester-edit-page">

    <!-- رأس الصفحة -->

    <div class="semester-edit-header">

        <h2>
            <i class="bi bi-pencil-square"></i>
            تعديل الفصل الدراسي
        </h2>

        <p>
            تحديث بيانات الفصل الدراسي
            والتحكم بمواعيد تسجيل المقررات وحالة التسجيل.
        </p>

    </div>

    <!-- نموذج التعديل -->

    <div class="semester-edit-body">

        <form asp-controller="Semesters"
              asp-action="Edit"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <!-- معرّف الفصل -->

            <input asp-for="Id"
                   type="hidden" />

            <!-- رسائل التحقق -->

            <div asp-validation-summary="All"
                 class="semester-edit-validation-summary"></div>

            <!-- البيانات الأساسية -->

            <section class="semester-edit-section">

                <h3 class="semester-edit-section-title">
                    <i class="bi bi-calendar3"></i>
                    البيانات الأساسية للفصل
                </h3>

                <div class="semester-edit-grid">

                    <!-- رقم الفصل -->

                    <div class="semester-edit-field">

                        <label asp-for="SemesterNumber"
                               class="semester-edit-label">

                            رقم الفصل الدراسي
                            <span class="semester-edit-required">*</span>

                        </label>

                        <input asp-for="SemesterNumber"
                               type="number"
                               min="1"
                               step="1"
                               class="semester-edit-input"
                               required />

                        <span asp-validation-for="SemesterNumber"
                              class="semester-edit-error"></span>

                    </div>

                    <!-- اسم الفصل -->

                    <div class="semester-edit-field">

                        <label asp-for="Name"
                               class="semester-edit-label">

                            اسم الفصل الدراسي
                            <span class="semester-edit-required">*</span>

                        </label>

                        <input asp-for="Name"
                               class="semester-edit-input"
                               placeholder="اسم الفصل الدراسي"
                               required />

                        <span asp-validation-for="Name"
                              class="semester-edit-error"></span>

                    </div>

                    <!-- العام الأكاديمي -->

                    <div class="semester-edit-field semester-edit-field-full">

                        <label asp-for="AcademicYear"
                               class="semester-edit-label">

                            العام الدراسي
                            <span class="semester-edit-required">*</span>

                        </label>

                        <input asp-for="AcademicYear"
                               class="semester-edit-input"
                               placeholder="مثال: 2026-2027"
                               dir="ltr"
                               required />

                        <span asp-validation-for="AcademicYear"
                              class="semester-edit-error"></span>

                    </div>

                </div>

            </section>

            <!-- مواعيد الفصل -->

            <section class="semester-edit-section">

                <h3 class="semester-edit-section-title">
                    <i class="bi bi-calendar-range"></i>
                    مواعيد الفصل الدراسي
                </h3>

                <div class="semester-edit-grid">

                    <!-- بداية الفصل -->

                    <div class="semester-edit-field">

                        <label asp-for="StartDate"
                               class="semester-edit-label">

                            تاريخ بداية الفصل
                            <span class="semester-edit-required">*</span>

                        </label>

                        <input asp-for="StartDate"
                               type="date"
                               asp-format="{0:yyyy-MM-dd}"
                               class="semester-edit-input"
                               dir="ltr"
                               required />

                        <span asp-validation-for="StartDate"
                              class="semester-edit-error"></span>

                    </div>

                    <!-- نهاية الفصل -->

                    <div class="semester-edit-field">

                        <label asp-for="EndDate"
                               class="semester-edit-label">

                            تاريخ نهاية الفصل
                            <span class="semester-edit-required">*</span>

                        </label>

                        <input asp-for="EndDate"
                               type="date"
                               asp-format="{0:yyyy-MM-dd}"
                               class="semester-edit-input"
                               dir="ltr"
                               required />

                        <span asp-validation-for="EndDate"
                              class="semester-edit-error"></span>

                    </div>

                </div>

            </section>

            <!-- حالة الفصل -->

            <section class="semester-edit-section">

                <h3 class="semester-edit-section-title">
                    <i class="bi bi-sliders"></i>
                    حالة الفصل الدراسي
                </h3>

                <div class="semester-edit-option">

                    <div class="semester-edit-option-row">

                        <input asp-for="IsActive"
                               type="checkbox"
                               class="semester-edit-checkbox" />

                        <label asp-for="IsActive"
                               class="semester-edit-option-label">

                            الفصل الدراسي فعّال

                        </label>

                    </div>

                    <p>
                        تفعيل الفصل الدراسي لا يعني فتح
                        تسجيل المقررات تلقائيًا.
                        يتم التحكم بالتسجيل بشكل مستقل.
                    </p>

                </div>

            </section>

            <!-- التحكم بفترة التسجيل -->

            <div class="semester-edit-registration">

                <div class="semester-edit-registration-header">

                    <h3>
                        <i class="bi bi-journal-plus"></i>
                        التحكم بفترة تسجيل المقررات
                    </h3>

                </div>

                <div class="semester-edit-registration-body">

                    <p class="semester-edit-registration-description">
                        من هنا تحدد إدارة الجامعة الفترة
                        المسموح خلالها بتسجيل المقررات.
                        خارج هذه الفترة يجب أن يكون التسجيل مغلقًا
                        وفق قواعد النظام.
                    </p>

                    <!-- مواعيد التسجيل -->

                    <div class="semester-edit-grid">

                        <!-- بداية التسجيل -->

                        <div class="semester-edit-field">

                            <label asp-for="RegistrationStartDate"
                                   class="semester-edit-label">

                                <i class="bi bi-calendar-plus"></i>
                                بداية فترة التسجيل

                            </label>

                            <input asp-for="RegistrationStartDate"
                                   type="datetime-local"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   class="semester-edit-input"
                                   dir="ltr" />

                            <span asp-validation-for="RegistrationStartDate"
                                  class="semester-edit-error"></span>

                            <div class="semester-edit-hint">

                                <i class="bi bi-info-circle"></i>

                                <span>
                                    حدد تاريخ وساعة بدء التسجيل.
                                </span>

                            </div>

                        </div>

                        <!-- نهاية التسجيل -->

                        <div class="semester-edit-field">

                            <label asp-for="RegistrationEndDate"
                                   class="semester-edit-label">

                                <i class="bi bi-calendar-x"></i>
                                نهاية فترة التسجيل

                            </label>

                            <input asp-for="RegistrationEndDate"
                                   type="datetime-local"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   class="semester-edit-input"
                                   dir="ltr" />

                            <span asp-validation-for="RegistrationEndDate"
                                  class="semester-edit-error"></span>

                            <div class="semester-edit-hint">

                                <i class="bi bi-info-circle"></i>

                                <span>
                                    حدد تاريخ وساعة انتهاء التسجيل.
                                </span>

                            </div>

                        </div>

                    </div>

                    <!-- السماح بالتسجيل -->

                    <div class="semester-edit-option"
                         style="margin-top:24px;">

                        <div class="semester-edit-option-row">

                            <input asp-for="IsRegistrationOpen"
                                   type="checkbox"
                                   class="semester-edit-checkbox" />

                            <label asp-for="IsRegistrationOpen"
                                   class="semester-edit-option-label">

                                السماح للطلاب بتسجيل المقررات

                            </label>

                        </div>

                        <span asp-validation-for="IsRegistrationOpen"
                              class="semester-edit-error"></span>

                        <p>
                            عند تفعيل هذا الخيار، يُسمح
                            بالتسجيل فقط إذا كان الفصل فعّالًا
                            والوقت الحالي ضمن الفترة المحددة،
                            وبعد تطبيق التحقق في بوابة الطالب.
                        </p>

                    </div>

                    <!-- ملاحظة -->

                    <div class="semester-edit-note">

                        <i class="bi bi-info-circle"></i>

                        <span>
                            يجب تحديد تاريخ بداية ونهاية التسجيل
                            قبل تفعيل السماح بالتسجيل.

                            يمكن للإدارة إغلاق التسجيل في أي وقت
                            بإلغاء تفعيل الخيار، حتى لو لم تنتهِ
                            الفترة المحددة.
                        </span>

                    </div>

                </div>

            </div>

            <!-- أزرار الإجراءات -->

            <div class="semester-edit-actions">

                <button type="submit"
                        class="semester-edit-save">

                    <i class="bi bi-check-circle"></i>
                    حفظ التعديلات

                </button>

                <a asp-controller="Semesters"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="semester-edit-cancel">

                    <i class="bi bi-x-circle"></i>
                    إلغاء والعودة

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
