@using StudentAffairsManagementSystem.Models

@{
    ViewData["Title"] = "الرسوم الجامعية";

    var student = ViewBag.Student as Student;

    var activeSemester = ViewBag.ActiveSemester as Semester;

    var registrations =
        ViewBag.Registrations as List<Registration>
        ?? new List<Registration>();

    decimal? pricePerHour = ViewBag.PricePerHour == null
        ? null
        : (decimal?)ViewBag.PricePerHour;

    decimal? estimatedFees = ViewBag.EstimatedFees == null
        ? null
        : (decimal?)ViewBag.EstimatedFees;

    int totalHours = registrations.Sum(r =>
        r.CourseOffering.Course.CreditHours);

    string studentName = student == null
        ? "الطالب"
        : $"{student.FirstName} {student.FatherName} {student.LastName}";
}

<style>
    .fees-page {
        direction: rtl;
        color: #142d4e;
    }

    /* عنوان الصفحة */

    .fees-header {
        background: #142d4e;
        color: #ffffff;
        border-radius: 15px;
        border-bottom: 4px solid #c9a24d;
        padding: 30px;
        margin-bottom: 25px;
        box-shadow: 0 4px 14px rgba(20,45,78,.08);
    }

        .fees-header h2 {
            font-size: 25px;
            font-weight: 800;
            margin-bottom: 10px;
        }

            .fees-header h2 i {
                color: #c9a24d;
                margin-left: 8px;
            }

        .fees-header p {
            color: #d5dfeb;
            margin-bottom: 0;
            line-height: 1.9;
        }

    /* بيانات الطالب والفصل */

    .fees-student {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 20px;
    }

        .fees-student span {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: 1px solid rgba(201,162,77,.4);
            background: rgba(201,162,77,.13);
            color: #f2d9a8;
            padding: 9px 15px;
            border-radius: 11px;
            font-size: 13px;
            font-weight: 700;
        }

    /* عناوين الأقسام */

    .fees-title {
        font-size: 19px;
        font-weight: 800;
        color: #142d4e;
        border-right: 4px solid #c9a24d;
        padding-right: 12px;
        margin: 28px 0 17px;
    }

        .fees-title i {
            color: #c9a24d;
            margin-left: 7px;
        }

    /* بطاقات الملخص */

    .fees-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
    }

    .fees-card {
        background: #ffffff;
        border: 1px solid #e5eaf2;
        border-radius: 15px;
        padding: 22px;
        box-shadow: 0 3px 12px rgba(20,45,78,.04);
    }

    .fees-icon {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #f8f5ec;
        color: #c9a24d;
        font-size: 23px;
        margin-bottom: 14px;
    }

    .fees-label {
        font-size: 14px;
        color: #718096;
        margin-bottom: 10px;
    }

    .fees-value {
        font-size: 25px;
        font-weight: 800;
        color: #142d4e;
        overflow-wrap: anywhere;
    }

    /* بطاقة الإجمالي */

    .fees-card-highlight {
        border-top: 4px solid #c9a24d;
    }

        .fees-card-highlight .fees-value {
            color: #a17b3f;
        }

    /* جدول الرسوم */

    .fees-table-wrapper {
        background: #ffffff;
        border: 1px solid #e5eaf2;
        border-radius: 15px;
        overflow-x: auto;
        box-shadow: 0 3px 12px rgba(20,45,78,.04);
    }

    .fees-table {
        width: 100%;
        min-width: 650px;
        border-collapse: collapse;
        text-align: right;
    }

        .fees-table th {
            background: #142d4e;
            color: #ffffff;
            padding: 16px;
            font-size: 14px;
            font-weight: 800;
            white-space: nowrap;
        }

        .fees-table td {
            padding: 16px;
            border-bottom: 1px solid #edf0f5;
            vertical-align: middle;
            color: #142d4e;
        }

        .fees-table tbody tr:nth-child(even) {
            background: #f8f9fb;
        }

        .fees-table tbody tr:hover {
            background: #f1f4f8;
        }

        .fees-table tbody tr:last-child td {
            border-bottom: none;
        }

        .fees-table tfoot td {
            background: #f8f9fc;
            font-weight: 800;
            border-top: 2px solid #e5eaf2;
        }

    /* حالة عدم وجود بيانات */

    .fees-empty {
        text-align: center;
        padding: 40px 20px;
        color: #718096;
    }

        .fees-empty i {
            display: block;
            font-size: 38px;
            color: #c9a24d;
            margin-bottom: 12px;
        }

        .fees-empty h4 {
            color: #142d4e;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .fees-empty p {
            line-height: 1.9;
            margin-bottom: 0;
        }

    /* ملاحظة الرسوم */

    .fees-note {
        background: #fff9ec;
        color: #755a2d;
        border: 1px solid #efdfbb;
        border-radius: 11px;
        padding: 18px;
        margin-top: 22px;
        line-height: 1.9;
    }

        .fees-note i {
            color: #b9913d;
            margin-left: 6px;
        }

    /* أزرار التنقل الموحدة */

    .fees-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 22px;
    }

    .fees-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 43px;
        padding: 9px 18px;
        border: 1px solid transparent;
        border-radius: 11px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        background: #c9a24d;
        color: #142d4e;
        transition: background-color .2s ease, transform .2s ease;
    }

        .fees-button i {
            font-size: 16px;
        }

        .fees-button:hover {
            background: #b9913d;
            color: #142d4e;
            transform: translateY(-1px);
        }

        .fees-button:focus-visible {
            outline: 3px solid #142d4e;
            outline-offset: 3px;
        }

    /* زر العودة */

    .fees-button-secondary {
        background: #eef2f8;
        color: #142d4e;
    }

        .fees-button-secondary:hover {
            background: #dfe7f2;
            color: #142d4e;
        }

    /* الشاشات الصغيرة */

    @@media (max-width: 750px) {
        .fees-grid {
            grid-template-columns: 1fr;
        }

        .fees-header {
            padding: 22px;
        }

            .fees-header h2 {
                font-size: 23px;
            }

        .fees-card {
            padding: 18px;
        }

        .fees-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .fees-button {
            width: 100%;
        }
    }
</style>

<div class="fees-page">

    <!-- عنوان الصفحة -->

    <div class="fees-header">

        <h2>
            <i class="bi bi-wallet2"></i>
            الرسوم الجامعية
        </h2>

        <p>
            تفاصيل الرسوم الدراسية التقديرية
            بناءً على مقرراتك المسجلة في الفصل الحالي.
        </p>

        <div class="fees-student">

            <span>
                <i class="bi bi-person"></i>
                @studentName
            </span>

            @if (student != null)
            {
                <span>
                    <i class="bi bi-person-badge"></i>
                    @student.UniversityNumber
                </span>
            }

            @if (activeSemester != null)
            {
                <span>
                    <i class="bi bi-calendar3"></i>
                    @activeSemester.Name
                    - @activeSemester.AcademicYear
                </span>
            }

        </div>

    </div>

    @if (activeSemester == null)
    {
        <!-- لا يوجد فصل فعال -->

        <div class="fees-empty fees-card">

            <i class="bi bi-calendar-x"></i>

            <h4>لا يوجد فصل دراسي فعّال حاليًا</h4>

            <p>
                لا يمكن عرض رسوم الفصل الحالي
                حتى يتم تفعيل فصل دراسي.
            </p>

        </div>
    }
    else
    {
        <!-- ملخص الرسوم الدراسية -->

        <h3 class="fees-title">
            <i class="bi bi-graph-up"></i>
            ملخص الرسوم الدراسية
        </h3>

        <div class="fees-grid">

            <!-- عدد المقررات -->

            <div class="fees-card">

                <div class="fees-icon">
                    <i class="bi bi-book"></i>
                </div>

                <div class="fees-label">
                    المقررات المسجلة
                </div>

                <div class="fees-value">
                    @registrations.Count
                </div>

            </div>

            <!-- مجموع الساعات -->

            <div class="fees-card">

                <div class="fees-icon">
                    <i class="bi bi-clock-history"></i>
                </div>

                <div class="fees-label">
                    مجموع الساعات المعتمدة
                </div>

                <div class="fees-value">
                    @totalHours
                </div>

            </div>

            <!-- سعر الساعة -->

            <div class="fees-card">

                <div class="fees-icon">
                    <i class="bi bi-cash-coin"></i>
                </div>

                <div class="fees-label">
                    سعر الساعة المعتمدة
                </div>

                <div class="fees-value">
                    @(pricePerHour.HasValue
                        ? pricePerHour.Value.ToString("N2")
                        : "غير محدد")
                </div>

            </div>

        </div>

        <!-- تفاصيل رسوم المقررات -->

        <h3 class="fees-title">
            <i class="bi bi-receipt"></i>
            تفاصيل رسوم المقررات
        </h3>

        <div class="fees-table-wrapper">

            @if (!registrations.Any())
            {
                <div class="fees-empty">

                    <i class="bi bi-journal-x"></i>

                    <h4>لا توجد مقررات مسجلة</h4>

                    <p>
                        لم تسجل أي مقرر في الفصل الحالي،
                        لذلك لا توجد رسوم مقررات
                        محتسبة حتى الآن.
                    </p>

                </div>
            }
            else
            {
                <table class="fees-table">

                    <thead>
                        <tr>
                            <th>المقرر</th>
                            <th>عدد الساعات</th>
                            <th>سعر الساعة</th>
                            <th>رسوم المقرر</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var registration in registrations)
                        {
                            int courseHours =
                                registration.CourseOffering.Course.CreditHours;

                            decimal? courseFee = pricePerHour.HasValue
                                ? courseHours * pricePerHour.Value
                                : null;

                            <tr>

                                <!-- اسم المقرر -->

                                <td>
                                    @registration.CourseOffering.Course.Name
                                </td>

                                <!-- عدد الساعات -->

                                <td>
                                    @courseHours
                                </td>

                                <!-- سعر الساعة -->

                                <td>
                                    @(pricePerHour.HasValue
                                        ? pricePerHour.Value.ToString("N2")
                                        : "غير محدد")
                                </td>

                                <!-- رسوم المقرر -->

                                <td>
                                    @(courseFee.HasValue
                                        ? courseFee.Value.ToString("N2")
                                        : "غير متوفر")
                                </td>

                            </tr>
                        }

                    </tbody>

                    <!-- إجمالي الرسوم -->

                    <tfoot>
                        <tr>

                            <td>الإجمالي</td>

                            <td>@totalHours ساعة</td>

                            <td>—</td>

                            <td>
                                @(estimatedFees.HasValue
                                    ? estimatedFees.Value.ToString("N2")
                                    : "غير متوفر")
                            </td>

                        </tr>
                    </tfoot>

                </table>
            }

        </div>

        <!-- إجمالي الرسوم التقديرية -->

        <h3 class="fees-title">
            <i class="bi bi-calculator"></i>
            إجمالي الرسوم التقديرية
        </h3>

        <div class="fees-card fees-card-highlight">

            <div class="fees-label">
                إجمالي رسوم المقررات المسجلة
                في الفصل الحالي
            </div>

            <div class="fees-value">
                @(estimatedFees.HasValue
                    ? estimatedFees.Value.ToString("N2")
                    : "غير متوفر")
            </div>

            <p class="text-muted mt-3 mb-0">
                يتم الحساب بضرب مجموع الساعات
                المعتمدة في سعر الساعة المحدد لقسمك
                والفصل الدراسي الحالي.
            </p>

        </div>

        <!-- التنبيه المالي -->

        <div class="fees-note">

            <i class="bi bi-info-circle"></i>

            <strong>تنبيه مهم:</strong>

            هذه الرسوم تقديرية وتعتمد على المقررات
            المسجلة حاليًا وسعر الساعة المعتمد.

            لا تشمل هذه الصفحة المبالغ المدفوعة
            أو الرصيد المتبقي، لأن نظام تسجيل الدفعات
            لم يُضف إلى قاعدة البيانات بعد.

            إذا لم يكن سعر الساعة محددًا،
            فستظهر الرسوم على أنها غير متوفرة،
            بدل عرض مبلغ غير صحيح.

        </div>

        <!-- أزرار التنقل -->

        <div class="fees-actions">

            <a asp-controller="StudentDashboard"
               asp-action="Courses"
               class="fees-button">

                <i class="bi bi-journal-plus"></i>
                تسجيل المقررات

            </a>

            <a asp-controller="StudentDashboard"
               asp-action="Index"
               class="fees-button fees-button-secondary">

                <i class="bi bi-arrow-right"></i>
                العودة إلى بوابة الطالب

            </a>

        </div>
    }

</div>
