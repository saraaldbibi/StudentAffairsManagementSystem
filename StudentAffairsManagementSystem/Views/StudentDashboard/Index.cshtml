@model StudentAffairsManagementSystem.Models.Student

@using StudentAffairsManagementSystem.Models

@{
    ViewData["Title"] = "بوابة الطالب";

    var activeSemester = ViewBag.ActiveSemester as Semester;

    var registrations =
        ViewBag.CurrentRegistrations as List<Registration>
        ?? new List<Registration>();

    int creditHours = ViewBag.CurrentCreditHours ?? 0;

    decimal? pricePerHour = ViewBag.PricePerHour;

    decimal? estimatedFees = ViewBag.EstimatedFees;

    string fullName =
        $"{Model.FirstName} {Model.FatherName} {Model.LastName}";
}

<style>
    .student-portal {
        direction: rtl;
        color: #142d4e;
        padding: 20px 0;
    }

    /* بطاقة الترحيب */

    .portal-header {
        background: #142d4e;
        color: #ffffff;
        padding: 30px;
        border-radius: 15px;
        border-bottom: 4px solid #c9a24d;
        margin-bottom: 25px;
        box-shadow: 0 4px 14px rgba(20,45,78,.08);
    }

        .portal-header h2 {
            font-size: 27px;
            font-weight: 800;
            margin-bottom: 10px;
        }

            .portal-header h2 i {
                color: #c9a24d;
                margin-left: 8px;
            }

        .portal-header p {
            color: #d8dfeb;
            margin: 0;
            line-height: 1.9;
        }

    .portal-number {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(201,162,77,.16);
        color: #e8c98d;
        padding: 9px 15px;
        border-radius: 11px;
        margin-top: 15px;
        direction: ltr;
        font-weight: 700;
    }

    /* عناوين الأقسام */

    .portal-section-title {
        font-size: 19px;
        font-weight: 800;
        margin: 28px 0 17px;
        border-right: 4px solid #c9a24d;
        padding-right: 12px;
        color: #142d4e;
    }

        .portal-section-title i {
            color: #c9a24d;
            margin-left: 7px;
        }

    /* بطاقات الإحصائيات */

    .portal-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
    }

    .portal-card {
        background: #ffffff;
        border: 1px solid #e5eaf0;
        border-radius: 15px;
        padding: 22px;
        box-shadow: 0 3px 12px rgba(20,45,78,.04);
    }

    .portal-card-label {
        color: #718096;
        font-size: 13px;
        margin-bottom: 10px;
    }

    .portal-card-value {
        font-size: 23px;
        font-weight: 800;
        color: #142d4e;
    }

    .portal-card-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 46px;
        height: 46px;
        background: #f8f5ec;
        color: #c9a24d;
        border-radius: 11px;
        font-size: 23px;
        margin-bottom: 14px;
    }

    /* المعلومات الشخصية */

    .portal-info {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 15px;
    }

    .portal-info-item {
        background: #f8f9fc;
        border: 1px solid #edf0f5;
        padding: 16px;
        border-radius: 11px;
    }

        .portal-info-item small {
            color: #718096;
            display: block;
            margin-bottom: 8px;
            font-size: 13px;
        }

        .portal-info-item strong {
            color: #142d4e;
            font-size: 15px;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

    /* جدول المقررات */

    .portal-table-card {
        background: #ffffff;
        border: 1px solid #e5eaf0;
        border-radius: 15px;
        overflow: hidden;
        margin-top: 15px;
        box-shadow: 0 3px 12px rgba(20,45,78,.04);
    }

    .portal-table-wrapper {
        overflow-x: auto;
    }

    .portal-table {
        width: 100%;
        min-width: 650px;
        border-collapse: collapse;
        text-align: right;
    }

        .portal-table th {
            background: #142d4e;
            color: #ffffff;
            padding: 16px;
            font-size: 14px;
            font-weight: 800;
            white-space: nowrap;
        }

        .portal-table td {
            padding: 16px;
            border-bottom: 1px solid #edf0f5;
            color: #142d4e;
            vertical-align: middle;
        }

        .portal-table tbody tr:nth-child(even) {
            background: #f8f9fb;
        }

        .portal-table tbody tr:hover {
            background: #f1f4f8;
        }

        .portal-table tbody tr:last-child td {
            border-bottom: none;
        }

    .portal-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #e8f5ee;
        color: #176a42;
        border-radius: 8px;
        padding: 7px 12px;
        font-size: 13px;
        font-weight: 700;
    }

    /* الحالة الفارغة */

    .portal-empty {
        text-align: center;
        padding: 35px 15px;
        color: #718096;
    }

        .portal-empty i {
            display: block;
            font-size: 35px;
            color: #c9a24d;
            margin-bottom: 12px;
        }

        .portal-empty p {
            margin-bottom: 0;
        }

    /* الرسوم الدراسية */

    .portal-fees {
        border-right: 4px solid #c9a24d;
    }

    .portal-note {
        background: #fff9ed;
        color: #765b2c;
        border: 1px solid #efdfbd;
        border-radius: 11px;
        padding: 16px;
        margin-top: 18px;
        font-size: 14px;
        line-height: 1.9;
    }

        .portal-note i {
            color: #b9913d;
            margin-left: 6px;
        }

    /* الشاشات الصغيرة */

    @@media (max-width: 750px) {
        .portal-grid {
            grid-template-columns: 1fr;
        }

        .portal-info {
            grid-template-columns: 1fr;
        }

        .portal-header {
            padding: 22px;
        }

            .portal-header h2 {
                font-size: 23px;
            }

        .portal-card {
            padding: 18px;
        }

        .portal-table-wrapper {
            overflow-x: auto;
        }
    }
</style>

<div class="student-portal">

    <!-- الترحيب بالطالب -->

    <div class="portal-header">

        <h2>
            <i class="bi bi-mortarboard-fill"></i>
            أهلاً بك، @fullName
        </h2>

        <p>
            مرحباً بك في بوابة الطالب الإلكترونية
            للجامعة الدولية للعلوم والنهضة
        </p>

        <div class="portal-number">
            <i class="bi bi-person-badge"></i>
            @Model.UniversityNumber
        </div>

    </div>

    <!-- ملخص الفصل الدراسي -->

    <h3 class="portal-section-title">
        <i class="bi bi-bar-chart"></i>
        ملخص الفصل الدراسي
    </h3>

    <div class="portal-grid">

        <!-- المقررات المسجلة -->

        <div class="portal-card">

            <div class="portal-card-icon">
                <i class="bi bi-book"></i>
            </div>

            <div class="portal-card-label">
                المقررات المسجلة
            </div>

            <div class="portal-card-value">
                @registrations.Count
            </div>

        </div>

        <!-- مجموع الساعات -->

        <div class="portal-card">

            <div class="portal-card-icon">
                <i class="bi bi-clock"></i>
            </div>

            <div class="portal-card-label">
                مجموع الساعات
            </div>

            <div class="portal-card-value">
                @creditHours
            </div>

        </div>

        <!-- الفصل الفعال -->

        <div class="portal-card">

            <div class="portal-card-icon">
                <i class="bi bi-calendar-check"></i>
            </div>

            <div class="portal-card-label">
                الفصل الفعّال
            </div>

            <div class="portal-card-value"
                 style="font-size:17px;">
                @(activeSemester?.Name ?? "لا يوجد فصل فعال")
            </div>

        </div>

    </div>

    <!-- المعلومات الشخصية -->

    <h3 class="portal-section-title">
        <i class="bi bi-person-vcard"></i>
        معلوماتي الشخصية
    </h3>

    <div class="portal-card">

        <div class="portal-info">

            <div class="portal-info-item">
                <small>الاسم الكامل</small>
                <strong>@fullName</strong>
            </div>

            <div class="portal-info-item">
                <small>الرقم الجامعي</small>
                <strong>@Model.UniversityNumber</strong>
            </div>

            <div class="portal-info-item">
                <small>القسم</small>
                <strong>
                    @(Model.Department?.Name ?? "غير محدد")
                </strong>
            </div>

            <div class="portal-info-item">
                <small>فصل القبول</small>
                <strong>
                    @(Model.AdmissionSemester?.Name ?? "غير محدد")
                </strong>
            </div>

            <div class="portal-info-item">
                <small>رقم الهاتف</small>
                <strong>@Model.Phone</strong>
            </div>

            <div class="portal-info-item">
                <small>الحالة الدراسية</small>
                <strong>@Model.Status</strong>
            </div>

            <div class="portal-info-item">
                <small>الجنسية</small>
                <strong>@Model.Nationality</strong>
            </div>

            <div class="portal-info-item">
                <small>المحافظة</small>
                <strong>@Model.Governorate</strong>
            </div>

        </div>

    </div>

    <!-- المقررات المسجلة -->

    <h3 class="portal-section-title">
        <i class="bi bi-journal-bookmark"></i>
        مقرراتي في الفصل الحالي
    </h3>

    <div class="portal-table-card">

        @if (activeSemester == null)
        {
            <div class="portal-empty">
                <i class="bi bi-calendar-x"></i>
                لا يوجد فصل دراسي فعّال حالياً.
            </div>
        }
        else if (!registrations.Any())
        {
            <div class="portal-empty">

                <i class="bi bi-journal-x"></i>

                <p>
                    لم يتم تسجيل أي مقرر في الفصل الحالي.
                </p>

            </div>
        }
        else
        {
            <div class="portal-table-wrapper">

                <table class="portal-table">

                    <thead>
                        <tr>
                            <th>المقرر</th>
                            <th>عدد الساعات</th>
                            <th>الفصل الدراسي</th>
                            <th>حالة التسجيل</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var registration in registrations)
                        {
                            <tr>

                                <td>
                                    @registration.CourseOffering.Course.Name
                                </td>

                                <td>
                                    @registration.CourseOffering.Course.CreditHours
                                </td>

                                <td>
                                    @registration.CourseOffering.Semester.Name
                                </td>

                                <td>
                                    <span class="portal-status">
                                        <i class="bi bi-check-circle"></i>
                                        مسجل
                                    </span>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

    <!-- الرسوم الدراسية -->

    <h3 class="portal-section-title">
        <i class="bi bi-wallet2"></i>
        الرسوم الدراسية التقديرية
    </h3>

    <div class="portal-card portal-fees">

        <div class="portal-info">

            <!-- سعر الساعة -->

            <div class="portal-info-item">

                <small>
                    سعر الساعة المعتمدة
                </small>

                <strong>
                    @(pricePerHour.HasValue
                        ? pricePerHour.Value.ToString("N2") + " "
                        : "غير محدد")
                </strong>

            </div>

            <!-- إجمالي الرسوم -->

            <div class="portal-info-item">

                <small>
                    إجمالي الرسوم التقديرية
                </small>

                <strong>
                    @(estimatedFees.HasValue
                        ? estimatedFees.Value.ToString("N2")
                        : "غير متوفر")
                </strong>

            </div>

        </div>

        <!-- ملاحظة الرسوم -->

        <div class="portal-note">

            <i class="bi bi-info-circle"></i>

            المبلغ المعروض تقديري، ويُحسب بناءً على
            عدد الساعات المسجلة وسعر الساعة في القسم
            والفصل الدراسي الفعّال. لا يمثل هذا المبلغ
            رصيداً مدفوعاً أو متبقياً.

        </div>

    </div>

</div>
