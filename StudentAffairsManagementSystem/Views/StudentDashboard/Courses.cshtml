@model List<StudentAffairsManagementSystem.Models.CourseOffering>

@using StudentAffairsManagementSystem.Models

@{
    ViewData["Title"] = "تسجيل المقررات";

    var activeSemester = ViewBag.ActiveSemester as Semester;

    bool isRegistrationOpen =
        ViewBag.IsRegistrationOpen is bool value && value;

    string registrationMessage =
        ViewBag.RegistrationMessage as string
        ?? "التسجيل غير متاح حاليًا.";

    var registeredOfferingIds =
        ViewBag.RegisteredOfferingIds as List<long>
        ?? new List<long>();

    var registeredCourseIds =
        ViewBag.RegisteredCourseIds as List<long>
        ?? new List<long>();

    var registeredCounts =
        ViewBag.RegisteredCounts as Dictionary<long, int>
        ?? new Dictionary<long, int>();

    int registeredCoursesCount = Model.Count(o =>
        registeredOfferingIds.Contains(o.Id));

    int availableCoursesCount = Model
        .Where(o =>
            !registeredCourseIds.Contains(o.CourseId) &&
            registeredCounts.GetValueOrDefault(o.Id) < o.Capacity)
        .Select(o => o.CourseId)
        .Distinct()
        .Count();
}

<style>
    .student-courses {
        direction: rtl;
        color: #142d4e;
    }

    .student-courses-header {
        background: #142d4e;
        color: white;
        border-radius: 16px;
        padding: 28px;
        border-bottom: 4px solid #c9a24d;
        margin-bottom: 24px;
    }

        .student-courses-header h2 {
            font-weight: 800;
            font-size: 25px;
            margin-bottom: 10px;
        }

        .student-courses-header p {
            color: #d8e0ea;
            margin-bottom: 0;
        }

    .student-semester {
        display: inline-block;
        margin-top: 16px;
        padding: 9px 15px;
        border-radius: 9px;
        background: rgba(201,162,77,.15);
        border: 1px solid rgba(201,162,77,.45);
        color: #f0d7a0;
        font-weight: 700;
    }

    .registration-status {
        background: white;
        border: 1px solid #e2e8f0;
        border-right: 5px solid #c9a24d;
        border-radius: 13px;
        padding: 20px;
        margin-bottom: 24px;
    }

        .registration-status.closed {
            border-right-color: #b74b4b;
        }

        .registration-status h5 {
            font-weight: 800;
            margin-bottom: 10px;
        }

        .registration-status p {
            margin-bottom: 0;
            color: #65758a;
        }

    .registration-dates {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 15px;
    }

    .registration-date {
        background: #f6f8fb;
        padding: 10px 14px;
        border-radius: 9px;
        font-size: 13px;
    }

    .courses-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 24px;
    }

    .summary-card {
        background: white;
        border: 1px solid #e5eaf2;
        border-radius: 13px;
        padding: 20px;
    }

    .summary-label {
        color: #718096;
        font-size: 13px;
        margin-bottom: 9px;
    }

    .summary-value {
        font-size: 25px;
        font-weight: 800;
        color: #142d4e;
    }

    .courses-table-wrapper {
        background: white;
        border: 1px solid #e5eaf2;
        border-radius: 14px;
        overflow-x: auto;
    }

    .courses-table {
        width: 100%;
        min-width: 740px;
        border-collapse: collapse;
        text-align: right;
    }

        .courses-table th {
            background: #142d4e;
            color: white;
            padding: 16px;
            white-space: nowrap;
        }

        .courses-table td {
            padding: 16px;
            border-bottom: 1px solid #edf0f5;
            vertical-align: middle;
        }

        .courses-table tbody tr:hover {
            background: #fafbfd;
        }

    .course-name {
        font-weight: 800;
        color: #142d4e;
    }

    .course-code {
        font-size: 12px;
        color: #718096;
        margin-top: 4px;
    }

    .course-status {
        display: inline-block;
        border-radius: 8px;
        padding: 7px 12px;
        font-size: 12px;
        font-weight: 700;
    }

        .course-status.registered {
            background: #e8f0fc;
            color: #315d9d;
        }

        .course-status.available {
            background: #e9f7ef;
            color: #167348;
        }

        .course-status.full {
            background: #fff0ef;
            color: #b34035;
        }

        .course-status.closed {
            background: #f0f1f4;
            color: #687386;
        }

    .register-button {
        border: none;
        background: #c9a24d;
        color: #142d4e;
        padding: 10px 18px;
        border-radius: 9px;
        font-weight: 800;
        cursor: pointer;
    }

        .register-button:hover {
            background: #b9913d;
        }

    .disabled-button {
        border: none;
        background: #e9edf2;
        color: #718096;
        padding: 10px 18px;
        border-radius: 9px;
        font-weight: 700;
        cursor: not-allowed;
    }

    .courses-empty {
        padding: 40px 20px;
        text-align: center;
        color: #718096;
        background: white;
        border: 1px solid #e5eaf2;
        border-radius: 13px;
    }

        .courses-empty i {
            font-size: 38px;
            color: #c9a24d;
            display: block;
            margin-bottom: 12px;
        }

    .courses-note {
        background: #fff9ec;
        border: 1px solid #efdfbb;
        color: #755a2d;
        border-radius: 10px;
        padding: 17px;
        margin-top: 22px;
        line-height: 1.8;
    }

    @@media (max-width: 750px) {
        .courses-summary {
            grid-template-columns: 1fr;
        }

        .student-courses-header {
            padding: 20px;
        }
    }
</style>

<div class="student-courses">

    <div class="student-courses-header">

        <h2>
            <i class="bi bi-journal-plus"></i>
            تسجيل المقررات الدراسية
        </h2>

        <p>
            استعرض المقررات المطروحة لقسمك،
            وتابع حالة التسجيل التي تحددها إدارة الجامعة.
        </p>

        @if (activeSemester != null)
        {
            <div class="student-semester">
                <i class="bi bi-calendar3"></i>
                الفصل: @activeSemester.Name
                - @activeSemester.AcademicYear
            </div>
        }

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill"></i>
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- حالة فترة التسجيل -->
    <div class="registration-status @(isRegistrationOpen ? "" : "closed")">

        @if (isRegistrationOpen)
        {
            <h5 style="color:#167348;">
                <i class="bi bi-unlock"></i>
                تسجيل المقررات مفتوح حاليًا
            </h5>
        }
        else
        {
            <h5 style="color:#b34035;">
                <i class="bi bi-lock"></i>
                تسجيل المقررات مغلق حاليًا
            </h5>
        }

        <p>@registrationMessage</p>

        @if (activeSemester != null &&
             activeSemester.RegistrationStartDate.HasValue &&
             activeSemester.RegistrationEndDate.HasValue)
        {
            <div class="registration-dates">

                <div class="registration-date">
                    <i class="bi bi-calendar-plus"></i>
                    <strong>بداية التسجيل:</strong>
                    @activeSemester.RegistrationStartDate.Value.ToString("yyyy/MM/dd HH:mm")
                </div>

                <div class="registration-date">
                    <i class="bi bi-calendar-x"></i>
                    <strong>نهاية التسجيل:</strong>
                    @activeSemester.RegistrationEndDate.Value.ToString("yyyy/MM/dd HH:mm")
                </div>

            </div>
        }

    </div>

    @if (activeSemester == null)
    {
        <div class="courses-empty">
            <i class="bi bi-calendar-x"></i>
            <h4>لا يوجد فصل دراسي فعّال</h4>
            <p>لا توجد مقررات متاحة للعرض حاليًا.</p>
        </div>
    }
    else
    {
        <!-- ملخص المقررات -->
        <div class="courses-summary">

            <div class="summary-card">
                <div class="summary-label">
                    المقررات المطروحة
                </div>
                <div class="summary-value">
                    @Model.Count
                </div>
            </div>

            <div class="summary-card">
                <div class="summary-label">
                    المقررات المسجلة
                </div>
                <div class="summary-value">
                    @registeredCoursesCount
                </div>
            </div>

            <div class="summary-card">
                <div class="summary-label">
                    المقررات التي تتوفر فيها مقاعد
                </div>
                <div class="summary-value">
                    @availableCoursesCount
                </div>
            </div>

        </div>

        @if (!Model.Any())
        {
            <div class="courses-empty">
                <i class="bi bi-journal-x"></i>
                <h4>لا توجد مقررات مطروحة لقسمك</h4>
                <p>
                    لم تتم إضافة مقررات لقسمك في الفصل الحالي.
                </p>
            </div>
        }
        else
        {
            <div class="courses-table-wrapper">

                <table class="courses-table">

                    <thead>
                        <tr>
                            <th>المقرر</th>
                            <th>الساعات</th>
                            <th>السعة</th>
                            <th>المقاعد المتبقية</th>
                            <th>الحالة</th>
                            <th>الإجراء</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var offering in Model)
                        {
                            int registeredCount =
                                registeredCounts.GetValueOrDefault(offering.Id);

                            int remainingSeats = Math.Max(
                                0,
                                offering.Capacity - registeredCount);

                            bool isRegistered =
                                registeredCourseIds.Contains(offering.CourseId);

                            bool isFull = remainingSeats == 0;

                            <tr>
                                <td>
                                    <div class="course-name">
                                        @offering.Course.Name
                                    </div>

                                    <div class="course-code">
                                        @offering.Course.Code
                                    </div>
                                </td>

                                <td>
                                    @offering.Course.CreditHours
                                </td>

                                <td>
                                    @offering.Capacity
                                </td>

                                <td>
                                    @remainingSeats
                                </td>

                                <td>
                                    @if (isRegistered)
                                    {
                                        <span class="course-status registered">
                                            مسجل مسبقًا
                                        </span>
                                    }
                                    else if (!isRegistrationOpen)
                                    {
                                        <span class="course-status closed">
                                            التسجيل مغلق
                                        </span>
                                    }
                                    else if (isFull)
                                    {
                                        <span class="course-status full">
                                            مكتمل العدد
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="course-status available">
                                            متاح للتسجيل
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (isRegistered)
                                    {
                                        <button class="disabled-button" disabled>
                                            <i class="bi bi-check-circle"></i>
                                            تم التسجيل
                                        </button>
                                    }
                                    else if (!isRegistrationOpen)
                                    {
                                        <button class="disabled-button" disabled>
                                            <i class="bi bi-lock"></i>
                                            التسجيل مغلق
                                        </button>
                                    }
                                    else if (isFull)
                                    {
                                        <button class="disabled-button" disabled>
                                            لا توجد مقاعد
                                        </button>
                                    }
                                    else
                                    {
                                        <form asp-controller="StudentDashboard"
                                              asp-action="Register"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="offeringId"
                                                   value="@offering.Id" />

                                            <button type="submit"
                                                    class="register-button">
                                                <i class="bi bi-plus-circle"></i>
                                                تسجيل
                                            </button>

                                        </form>
                                    }
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            </div>
        }

        <div class="courses-note">
            <i class="bi bi-info-circle"></i>
            <strong>ملاحظة:</strong>
            يستطيع الطالب استعراض المقررات في أي وقت،
            لكن تسجيل مقرر جديد مسموح فقط خلال الفترة
            التي تفتحها إدارة الجامعة، وبشرط توفر مقاعد
            وعدم تسجيل المقرر مسبقًا.
        </div>
    }

</div>