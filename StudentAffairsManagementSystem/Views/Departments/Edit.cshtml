@model StudentAffairsManagementSystem.Models.Department

@{
    ViewData["Title"] = "تعديل القسم الأكاديمي";
}

<style>
    .department-edit-page {
        direction: rtl;
        max-width: 900px;
        margin: 20px auto;
        color: #142d4e;
    }

    .department-edit-header {
        background: linear-gradient(135deg, #142d4e, #304661);
        color: #ffffff;
        padding: 28px 32px;
        border-radius: 16px 16px 0 0;
        border-bottom: 4px solid #c9a24d;
    }

        .department-edit-header h2 {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 25px;
            font-weight: 800;
            margin: 0 0 10px;
        }

            .department-edit-header h2 i {
                color: #c9a24d;
                font-size: 27px;
            }

        .department-edit-header p {
            color: #d6dfeb;
            font-size: 14px;
            line-height: 1.9;
            margin: 0;
        }

    .department-edit-body {
        background: #ffffff;
        padding: 30px;
        border: 1px solid #e5eaf2;
        border-top: none;
        border-radius: 0 0 16px 16px;
        box-shadow: 0 5px 25px rgba(20,45,78,.05);
    }

    .department-edit-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #142d4e;
        font-size: 18px;
        font-weight: 800;
        border-right: 4px solid #c9a24d;
        padding-right: 13px;
        margin-bottom: 25px;
    }

        .department-edit-section-title i {
            color: #b9913d;
            font-size: 20px;
        }

    .department-edit-field {
        margin-bottom: 25px;
    }

    .department-edit-label {
        display: block;
        color: #142d4e;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 9px;
    }

    .department-edit-required {
        color: #b42318;
    }

    .department-edit-input {
        width: 100%;
        min-height: 46px;
        padding: 11px 14px;
        border: 1px solid #dce3ed;
        border-radius: 11px;
        background: #ffffff;
        color: #142d4e;
        font-size: 14px;
        font-family: inherit;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .department-edit-input:focus {
            outline: none;
            border-color: #c9a24d;
            box-shadow: 0 0 0 3px rgba(201,162,77,.14);
        }

        .department-edit-input::placeholder {
            color: #98a4b5;
        }

        .department-edit-input.input-validation-error {
            border-color: #dc756e;
        }

    .department-edit-hint {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        color: #718096;
        font-size: 13px;
        line-height: 1.9;
        margin-top: 9px;
    }

        .department-edit-hint i {
            color: #b9913d;
            margin-top: 2px;
            flex-shrink: 0;
        }

    .department-edit-error {
        display: block;
        color: #b42318;
        font-size: 13px;
        line-height: 1.7;
        margin-top: 7px;
    }

    .department-edit-validation-summary {
        background: #fff0ee;
        border: 1px solid #f1d8d5;
        border-radius: 11px;
        padding: 15px 18px;
        margin-bottom: 22px;
        color: #b42318;
        font-size: 14px;
    }

        .department-edit-validation-summary.validation-summary-valid {
            display: none;
        }

        .department-edit-validation-summary ul {
            margin: 0;
            padding-right: 20px;
        }

    .department-edit-status {
        background: #f7f9fc;
        border: 1px solid #e9edf3;
        border-right: 4px solid #c9a24d;
        border-radius: 11px;
        padding: 18px 20px;
        margin-bottom: 25px;
    }

    .department-edit-status-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .department-edit-status input[type="checkbox"] {
        width: 19px;
        height: 19px;
        margin: 0;
        accent-color: #c9a24d;
        cursor: pointer;
        flex-shrink: 0;
    }

    .department-edit-status label {
        color: #142d4e;
        font-size: 14px;
        font-weight: 800;
        cursor: pointer;
    }

    .department-edit-status-description {
        color: #718096;
        font-size: 13px;
        line-height: 1.9;
        margin-top: 12px;
    }

    .department-edit-note {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        background: #fffaf0;
        border: 1px solid #f0e2c3;
        border-radius: 11px;
        padding: 16px 18px;
        color: #665532;
        font-size: 14px;
        line-height: 1.9;
        margin-bottom: 28px;
    }

        .department-edit-note i {
            color: #b9913d;
            font-size: 19px;
            flex-shrink: 0;
        }

    .department-edit-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 25px;
        border-top: 1px solid #e9edf3;
    }

    .department-edit-save,
    .department-edit-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 45px;
        padding: 11px 22px;
        border-radius: 11px;
        font-size: 14px;
        font-weight: 800;
        font-family: inherit;
        text-decoration: none;
        transition: background-color .2s ease;
    }

    .department-edit-save {
        background: #c9a24d;
        color: #142d4e;
        border: 1px solid transparent;
        cursor: pointer;
    }

        .department-edit-save:hover {
            background: #b9913d;
            color: #142d4e;
        }

    .department-edit-cancel {
        background: #edf1f7;
        color: #142d4e;
        border: 1px solid #dfe6ef;
    }

        .department-edit-cancel:hover {
            background: #e1e8f2;
            color: #142d4e;
        }

        .department-edit-save:focus-visible,
        .department-edit-cancel:focus-visible {
            outline: 3px solid #142d4e;
            outline-offset: 3px;
        }

    @@media (max-width: 650px) {
        .department-edit-page {
            margin: 15px auto;
        }

        .department-edit-header,
        .department-edit-body {
            padding: 22px;
        }

            .department-edit-header h2 {
                font-size: 21px;
            }

        .department-edit-status {
            padding: 16px;
        }

        .department-edit-actions {
            flex-direction: column;
        }

        .department-edit-save,
        .department-edit-cancel {
            width: 100%;
        }
    }
</style>

<div class="department-edit-page">

    <!-- رأس الصفحة -->

    <div class="department-edit-header">

        <h2>
            <i class="bi bi-pencil-square"></i>
            تعديل بيانات القسم الأكاديمي
        </h2>

        <p>
            تعديل اسم القسم ورمزه والكلية المرتبط بها
            وحالة تفعيله في النظام.
        </p>

    </div>

    <!-- نموذج التعديل -->

    <div class="department-edit-body">

        <form asp-controller="Departments"
              asp-action="Edit"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <!-- معرّف القسم -->

            <input asp-for="Id"
                   type="hidden" />

            <!-- أخطاء التحقق -->

            <div asp-validation-summary="ModelOnly"
                 class="department-edit-validation-summary"></div>

            <!-- عنوان البيانات -->

            <h3 class="department-edit-section-title">
                <i class="bi bi-diagram-3"></i>
                بيانات القسم الأكاديمي
            </h3>

            <!-- اسم القسم -->

            <div class="department-edit-field">

                <label asp-for="Name"
                       class="department-edit-label">
                    اسم القسم الأكاديمي
                    <span class="department-edit-required">*</span>
                </label>

                <input asp-for="Name"
                       class="department-edit-input"
                       placeholder="أدخل اسم القسم الأكاديمي"
                       required />

                <span asp-validation-for="Name"
                      class="department-edit-error"></span>

            </div>

            <!-- رمز القسم -->

            <div class="department-edit-field">

                <label asp-for="Code"
                       class="department-edit-label">
                    رمز القسم
                    <span class="department-edit-required">*</span>
                </label>

                <input asp-for="Code"
                       class="department-edit-input"
                       placeholder="مثال: 01"
                       maxlength="2"
                       pattern="[0-9]{2}"
                       inputmode="numeric"
                       dir="ltr"
                       style="text-align:right;"
                       required />

                <div class="department-edit-hint">

                    <i class="bi bi-info-circle"></i>

                    <span>
                        يجب أن يتكون رمز القسم من رقمين فقط،
                        وألّا يكون مستخدمًا في قسم آخر.
                    </span>

                </div>

                <span asp-validation-for="Code"
                      class="department-edit-error"></span>

            </div>

            <!-- الكلية -->

            <div class="department-edit-field">

                <label asp-for="FacultyId"
                       class="department-edit-label">
                    الكلية
                    <span class="department-edit-required">*</span>
                </label>

                <select asp-for="FacultyId"
                        asp-items="ViewBag.FacultyId"
                        class="department-edit-input"
                        required>

                    <option value="">
                        -- اختر الكلية --
                    </option>

                </select>

                <span asp-validation-for="FacultyId"
                      class="department-edit-error"></span>

                <div class="department-edit-hint">

                    <i class="bi bi-info-circle"></i>

                    <span>
                        تظهر الكليات الفعّالة المسجلة
                        في قاعدة البيانات.
                    </span>

                </div>

            </div>

            <!-- حالة القسم -->

            <div class="department-edit-field">

                <label class="department-edit-label">
                    حالة القسم
                </label>

                <div class="department-edit-status">

                    <div class="department-edit-status-row">

                        <input asp-for="IsActive"
                               type="checkbox"
                               role="switch" />

                        <label asp-for="IsActive">
                            القسم فعّال
                        </label>

                    </div>

                    <div class="department-edit-status-description">
                        عند إلغاء التفعيل، سيبقى القسم
                        محفوظًا في النظام بحالة غير فعّالة.
                    </div>

                </div>

                <span asp-validation-for="IsActive"
                      class="department-edit-error"></span>

            </div>

            <!-- ملاحظة مهمة -->

            <div class="department-edit-note">

                <i class="bi bi-exclamation-triangle"></i>

                <span>
                    <strong>ملاحظة مهمة:</strong>
                    لا يمكن تغيير رمز القسم بعد تسجيل
                    طلاب مرتبطين به، وذلك للحفاظ على
                    صحة أرقامهم الجامعية وبياناتهم.
                </span>

            </div>

            <!-- أزرار النموذج -->

            <div class="department-edit-actions">

                <button type="submit"
                        class="department-edit-save">

                    <i class="bi bi-check-circle"></i>
                    حفظ التعديلات

                </button>

                <a asp-controller="Departments"
                   asp-action="Index"
                   class="department-edit-cancel">

                    <i class="bi bi-x-circle"></i>
                    إلغاء والعودة

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
