@model StudentAffairsManagementSystem.Models.Department

@{
    ViewData["Title"] = "إضافة قسم أكاديمي";
}

<style>
    .department-create-page {
        direction: rtl;
        max-width: 900px;
        margin: 20px auto;
        color: #142d4e;
    }

    /* رأس الصفحة */

    .department-create-header {
        background: linear-gradient(135deg, #142d4e, #304661);
        color: #ffffff;
        padding: 28px 32px;
        border-radius: 16px 16px 0 0;
        border-bottom: 4px solid #c9a24d;
    }

        .department-create-header h2 {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 25px;
            font-weight: 800;
            margin: 0 0 10px;
        }

            .department-create-header h2 i {
                color: #c9a24d;
                font-size: 27px;
            }

        .department-create-header p {
            color: #d6dfeb;
            font-size: 14px;
            line-height: 1.9;
            margin: 0;
        }

    /* بطاقة النموذج */

    .department-create-body {
        background: #ffffff;
        padding: 30px;
        border: 1px solid #e5eaf2;
        border-top: none;
        border-radius: 0 0 16px 16px;
        box-shadow: 0 5px 25px rgba(20,45,78,.05);
    }

    /* عنوان القسم */

    .department-create-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #142d4e;
        font-size: 18px;
        font-weight: 800;
        border-right: 4px solid #c9a24d;
        padding-right: 13px;
        margin-bottom: 25px;
    }

        .department-create-section-title i {
            color: #b9913d;
            font-size: 20px;
        }

    /* حقول النموذج */

    .department-create-field {
        margin-bottom: 25px;
    }

    .department-create-label {
        display: block;
        color: #142d4e;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 9px;
    }

    .department-create-required {
        color: #b42318;
    }

    .department-create-input {
        width: 100%;
        min-height: 46px;
        padding: 11px 14px;
        border: 1px solid #dce3ed;
        border-radius: 11px;
        background: #ffffff;
        color: #142d4e;
        font-size: 14px;
        font-family: inherit;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .department-create-input:focus {
            outline: none;
            border-color: #c9a24d;
            box-shadow: 0 0 0 3px rgba(201,162,77,.14);
        }

        .department-create-input::placeholder {
            color: #98a4b5;
        }

        .department-create-input.input-validation-error {
            border-color: #dc756e;
        }

    /* النصوص الإرشادية */

    .department-create-hint {
        display: flex;
        align-items: flex-start;
        gap: 7px;
        color: #718096;
        font-size: 13px;
        line-height: 1.8;
        margin-top: 9px;
    }

        .department-create-hint i {
            color: #b9913d;
            margin-top: 2px;
            flex-shrink: 0;
        }

    /* رسائل التحقق */

    .department-create-error {
        display: block;
        color: #b42318;
        font-size: 13px;
        line-height: 1.7;
        margin-top: 7px;
    }

    .department-create-validation-summary {
        background: #fff0ee;
        border: 1px solid #f1d8d5;
        border-radius: 11px;
        padding: 15px 18px;
        margin-bottom: 22px;
        color: #b42318;
        font-size: 14px;
    }

        .department-create-validation-summary.validation-summary-valid {
            display: none;
        }

        .department-create-validation-summary ul {
            margin: 0;
            padding-right: 20px;
        }

    /* خيار تفعيل القسم */

    .department-create-status {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        background: #f7f9fc;
        border: 1px solid #e9edf3;
        border-right: 4px solid #c9a24d;
        border-radius: 11px;
        padding: 18px 20px;
        margin-bottom: 30px;
    }

        .department-create-status input[type="checkbox"] {
            width: 19px;
            height: 19px;
            margin-top: 3px;
            accent-color: #c9a24d;
            cursor: pointer;
            flex-shrink: 0;
        }

        .department-create-status label {
            color: #142d4e;
            font-size: 14px;
            font-weight: 700;
            line-height: 1.9;
            cursor: pointer;
        }

    /* أزرار النموذج */

    .department-create-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 25px;
        border-top: 1px solid #e9edf3;
    }

    .department-create-save,
    .department-create-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 45px;
        padding: 11px 22px;
        border-radius: 11px;
        font-size: 14px;
        font-weight: 800;
        font-family: inherit;
        text-decoration: none;
        transition: background-color .2s ease;
    }

    /* زر الحفظ */

    .department-create-save {
        background: #c9a24d;
        color: #142d4e;
        border: 1px solid transparent;
        cursor: pointer;
    }

        .department-create-save:hover {
            background: #b9913d;
            color: #142d4e;
        }

    /* زر الإلغاء */

    .department-create-cancel {
        background: #edf1f7;
        color: #142d4e;
        border: 1px solid #dfe6ef;
    }

        .department-create-cancel:hover {
            background: #e1e8f2;
            color: #142d4e;
        }

        .department-create-save:focus-visible,
        .department-create-cancel:focus-visible {
            outline: 3px solid #142d4e;
            outline-offset: 3px;
        }

    /* الشاشات الصغيرة */

    @@media (max-width: 650px) {
        .department-create-page {
            margin: 15px auto;
        }

        .department-create-header,
        .department-create-body {
            padding: 22px;
        }

            .department-create-header h2 {
                font-size: 21px;
            }

        .department-create-status {
            padding: 16px;
        }

        .department-create-actions {
            flex-direction: column;
        }

        .department-create-save,
        .department-create-cancel {
            width: 100%;
        }
    }
</style>

<div class="department-create-page">

    <!-- عنوان الصفحة -->

    <div class="department-create-header">

        <h2>
            <i class="bi bi-diagram-3"></i>
            إضافة قسم أكاديمي جديد
        </h2>

        <p>
            أدخل بيانات القسم الأكاديمي
            واربطه بإحدى كليات الجامعة.
        </p>

    </div>

    <!-- بطاقة النموذج -->

    <div class="department-create-body">

        <form asp-controller="Departments"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <!-- رسائل التحقق العامة -->

            <div asp-validation-summary="ModelOnly"
                 class="department-create-validation-summary"></div>

            <!-- عنوان القسم -->

            <h3 class="department-create-section-title">
                <i class="bi bi-journal-bookmark"></i>
                بيانات القسم الأكاديمي
            </h3>

            <!-- اسم القسم -->

            <div class="department-create-field">

                <label asp-for="Name"
                       class="department-create-label">

                    اسم القسم الأكاديمي
                    <span class="department-create-required">*</span>

                </label>

                <input asp-for="Name"
                       class="department-create-input"
                       placeholder="أدخل اسم القسم الأكاديمي"
                       required />

                <span asp-validation-for="Name"
                      class="department-create-error"></span>

            </div>

            <!-- رمز القسم -->

            <div class="department-create-field">

                <label asp-for="Code"
                       class="department-create-label">

                    رمز القسم
                    <span class="department-create-required">*</span>

                </label>

                <input asp-for="Code"
                       class="department-create-input"
                       placeholder="مثال: 01"
                       maxlength="2"
                       pattern="[0-9]{2}"
                       inputmode="numeric"
                       dir="ltr"
                       style="text-align:right;"
                       required />

                <div class="department-create-hint">

                    <i class="bi bi-info-circle"></i>

                    <span>
                        يجب أن يتكوّن رمز القسم من رقمين فقط،
                        وألّا يكون مستخدمًا في قسم آخر.
                    </span>

                </div>

                <span asp-validation-for="Code"
                      class="department-create-error"></span>

            </div>

            <!-- اختيار الكلية -->

            <div class="department-create-field">

                <label asp-for="FacultyId"
                       class="department-create-label">

                    الكلية
                    <span class="department-create-required">*</span>

                </label>

                <select asp-for="FacultyId"
                        asp-items="ViewBag.FacultyId"
                        class="department-create-input"
                        required>

                    <option value="">
                        -- اختر الكلية --
                    </option>

                </select>

                <span asp-validation-for="FacultyId"
                      class="department-create-error"></span>

                <div class="department-create-hint">

                    <i class="bi bi-info-circle"></i>

                    <span>
                        تظهر الكليات الفعّالة المسجلة
                        في قاعدة البيانات.
                    </span>

                </div>

            </div>

            <!-- حالة القسم -->

            <div class="department-create-status">

                <input asp-for="IsActive"
                       type="checkbox" />

                <label asp-for="IsActive">
                    القسم فعّال ومتاح لإضافة المقررات والطلاب
                </label>

            </div>

            <!-- أزرار الحفظ والإلغاء -->

            <div class="department-create-actions">

                <button type="submit"
                        class="department-create-save">

                    <i class="bi bi-check-circle"></i>
                    حفظ القسم

                </button>

                <a asp-controller="Departments"
                   asp-action="Index"
                   class="department-create-cancel">

                    <i class="bi bi-x-circle"></i>
                    إلغاء والعودة

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
