@model StudentAffairsManagementSystem.Models.Student

@{
    ViewData["Title"] = "حذف طالب";
}

<style>
    .student-delete-page {
        direction: rtl;
        max-width: 900px;
        margin: 20px auto;
        color: #142d4e;
    }

    /* رأس الصفحة */

    .student-delete-header {
        background: linear-gradient(135deg, #142d4e, #304661);
        color: #ffffff;
        padding: 28px 32px;
        border-radius: 16px 16px 0 0;
        border-bottom: 4px solid #c9a24d;
    }

        .student-delete-header h2 {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 25px;
            font-weight: 800;
            margin: 0 0 10px;
        }

            .student-delete-header h2 i {
                color: #c9a24d;
                font-size: 27px;
            }

        .student-delete-header p {
            color: #d6dfeb;
            font-size: 14px;
            line-height: 1.9;
            margin: 0;
        }

    /* بطاقة الصفحة */

    .student-delete-card {
        background: #ffffff;
        padding: 30px;
        border: 1px solid #e5eaf2;
        border-top: none;
        border-radius: 0 0 16px 16px;
        box-shadow: 0 5px 25px rgba(20,45,78,.05);
    }

    /* رسالة التحذير */

    .student-delete-warning {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        background: #fff6ed;
        border: 1px solid #f2d5bc;
        border-right: 4px solid #d97735;
        padding: 20px;
        border-radius: 11px;
        margin-bottom: 30px;
    }

    .student-delete-warning-icon {
        font-size: 28px;
        color: #bd5e22;
        flex-shrink: 0;
    }

    .student-delete-warning h3 {
        color: #9d451c;
        font-size: 18px;
        font-weight: 800;
        margin: 0 0 10px;
    }

    .student-delete-warning p {
        color: #80533a;
        font-size: 14px;
        line-height: 2;
        margin: 0;
    }

    /* عنوان بيانات الطالب */

    .student-delete-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #142d4e;
        font-size: 18px;
        font-weight: 800;
        padding-right: 13px;
        border-right: 4px solid #c9a24d;
        margin-bottom: 23px;
    }

        .student-delete-section-title i {
            color: #b9913d;
            font-size: 20px;
        }

    /* شبكة بيانات الطالب */

    .student-delete-info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 30px;
    }

    .student-delete-info-item {
        background: #f8f9fc;
        border: 1px solid #edf0f5;
        border-radius: 11px;
        padding: 17px 19px;
        min-width: 0;
    }

    .student-delete-info-label {
        display: block;
        color: #718096;
        font-size: 13px;
        margin-bottom: 9px;
    }

    .student-delete-info-value {
        display: block;
        color: #142d4e;
        font-size: 14px;
        font-weight: 800;
        line-height: 1.9;
        overflow-wrap: anywhere;
    }

    /* رسالة الخطأ */

    .student-delete-error {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        background: #fff0ee;
        color: #b42318;
        border: 1px solid #f1d8d5;
        padding: 15px 18px;
        border-radius: 11px;
        margin-bottom: 22px;
        font-size: 14px;
        line-height: 1.9;
    }

        .student-delete-error i {
            font-size: 19px;
            flex-shrink: 0;
        }

    /* أزرار الصفحة */

    .student-delete-actions {
        display: flex;
        justify-content: flex-start;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 25px;
        border-top: 1px solid #e9edf3;
    }

    .student-delete-confirm-btn,
    .student-delete-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 45px;
        padding: 11px 22px;
        border-radius: 11px;
        font-size: 14px;
        font-weight: 800;
        font-family: inherit;
        text-decoration: none;
        transition: background-color .2s ease;
    }

    .student-delete-confirm-btn {
        background: #fff0ee;
        color: #b42318;
        border: 1px solid #f1d8d5;
        cursor: pointer;
    }

        .student-delete-confirm-btn:hover {
            background: #f9dfdc;
            color: #982626;
        }

    .student-delete-cancel-btn {
        background: #edf1f7;
        color: #142d4e;
        border: 1px solid #dfe6ef;
    }

        .student-delete-cancel-btn:hover {
            background: #e1e8f2;
            color: #142d4e;
        }

        .student-delete-confirm-btn:focus-visible,
        .student-delete-cancel-btn:focus-visible {
            outline: 3px solid #142d4e;
            outline-offset: 3px;
        }

    /* الشاشات الصغيرة */

    @@media (max-width: 650px) {
        .student-delete-page {
            margin: 15px auto;
        }

        .student-delete-header,
        .student-delete-card {
            padding: 22px;
        }

            .student-delete-header h2 {
                font-size: 21px;
            }

        .student-delete-warning {
            padding: 16px;
        }

            .student-delete-warning h3 {
                font-size: 16px;
            }

        .student-delete-info-grid {
            grid-template-columns: 1fr;
        }

        .student-delete-actions {
            flex-direction: column;
        }

        .student-delete-confirm-btn,
        .student-delete-cancel-btn {
            width: 100%;
        }
    }
</style>

<div class="student-delete-page">

    <!-- عنوان الصفحة -->

    <div class="student-delete-header">

        <h2>
            <i class="bi bi-person-x"></i>
            تأكيد حذف الطالب
        </h2>

        <p>
            يرجى مراجعة بيانات الطالب قبل تنفيذ عملية الحذف.
        </p>

    </div>

    <div class="student-delete-card">

        <!-- رسالة الخطأ -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="student-delete-error"
                 role="alert">

                <i class="bi bi-exclamation-circle"></i>

                <span>
                    @TempData["ErrorMessage"]
                </span>

            </div>
        }

        <!-- تحذير الحذف -->

        <div class="student-delete-warning"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill student-delete-warning-icon"></i>

            <div>

                <h3>
                    هل أنت متأكد من حذف هذا الطالب؟
                </h3>

                <p>
                    عند تأكيد الحذف، سيتم إخفاء الطالب من
                    قوائم الطلاب وإيقاف حسابه عن تسجيل الدخول.
                    ستبقى بياناته وسجلاته الأكاديمية محفوظة
                    في قاعدة البيانات، ولن يتم حذفها نهائيًا.
                </p>

            </div>

        </div>

        <!-- بيانات الطالب -->

        <h3 class="student-delete-section-title">
            <i class="bi bi-person-vcard"></i>
            بيانات الطالب
        </h3>

        <div class="student-delete-info-grid">

            <!-- الرقم الجامعي -->

            <div class="student-delete-info-item">

                <span class="student-delete-info-label">
                    الرقم الجامعي
                </span>

                <span class="student-delete-info-value"
                      dir="ltr">
                    @Model.UniversityNumber
                </span>

            </div>

            <!-- الاسم الكامل -->

            <div class="student-delete-info-item">

                <span class="student-delete-info-label">
                    اسم الطالب الكامل
                </span>

                <span class="student-delete-info-value">
                    @Model.FirstName
                    @Model.FatherName
                    @Model.LastName
                </span>

            </div>

            <!-- القسم الأكاديمي -->

            <div class="student-delete-info-item">

                <span class="student-delete-info-label">
                    القسم
                </span>

                <span class="student-delete-info-value">
                    @(Model.Department?.Name ?? "غير محدد")
                </span>

            </div>

            <!-- الحالة الدراسية -->

            <div class="student-delete-info-item">

                <span class="student-delete-info-label">
                    حالة الطالب
                </span>

                <span class="student-delete-info-value">
                    @Model.Status
                </span>

            </div>

        </div>

        <!-- نموذج تأكيد الحذف -->

        <form asp-controller="Students"
              asp-action="Delete"
              asp-route-id="@Model.Id"
              method="post"
              onsubmit="return confirm('تأكيد نهائي: هل تريد حذف الطالب وإيقاف حسابه؟');">

            @Html.AntiForgeryToken()

            <div class="student-delete-actions">

                <button type="submit"
                        class="student-delete-confirm-btn">

                    <i class="bi bi-trash3"></i>
                    نعم، تأكيد الحذف

                </button>

                <a asp-controller="Students"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="student-delete-cancel-btn">

                    <i class="bi bi-x-circle"></i>
                    إلغاء والعودة للتفاصيل

                </a>

            </div>

        </form>

    </div>

</div>
