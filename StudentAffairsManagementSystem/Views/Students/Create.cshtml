@model StudentAffairsManagementSystem.ViewModels.CreateStudentViewModel

@{
    ViewData["Title"] = "إضافة طالب جديد";

    var departments =
        ViewBag.Departments as IEnumerable<StudentAffairsManagementSystem.Models.Department>
        ?? Enumerable.Empty<StudentAffairsManagementSystem.Models.Department>();

    var semesters =
        ViewBag.Semesters as IEnumerable<StudentAffairsManagementSystem.Models.Semester>
        ?? Enumerable.Empty<StudentAffairsManagementSystem.Models.Semester>();
}

<style>
    .student-create-page {
        direction: rtl;
        max-width: 1100px;
        margin: 20px auto;
        color: #142d4e;
    }

    .student-create-header {
        background: linear-gradient(135deg, #142d4e, #304661);
        color: #ffffff;
        padding: 28px 32px;
        border-radius: 16px 16px 0 0;
        border-bottom: 4px solid #c9a24d;
    }

        .student-create-header h2 {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 25px;
            font-weight: 800;
            margin: 0 0 10px;
        }

            .student-create-header h2 i {
                color: #c9a24d;
                font-size: 27px;
            }

        .student-create-header p {
            color: #d6dfeb;
            font-size: 14px;
            line-height: 1.9;
            margin: 0;
        }

    .student-create-card {
        background: #ffffff;
        border: 1px solid #e5eaf2;
        border-radius: 0 0 16px 16px;
        padding: 30px;
        box-shadow: 0 5px 25px rgba(20,45,78,.05);
    }

    /* الأقسام */

    .student-section {
        margin-bottom: 30px;
        padding-bottom: 26px;
        border-bottom: 1px solid #e9edf3;
    }

    .student-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 18px;
        font-weight: 800;
        color: #142d4e;
        margin-bottom: 23px;
        padding-right: 13px;
        border-right: 4px solid #c9a24d;
    }

        .student-section-title i {
            color: #b9913d;
            font-size: 20px;
        }

    /* شبكة الحقول */

    .student-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .student-form-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-width: 0;
    }

        .student-form-field.full-width {
            grid-column: 1 / -1;
        }

    .student-form-label {
        font-size: 14px;
        font-weight: 700;
        color: #142d4e;
    }

    .student-form-input {
        width: 100%;
        min-height: 46px;
        padding: 11px 14px;
        border: 1px solid #dce3ed;
        border-radius: 11px;
        background: #ffffff;
        color: #142d4e;
        font-size: 14px;
        font-family: inherit;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .student-form-input:focus {
            outline: none;
            border-color: #c9a24d;
            box-shadow: 0 0 0 3px rgba(201,162,77,.14);
        }

        .student-form-input::placeholder {
            color: #9aa7b8;
        }

    textarea.student-form-input {
        min-height: 105px;
        resize: vertical;
    }

    /* التحقق من البيانات */

    .student-form-error {
        color: #b42318;
        font-size: 13px;
        line-height: 1.7;
    }

    .student-validation-summary {
        background: #fff0ee;
        border: 1px solid #f1d8d5;
        border-radius: 11px;
        padding: 15px 18px;
        margin-bottom: 22px;
        color: #b42318;
        font-size: 14px;
    }

        .student-validation-summary.validation-summary-valid {
            display: none;
        }

        .student-validation-summary ul {
            margin: 0;
            padding-right: 20px;
        }

    .student-form-input.input-validation-error {
        border-color: #dc756e;
    }

    /* الملاحظات */

    .student-form-note {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        background: #f7f9fc;
        border-right: 4px solid #c9a24d;
        padding: 15px 18px;
        border-radius: 11px;
        color: #526174;
        font-size: 14px;
        line-height: 1.9;
        margin-bottom: 25px;
    }

        .student-form-note i {
            color: #b9913d;
            font-size: 18px;
            flex-shrink: 0;
        }

    /* أزرار النموذج */

    .student-form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
    }

    .student-save-btn,
    .student-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 45px;
        border-radius: 11px;
        padding: 11px 22px;
        font-size: 14px;
        font-weight: 800;
        font-family: inherit;
        text-decoration: none;
        transition: background-color .2s ease;
    }

    .student-save-btn {
        background: #c9a24d;
        color: #142d4e;
        border: 1px solid transparent;
        cursor: pointer;
    }

        .student-save-btn:hover {
            background: #b9913d;
            color: #142d4e;
        }

    .student-cancel-btn {
        background: #edf1f7;
        color: #142d4e;
        border: 1px solid #dfe6ef;
    }

        .student-cancel-btn:hover {
            background: #e1e8f2;
            color: #142d4e;
        }

        .student-save-btn:focus-visible,
        .student-cancel-btn:focus-visible {
            outline: 3px solid #142d4e;
            outline-offset: 3px;
        }

    @@media (max-width: 700px) {
        .student-form-grid {
            grid-template-columns: 1fr;
        }

        .student-create-card {
            padding: 20px;
        }

        .student-create-header {
            padding: 22px;
        }

            .student-create-header h2 {
                font-size: 21px;
            }

        .student-form-actions {
            flex-direction: column;
        }

        .student-save-btn,
        .student-cancel-btn {
            width: 100%;
        }
    }
</style>

<div class="student-create-page">

    <!-- عنوان الصفحة -->

    <div class="student-create-header">

        <h2>
            <i class="bi bi-person-plus-fill"></i>
            إضافة طالب جديد
        </h2>

        <p>
            إدخال بيانات الطالب الأكاديمية والشخصية
            وإنشاء حسابه في النظام
        </p>

    </div>

    <div class="student-create-card">

        <!-- ملاحظة الرقم الجامعي -->

        <div class="student-form-note">
            <i class="bi bi-info-circle"></i>

            <span>
                سيتم توليد الرقم الجامعي تلقائياً عند حفظ الطالب،
                بناءً على رمز القسم وتاريخ التسجيل والتسلسل.
            </span>
        </div>

        <form asp-controller="Students"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="student-validation-summary"></div>

            <!-- البيانات الأساسية -->

            <div class="student-section">

                <h3 class="student-section-title">
                    <i class="bi bi-person-vcard"></i>
                    البيانات الأساسية
                </h3>

                <div class="student-form-grid">

                    <div class="student-form-field">

                        <label asp-for="FirstName"
                               class="student-form-label">
                            اسم الطالب *
                        </label>

                        <input asp-for="FirstName"
                               class="student-form-input" />

                        <span asp-validation-for="FirstName"
                              class="student-form-error"></span>

                    </div>

                    <div class="student-form-field">

                        <label asp-for="FatherName"
                               class="student-form-label">
                            اسم الأب *
                        </label>

                        <input asp-for="FatherName"
                               class="student-form-input" />

                        <span asp-validation-for="FatherName"
                              class="student-form-error"></span>

                    </div>

                    <div class="student-form-field">

                        <label asp-for="MotherName"
                               class="student-form-label">
                            اسم الأم *
                        </label>

                        <input asp-for="MotherName"
                               class="student-form-input" />

                        <span asp-validation-for="MotherName"
                              class="student-form-error"></span>

                    </div>

                    <div class="student-form-field">

                        <label asp-for="LastName"
                               class="student-form-label">
                            الكنية *
                        </label>

                        <input asp-for="LastName"
                               class="student-form-input" />

                        <span asp-validation-for="LastName"
                              class="student-form-error"></span>

                    </div>

                    <div class="student-form-field">

                        <label asp-for="BirthDate"
                               class="student-form-label">
                            تاريخ الميلاد *
                        </label>

                        <input asp-for="BirthDate"
                               type="date"
                               required
                               class="student-form-input" />

                        <span asp-validation-for="BirthDate"
                              class="student-form-error"></span>

                    </div>

                    <div class="student-form-field">

                        <label asp-for="Gender"
                               class="student-form-label">
                            الجنس
                        </label>

                        <select asp-for="Gender"
                                class="student-form-input">

                            <option value="">-- اختر الجنس --</option>
                            <option value="ذكر">ذكر</option>
                            <option value="أنثى">أنثى</option>

                        </select>

                        <span asp-validation-for="Gender"
                              class="student-form-error"></span>

                    </div>

                    <div class="student-form-field">

                        <label asp-for="NationalId"
                               class="student-form-label">
                            الرقم الوطني
                        </label>

                        <input asp-for="NationalId"
                               class="student-form-input" />

                        <span asp-validation-for="NationalId"
                              class="student-form-error"></span>

                    </div>

                    <div class="student-form-field">

                        <label asp-for="Nationality"
                               class="student-form-label">
                            الجنسية
                        </label>

                        <input asp-for="Nationality"
                               class="student-form-input" />

                        <span asp-validation-for="Nationality"
                              class="student-form-error"></span>

                    </div>

                </div>

            </div>

            <!-- البيانات الأكاديمية -->

            <div class="student-section">

                <h3 class="student-section-title">
                    <i class="bi bi-mortarboard-fill"></i>
                    البيانات الأكاديمية
                </h3>

                <div class="student-form-grid">

                    <div class="student-form-field">

                        <label asp-for="DepartmentId"
                               class="student-form-label">
                            القسم الأكاديمي *
                        </label>

                        <select asp-for="DepartmentId"
                                class="student-form-input">

                            <option value="0">-- اختر القسم --</option>

                            @foreach (var department in departments)
                            {
                                <option value="@department.Id">
                                    @department.Name
                                </option>
                            }

                        </select>

                        <span asp-validation-for="DepartmentId"
                              class="student-form-error"></span>

                    </div>

                    <div class="student-form-field">

                        <label asp-for="AdmissionSemesterId"
                               class="student-form-label">
                            فصل القبول *
                        </label>

                        <select asp-for="AdmissionSemesterId"
                                class="student-form-input">

                            <option value="0">-- اختر فصل القبول --</option>

                            @foreach (var semester in semesters)
                            {
                                <option value="@semester.Id">
                                    @semester.Name
                                </option>
                            }

                        </select>

                        <span asp-validation-for="AdmissionSemesterId"
                              class="student-form-error"></span>

                    </div>

                    <div class="student-form-field">

                        <label asp-for="GraduationSemesterId"
                               class="student-form-label">
                            فصل التخرج (اختياري)
                        </label>

                        <select asp-for="GraduationSemesterId"
                                class="student-form-input">

                            <option value="">-- لم يتخرج بعد --</option>

                            @foreach (var semester in semesters)
                            {
                                <option value="@semester.Id">
                                    @semester.Name
                                </option>
                            }

                        </select>

                        <span asp-validation-for="GraduationSemesterId"
                              class="student-form-error"></span>

                    </div>

                    <div class="student-form-field">

                        <label asp-for="Status"
                               class="student-form-label">
                            الحالة الدراسية
                        </label>

                        <select asp-for="Status"
                                class="student-form-input">

                            <option value="">-- اختر الحالة --</option>
                            <option value="مستجد">مستجد</option>
                            <option value="مستمر">مستمر</option>
                            <option value="متخرج">متخرج</option>
                            <option value="منقطع">منقطع</option>
                            <option value="موقوف">موقوف</option>

                        </select>

                        <span asp-validation-for="Status"
                              class="student-form-error"></span>

                    </div>

                    <div class="student-form-field">

                        <label asp-for="GraduationAverage"
                               class="student-form-label">
                            معدل التخرج (إن وجد)
                        </label>

                        <input asp-for="GraduationAverage"
                               type="number"
                               step="0.01"
                               class="student-form-input" />

                        <span asp-validation-for="GraduationAverage"
                              class="student-form-error"></span>

                    </div>

                </div>

            </div>

            <!-- معلومات التواصل -->

            <div class="student-section">

                <h3 class="student-section-title">
                    <i class="bi bi-telephone-fill"></i>
                    معلومات التواصل
                </h3>

                <div class="student-form-grid">

                    <div class="student-form-field">

                        <label asp-for="Phone"
                               class="student-form-label">
                            رقم الهاتف
                        </label>

                        <input asp-for="Phone"
                               type="tel"
                               class="student-form-input" />

                        <span asp-validation-for="Phone"
                              class="student-form-error"></span>

                    </div>

                    <div class="student-form-field">

                        <label asp-for="Governorate"
                               class="student-form-label">
                            المحافظة
                        </label>

                        <input asp-for="Governorate"
                               class="student-form-input" />

                        <span asp-validation-for="Governorate"
                              class="student-form-error"></span>

                    </div>

                    <div class="student-form-field full-width">

                        <label asp-for="Address"
                               class="student-form-label">
                            العنوان
                        </label>

                        <textarea asp-for="Address"
                                  rows="3"
                                  class="student-form-input"></textarea>

                        <span asp-validation-for="Address"
                              class="student-form-error"></span>

                    </div>

                </div>

            </div>

            <!-- الصور والوثائق -->

            <div class="student-section">

                <h3 class="student-section-title">
                    <i class="bi bi-folder2-open"></i>
                    الصور والوثائق
                </h3>

                <div class="student-form-note">

                    <i class="bi bi-info-circle"></i>

                    <span>
                        هذه الحقول مخصصة لمسارات الصور والوثائق
                        المحفوظة في النظام.
                        رفع الملفات الفعلي سنضيفه لاحقاً.
                    </span>

                </div>

                <div class="student-form-grid">

                    <div class="student-form-field">

                        <label asp-for="PersonalImage"
                               class="student-form-label">
                            مسار الصورة الشخصية
                        </label>

                        <input asp-for="PersonalImage"
                               class="student-form-input"
                               placeholder="/uploads/students/photo.jpg" />

                        <span asp-validation-for="PersonalImage"
                              class="student-form-error"></span>

                    </div>

                    <div class="student-form-field">

                        <label asp-for="NationalIdImage"
                               class="student-form-label">
                            مسار صورة الهوية
                        </label>

                        <input asp-for="NationalIdImage"
                               class="student-form-input"
                               placeholder="/uploads/students/id.jpg" />

                        <span asp-validation-for="NationalIdImage"
                              class="student-form-error"></span>

                    </div>

                    <div class="student-form-field">

                        <label asp-for="CertificateImage"
                               class="student-form-label">
                            مسار صورة الشهادة
                        </label>

                        <input asp-for="CertificateImage"
                               class="student-form-input"
                               placeholder="/uploads/students/certificate.jpg" />

                        <span asp-validation-for="CertificateImage"
                              class="student-form-error"></span>

                    </div>

                </div>

            </div>

            <!-- بيانات حساب الطالب -->

            <div class="student-section">

                <h3 class="student-section-title">
                    <i class="bi bi-shield-lock-fill"></i>
                    بيانات حساب الطالب
                </h3>

                <div class="student-form-note">

                    <i class="bi bi-info-circle"></i>

                    <span>
                        اسم المستخدم سيكون الرقم الجامعي
                        الذي ينشئه النظام تلقائياً.
                    </span>

                </div>

                <div class="student-form-grid">

                    <div class="student-form-field">

                        <label asp-for="Password"
                               class="student-form-label">
                            كلمة المرور *
                        </label>

                        <input asp-for="Password"
                               type="password"
                               autocomplete="new-password"
                               class="student-form-input" />

                        <span asp-validation-for="Password"
                              class="student-form-error"></span>

                    </div>

                    <div class="student-form-field">

                        <label asp-for="ConfirmPassword"
                               class="student-form-label">
                            تأكيد كلمة المرور *
                        </label>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               autocomplete="new-password"
                               class="student-form-input" />

                        <span asp-validation-for="ConfirmPassword"
                              class="student-form-error"></span>

                    </div>

                </div>

            </div>

            <!-- أزرار الحفظ والإلغاء -->

            <div class="student-form-actions">

                <button type="submit"
                        class="student-save-btn">

                    <i class="bi bi-check-circle"></i>
                    حفظ الطالب وإنشاء الحساب

                </button>

                <a asp-controller="Students"
                   asp-action="Index"
                   class="student-cancel-btn">

                    <i class="bi bi-arrow-right"></i>
                    إلغاء والعودة

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
