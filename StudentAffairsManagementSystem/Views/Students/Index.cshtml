@model IEnumerable<StudentAffairsManagementSystem.Models.Student>

@{
    ViewData["Title"] = "إدارة الطلاب";

    var students = Model?.ToList()
        ?? new List<StudentAffairsManagementSystem.Models.Student>();

    bool canDeleteStudents =
        ViewBag.CanDeleteStudents is bool allowed && allowed;

    var totalStudents = students.Count;

    var totalDepartments = students
        .Select(s => s.DepartmentId)
        .Distinct()
        .Count();

    var departments = students
        .Where(s => s.Department != null)
        .GroupBy(s => s.DepartmentId)
        .Select(g => new
        {
            Id = g.Key,
            Name = g.First().Department!.Name
        })
        .OrderBy(d => d.Name)
        .ToList();
}

<style>
    .students-page {
        direction: rtl;
        color: #142d4e;
    }

    /* رأس الصفحة */

    .students-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 25px;
    }

        .students-header h2 {
            font-size: 26px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .students-header p {
            color: #718096;
            margin: 0;
        }

    /* زر إضافة طالب */

    .students-add-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        background: #c9a24d;
        color: #142d4e;
        padding: 12px 20px;
        border-radius: 11px;
        text-decoration: none;
        font-weight: 800;
        transition: background-color 0.2s ease;
    }

        .students-add-btn:hover {
            background: #b9913d;
            color: #142d4e;
        }

    /* بطاقات الإحصائيات */

    .students-stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 25px;
    }

    .students-stat-card {
        background: white;
        border: 1px solid #e5eaf0;
        border-radius: 14px;
        padding: 22px;
        border-right: 4px solid #c9a24d;
    }

    .students-stat-label {
        color: #718096;
        font-size: 14px;
        margin-bottom: 10px;
    }

    .students-stat-value {
        font-size: 30px;
        font-weight: 800;
        color: #142d4e;
    }

    /* بطاقة جدول الطلاب */

    .students-table-card {
        background: white;
        border: 1px solid #e5eaf0;
        border-radius: 15px;
        overflow: hidden;
    }

    .students-table-title {
        padding: 22px;
        border-bottom: 1px solid #e5eaf0;
    }

        .students-table-title h4 {
            margin: 0;
            font-weight: 800;
            font-size: 19px;
        }

    /* البحث والتصفية */

    .students-filters {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 15px;
        padding: 20px 22px;
        background: #f8f9fc;
    }

    .students-filter-input {
        width: 100%;
        border: 1px solid #dce3ed;
        border-radius: 10px;
        padding: 12px 15px;
        background: white;
        color: #142d4e;
    }

        .students-filter-input:focus {
            outline: none;
            border-color: #c9a24d;
            box-shadow: 0 0 0 3px rgba(201, 162, 77, 0.12);
        }

    /* الجدول */

    .students-table-wrapper {
        overflow-x: auto;
    }

    .students-table {
        width: 100%;
        border-collapse: collapse;
        text-align: right;
    }

        .students-table thead {
            background: #142d4e;
            color: white;
        }

        .students-table th {
            padding: 15px;
            font-size: 14px;
            white-space: nowrap;
        }

        .students-table td {
            padding: 15px;
            border-bottom: 1px solid #edf0f5;
            vertical-align: middle;
            font-size: 14px;
        }

        .students-table tbody tr:hover {
            background: #fafbfd;
        }

    /* الرقم الجامعي */

    .students-number {
        font-weight: 700;
        color: #142d4e;
        direction: ltr;
        display: inline-block;
    }

    /* أزرار الإجراءات الموحدة */

    .students-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .students-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 43px;
        padding: 9px 15px;
        border-radius: 11px;
        border: 1px solid transparent;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        white-space: nowrap;
        transition: background-color 0.2s ease, transform 0.2s ease;
    }

        .students-action-btn i {
            font-size: 16px;
        }

    /* عرض التفاصيل */

    .students-details-btn {
        background: #eef2f8;
        color: #142d4e;
    }

        .students-details-btn:hover {
            background: #dfe7f2;
            color: #142d4e;
            transform: translateY(-1px);
        }

    /* تعديل */

    .students-edit-btn {
        background: #c9a24d;
        color: #142d4e;
    }

        .students-edit-btn:hover {
            background: #b9913d;
            color: #142d4e;
            transform: translateY(-1px);
        }

    /* حذف */

    .students-delete-btn {
        background: #fff0ee;
        color: #c62828;
        border-color: #ffc5bf;
    }

        .students-delete-btn:hover {
            background: #ffe0dc;
            color: #a91e1e;
            border-color: #f2a8a0;
            transform: translateY(-1px);
        }

    .students-action-btn:focus-visible {
        outline: 3px solid #142d4e;
        outline-offset: 3px;
    }

    /* لا توجد نتائج */

    .students-empty {
        text-align: center;
        padding: 45px 20px;
        color: #718096;
    }

        .students-empty i {
            font-size: 42px;
            color: #c9a24d;
            display: block;
            margin-bottom: 15px;
        }

    /* عدد الطلاب الظاهرين */

    .students-count-footer {
        padding: 15px 22px;
        color: #718096;
        font-size: 13px;
        border-top: 1px solid #edf0f5;
    }

    /* الشاشات الصغيرة */

    @@media (max-width: 700px) {
        .students-stats,
        .students-filters {
            grid-template-columns: 1fr;
        }

        .students-header h2 {
            font-size: 22px;
        }
    }
</style>

<div class="students-page">

    <!-- رأس الصفحة -->

    <div class="students-header">

        <div>
            <h2>
                <i class="bi bi-people-fill"></i>
                إدارة الطلاب
            </h2>

            <p>
                عرض وإدارة بيانات الطلاب المسجلين في الجامعة
            </p>
        </div>

        <a asp-controller="Students"
           asp-action="Create"
           class="students-add-btn">

            <i class="bi bi-person-plus"></i>
            إضافة طالب جديد

        </a>

    </div>

    <!-- الإحصائيات -->

    <div class="students-stats">

        <div class="students-stat-card">

            <div class="students-stat-label">
                إجمالي الطلاب المسجلين
            </div>

            <div class="students-stat-value">
                @totalStudents
            </div>

        </div>

        <div class="students-stat-card">

            <div class="students-stat-label">
                الأقسام التي تضم طلابًا
            </div>

            <div class="students-stat-value">
                @totalDepartments
            </div>

        </div>

    </div>

    <!-- جدول الطلاب -->

    <div class="students-table-card">

        <div class="students-table-title">

            <h4>
                <i class="bi bi-list-ul"></i>
                قائمة الطلاب
            </h4>

        </div>

        <!-- البحث والتصفية -->

        <div class="students-filters">

            <input type="text"
                   id="studentSearch"
                   class="students-filter-input"
                   placeholder="ابحث باسم الطالب أو الرقم الجامعي..."
                   aria-label="البحث عن طالب" />

            <select id="departmentFilter"
                    class="students-filter-input"
                    aria-label="تصفية الطلاب حسب القسم">

                <option value="">جميع الأقسام</option>

                @foreach (var department in departments)
                {
                    <option value="@department.Id">
                        @department.Name
                    </option>
                }

            </select>

        </div>

        <div class="students-table-wrapper">

            <table class="students-table">

                <thead>
                    <tr>
                        <th>الرقم الجامعي</th>
                        <th>اسم الطالب</th>
                        <th>القسم الأكاديمي</th>
                        <th>فصل القبول</th>
                        <th>رقم الهاتف</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>

                <tbody id="studentsTableBody">

                    @foreach (var student in students)
                    {
                        var fullName = string.Join(" ",
                            new[]
                            {
                                student.FirstName,
                                student.FatherName,
                                student.LastName
                            }.Where(n => !string.IsNullOrWhiteSpace(n)));

                        <tr class="student-row"
                            data-department="@student.DepartmentId">

                            <!-- الرقم الجامعي -->

                            <td>
                                <span class="students-number">
                                    @student.UniversityNumber
                                </span>
                            </td>

                            <!-- اسم الطالب -->

                            <td>
                                <strong>@fullName</strong>
                            </td>

                            <!-- القسم الأكاديمي -->

                            <td>
                                @(student.Department?.Name ?? "غير محدد")
                            </td>

                            <!-- فصل القبول -->

                            <td>
                                @(student.AdmissionSemester?.Name ?? "غير محدد")
                            </td>

                            <!-- رقم الهاتف -->

                            <td>
                                @(student.Phone ?? "غير محدد")
                            </td>

                            <!-- الإجراءات -->

                            <td>

                                <div class="students-actions">

                                    <!-- عرض التفاصيل -->

                                    <a asp-controller="Students"
                                       asp-action="Details"
                                       asp-route-id="@student.Id"
                                       class="students-action-btn students-details-btn"
                                       aria-label="عرض تفاصيل الطالب @fullName">

                                        <i class="bi bi-eye"></i>
                                        عرض التفاصيل

                                    </a>

                                    <!-- تعديل: المدير فقط -->
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-controller="Students"
                                           asp-action="Edit"
                                           asp-route-id="@student.Id"
                                           class="students-action-btn students-edit-btn"
                                           aria-label="تعديل الطالب @fullName">

                                            <i class="bi bi-pencil-square"></i>
                                            تعديل

                                        </a>
                                    }

                                    <!-- حذف: حسب الصلاحية -->
                                    @if (canDeleteStudents)
                                    {
                                        <a asp-controller="Students"
                                           asp-action="Delete"
                                           asp-route-id="@student.Id"
                                           class="students-action-btn students-delete-btn"
                                           aria-label="حذف الطالب @fullName">

                                            <i class="bi bi-trash3"></i>
                                            حذف

                                        </a>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- عدم وجود نتائج بحث -->

        <div id="noSearchResults"
             class="students-empty"
             style="display:none;">

            <i class="bi bi-search"></i>

            لا يوجد طلاب مطابقون للبحث.

        </div>

        @if (!students.Any())
        {
            <div class="students-empty">

                <i class="bi bi-person-lines-fill"></i>

                لا يوجد طلاب مسجلون حاليًا.

                <div>
                    يمكنكم إضافة أول طالب من الزر الموجود بالأعلى.
                </div>

            </div>
        }

        <!-- عدد الطلاب الظاهرين -->

        <div class="students-count-footer">

            عدد الطلاب الظاهرين:

            <span id="visibleStudentsCount">
                @totalStudents
            </span>

        </div>

    </div>

</div>

<!-- البحث والفلترة -->

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const searchInput =
            document.getElementById("studentSearch");

        const departmentFilter =
            document.getElementById("departmentFilter");

        const rows =
            document.querySelectorAll(".student-row");

        const visibleCount =
            document.getElementById("visibleStudentsCount");

        const noResults =
            document.getElementById("noSearchResults");

        if (!searchInput || !departmentFilter) {
            return;
        }

        function filterStudents() {

            const searchText =
                searchInput.value.trim().toLowerCase();

            const selectedDepartment =
                departmentFilter.value;

            let count = 0;

            rows.forEach(function (row) {

                const rowText =
                    row.textContent.toLowerCase();

                const rowDepartment =
                    row.getAttribute("data-department");

                const matchesSearch =
                    rowText.includes(searchText);

                const matchesDepartment =
                    !selectedDepartment ||
                    rowDepartment === selectedDepartment;

                const show =
                    matchesSearch && matchesDepartment;

                row.style.display = show ? "" : "none";

                if (show) {
                    count++;
                }
            });

            if (visibleCount) {
                visibleCount.textContent = count;
            }

            if (noResults) {
                noResults.style.display =
                    rows.length > 0 && count === 0
                        ? "block"
                        : "none";
            }
        }

        searchInput.addEventListener(
            "input",
            filterStudents
        );

        departmentFilter.addEventListener(
            "change",
            filterStudents
        );

    });
</script>
