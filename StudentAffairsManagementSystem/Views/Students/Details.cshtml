@model StudentAffairsManagementSystem.Models.Student

@{
    ViewData["Title"] = "تفاصيل الطالب";

    bool canDeleteStudents =
        ViewBag.CanDeleteStudents is bool allowed && allowed;

    var fullName = string.Join(" ", new[]
    {
        Model.FirstName,
        Model.FatherName,
        Model.LastName
    }.Where(n => !string.IsNullOrWhiteSpace(n)));
}

<style>
    .student-details-page {
        direction: rtl;
        max-width: 1100px;
        margin: 20px auto;
        color: #142d4e;
    }

    /* رأس الصفحة */

    .student-details-header {
        background: linear-gradient(135deg, #142d4e, #304661);
        color: #ffffff;
        padding: 28px 32px;
        border-radius: 16px 16px 0 0;
        border-bottom: 4px solid #c9a24d;
    }

        .student-details-header h2 {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 25px;
            font-weight: 800;
            margin: 0 0 10px;
        }

            .student-details-header h2 i {
                color: #c9a24d;
                font-size: 27px;
            }

        .student-details-header p {
            color: #d6dfeb;
            font-size: 14px;
            line-height: 1.9;
            margin: 0;
        }

    /* بطاقة الصفحة */

    .student-details-body {
        background: #ffffff;
        padding: 30px;
        border: 1px solid #e5eaf2;
        border-radius: 0 0 16px 16px;
        box-shadow: 0 5px 25px rgba(20,45,78,.05);
    }

    /* بطاقة الطالب */

    .student-profile {
        display: flex;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
        padding: 22px;
        background: #f7f9fc;
        border: 1px solid #e9edf3;
        border-right: 4px solid #c9a24d;
        border-radius: 12px;
        margin-bottom: 30px;
    }

    .student-avatar {
        width: 76px;
        height: 76px;
        border-radius: 50%;
        background: #f4eddd;
        color: #b9913d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
        flex-shrink: 0;
    }

    .student-profile-info {
        min-width: 0;
        flex: 1;
    }

    .student-profile-name {
        color: #142d4e;
        font-size: 23px;
        font-weight: 800;
        margin-bottom: 9px;
        overflow-wrap: anywhere;
    }

    .student-profile-number {
        color: #66758b;
        font-size: 14px;
        line-height: 1.8;
    }

        .student-profile-number strong {
            color: #142d4e;
            font-weight: 800;
            unicode-bidi: isolate;
        }

    /* أقسام التفاصيل */

    .student-details-section {
        margin-bottom: 30px;
        padding-bottom: 26px;
        border-bottom: 1px solid #e9edf3;
    }

        .student-details-section h3 {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #142d4e;
            font-size: 18px;
            font-weight: 800;
            border-right: 4px solid #c9a24d;
            padding-right: 13px;
            margin-bottom: 23px;
        }

            .student-details-section h3 i {
                color: #b9913d;
                font-size: 20px;
            }

    /* شبكة المعلومات */

    .student-details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .student-details-item {
        background: #f8f9fc;
        border: 1px solid #edf0f5;
        border-radius: 11px;
        padding: 17px 19px;
        min-width: 0;
    }

    .student-details-label {
        display: block;
        color: #718096;
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 9px;
    }

    .student-details-value {
        display: block;
        color: #142d4e;
        font-size: 14px;
        font-weight: 800;
        line-height: 1.9;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
    }

    /* معلومات الملفات */

    .student-document-value {
        color: #526174;
        font-size: 13px;
        overflow-wrap: anywhere;
    }

    /* أزرار الصفحة */

    .student-details-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
    }

    .student-details-back,
    .student-details-delete {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 45px;
        padding: 11px 22px;
        border-radius: 11px;
        font-size: 14px;
        font-weight: 800;
        text-decoration: none;
        transition: background-color .2s ease;
    }

    .student-details-back {
        background: #edf1f7;
        color: #142d4e;
        border: 1px solid #dfe6ef;
    }

        .student-details-back:hover {
            background: #e1e8f2;
            color: #142d4e;
        }

    .student-details-delete {
        background: #fff0ee;
        color: #b42318;
        border: 1px solid #f1d8d5;
    }

        .student-details-delete:hover {
            background: #f9dfdc;
            color: #982626;
        }

        .student-details-back:focus-visible,
        .student-details-delete:focus-visible {
            outline: 3px solid #142d4e;
            outline-offset: 3px;
        }

    /* الشاشات الصغيرة */

    @@media (max-width: 700px) {
        .student-details-grid {
            grid-template-columns: 1fr;
        }

        .student-details-body {
            padding: 20px;
        }

        .student-details-header {
            padding: 22px;
        }

            .student-details-header h2 {
                font-size: 21px;
            }

        .student-profile {
            padding: 18px;
            gap: 15px;
        }

        .student-profile-name {
            font-size: 19px;
        }

        .student-avatar {
            width: 65px;
            height: 65px;
            font-size: 29px;
        }

        .student-details-actions {
            flex-direction: column;
        }

        .student-details-back,
        .student-details-delete {
            width: 100%;
        }
    }
</style>

<div class="student-details-page">

    <!-- عنوان الصفحة -->

    <div class="student-details-header">

        <h2>
            <i class="bi bi-person-vcard"></i>
            تفاصيل الطالب
        </h2>

        <p>
            الملف الشخصي والأكاديمي للطالب
        </p>

    </div>

    <div class="student-details-body">

        <!-- بطاقة الطالب -->

        <div class="student-profile">

            <div class="student-avatar">
                <i class="bi bi-person-fill"></i>
            </div>

            <div class="student-profile-info">

                <div class="student-profile-name">
                    @fullName
                </div>

                <div class="student-profile-number">
                    الرقم الجامعي:
                    <strong dir="ltr">@Model.UniversityNumber</strong>
                </div>

            </div>

        </div>

        <!-- المعلومات الشخصية -->

        <div class="student-details-section">

            <h3>
                <i class="bi bi-person-vcard"></i>
                المعلومات الشخصية
            </h3>

            <div class="student-details-grid">

                <div class="student-details-item">
                    <span class="student-details-label">
                        الاسم الأول
                    </span>
                    <span class="student-details-value">
                        @Model.FirstName
                    </span>
                </div>

                <div class="student-details-item">
                    <span class="student-details-label">
                        اسم الأب
                    </span>
                    <span class="student-details-value">
                        @Model.FatherName
                    </span>
                </div>

                <div class="student-details-item">
                    <span class="student-details-label">
                        اسم الأم
                    </span>
                    <span class="student-details-value">
                        @Model.MotherName
                    </span>
                </div>

                <div class="student-details-item">
                    <span class="student-details-label">
                        الكنية
                    </span>
                    <span class="student-details-value">
                        @Model.LastName
                    </span>
                </div>

                <div class="student-details-item">
                    <span class="student-details-label">
                        تاريخ الميلاد
                    </span>
                    <span class="student-details-value">
                        @Model.BirthDate.ToString("yyyy/MM/dd")
                    </span>
                </div>

                <div class="student-details-item">
                    <span class="student-details-label">
                        الجنس
                    </span>
                    <span class="student-details-value">
                        @(string.IsNullOrWhiteSpace(Model.Gender)
                            ? "غير محدد"
                            : Model.Gender)
                    </span>
                </div>

                <div class="student-details-item">
                    <span class="student-details-label">
                        الرقم الوطني
                    </span>
                    <span class="student-details-value">
                        @(string.IsNullOrWhiteSpace(Model.NationalId)
                            ? "غير محدد"
                            : Model.NationalId)
                    </span>
                </div>

                <div class="student-details-item">
                    <span class="student-details-label">
                        الجنسية
                    </span>
                    <span class="student-details-value">
                        @(string.IsNullOrWhiteSpace(Model.Nationality)
                            ? "غير محدد"
                            : Model.Nationality)
                    </span>
                </div>

            </div>

        </div>

        <!-- المعلومات الأكاديمية -->

        <div class="student-details-section">

            <h3>
                <i class="bi bi-mortarboard-fill"></i>
                المعلومات الأكاديمية
            </h3>

            <div class="student-details-grid">

                <div class="student-details-item">
                    <span class="student-details-label">
                        القسم الأكاديمي
                    </span>
                    <span class="student-details-value">
                        @(Model.Department?.Name ?? "غير محدد")
                    </span>
                </div>

                <div class="student-details-item">
                    <span class="student-details-label">
                        فصل القبول
                    </span>
                    <span class="student-details-value">
                        @(Model.AdmissionSemester?.Name ?? "غير محدد")
                    </span>
                </div>

                <div class="student-details-item">
                    <span class="student-details-label">
                        فصل التخرج
                    </span>
                    <span class="student-details-value">
                        @(Model.GraduationSemester?.Name ?? "لم يتخرج بعد")
                    </span>
                </div>

                <div class="student-details-item">
                    <span class="student-details-label">
                        الحالة الدراسية
                    </span>
                    <span class="student-details-value">
                        @(string.IsNullOrWhiteSpace(Model.Status)
                            ? "غير محددة"
                            : Model.Status)
                    </span>
                </div>

                <div class="student-details-item">
                    <span class="student-details-label">
                        معدل التخرج
                    </span>
                    <span class="student-details-value">
                        @(Model.GraduationAverage.HasValue
                            ? Model.GraduationAverage.Value.ToString("0.00")
                            : "غير متوفر")
                    </span>
                </div>

            </div>

        </div>

        <!-- معلومات التواصل -->

        <div class="student-details-section">

            <h3>
                <i class="bi bi-telephone-fill"></i>
                معلومات التواصل
            </h3>

            <div class="student-details-grid">

                <div class="student-details-item">
                    <span class="student-details-label">
                        رقم الهاتف
                    </span>
                    <span class="student-details-value">
                        @(string.IsNullOrWhiteSpace(Model.Phone)
                            ? "غير محدد"
                            : Model.Phone)
                    </span>
                </div>

                <div class="student-details-item">
                    <span class="student-details-label">
                        المحافظة
                    </span>
                    <span class="student-details-value">
                        @(string.IsNullOrWhiteSpace(Model.Governorate)
                            ? "غير محددة"
                            : Model.Governorate)
                    </span>
                </div>

                <div class="student-details-item">
                    <span class="student-details-label">
                        العنوان
                    </span>
                    <span class="student-details-value">
                        @(string.IsNullOrWhiteSpace(Model.Address)
                            ? "غير محدد"
                            : Model.Address)
                    </span>
                </div>

            </div>

        </div>

        <!-- الصور والوثائق -->

        <div class="student-details-section">

            <h3>
                <i class="bi bi-folder2-open"></i>
                الصور والوثائق
            </h3>

            <div class="student-details-grid">

                <div class="student-details-item">

                    <span class="student-details-label">
                        الصورة الشخصية
                    </span>

                    @if (!string.IsNullOrWhiteSpace(Model.PersonalImage))
                    {
                        <span class="student-details-value student-document-value">
                            مسار الملف: @Model.PersonalImage
                        </span>
                    }
                    else
                    {
                        <span class="student-details-value">
                            غير مرفقة
                        </span>
                    }

                </div>

                <div class="student-details-item">

                    <span class="student-details-label">
                        صورة الهوية
                    </span>

                    @if (!string.IsNullOrWhiteSpace(Model.NationalIdImage))
                    {
                        <span class="student-details-value student-document-value">
                            مسار الملف: @Model.NationalIdImage
                        </span>
                    }
                    else
                    {
                        <span class="student-details-value">
                            غير مرفقة
                        </span>
                    }

                </div>

                <div class="student-details-item">

                    <span class="student-details-label">
                        صورة الشهادة
                    </span>

                    @if (!string.IsNullOrWhiteSpace(Model.CertificateImage))
                    {
                        <span class="student-details-value student-document-value">
                            مسار الملف: @Model.CertificateImage
                        </span>
                    }
                    else
                    {
                        <span class="student-details-value">
                            غير مرفقة
                        </span>
                    }

                </div>

            </div>

        </div>

        <!-- أزرار الصفحة -->

        <div class="student-details-actions">

            <a asp-controller="Students"
               asp-action="Index"
               class="student-details-back">

                <i class="bi bi-arrow-right"></i>
                العودة إلى قائمة الطلاب

            </a>

            @if (canDeleteStudents)
            {
                <a asp-controller="Students"
                   asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="student-details-delete">

                    <i class="bi bi-trash3"></i>
                    حذف الطالب

                </a>
            }

        </div>

    </div>

</div>
