@{
    ViewData["Title"] = "تسجيل المقررات الدراسية";
}

<style>
    .registration-page {
        direction: rtl;
        color: #142d4e;
        padding-top: 20px;
        padding-bottom: 25px;
    }

    /* عنوان الصفحة */

    .registration-page-header {
        margin-bottom: 28px;
    }

        .registration-page-header h2 {
            font-size: 27px;
            font-weight: 800;
            color: #142d4e;
            margin-bottom: 8px;
        }

        .registration-page-header p {
            color: #718096;
            margin-bottom: 0;
            line-height: 1.9;
        }

    /* بطاقة البحث */

    .registration-search-card {
        background: #ffffff;
        border: 1px solid #e5eaf0;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 3px 12px rgba(20, 45, 78, 0.05);
    }

    .registration-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #142d4e;
        color: #ffffff;
        padding: 18px 24px;
        font-size: 18px;
        font-weight: 800;
    }

        .registration-card-header i {
            font-size: 20px;
        }

    .registration-card-body {
        padding: 30px;
    }

    /* حقل الرقم الجامعي */

    .registration-field-label {
        display: block;
        font-weight: 800;
        margin-bottom: 12px;
        color: #142d4e;
    }

    .registration-number-input {
        width: 100%;
        min-height: 48px;
        border: 1px solid #d6dee9;
        border-radius: 11px;
        padding: 12px 15px;
        background: #ffffff;
        color: #142d4e;
        font-size: 15px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .registration-number-input:focus {
            outline: none;
            border-color: #c9a24d;
            box-shadow: 0 0 0 3px rgba(201, 162, 77, 0.14);
        }

        .registration-number-input::placeholder {
            color: #9aa5b5;
        }

    /* زر البحث الموحد */

    .registration-search-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        width: 100%;
        min-height: 48px;
        padding: 12px 20px;
        background: #c9a24d;
        color: #142d4e;
        border: 1px solid transparent;
        border-radius: 11px;
        font-size: 15px;
        font-weight: 800;
        cursor: pointer;
        white-space: nowrap;
        transition: background-color 0.2s ease, transform 0.2s ease;
    }

        .registration-search-button i {
            font-size: 17px;
        }

        .registration-search-button:hover {
            background: #b9913d;
            color: #142d4e;
            transform: translateY(-1px);
        }

        .registration-search-button:focus-visible {
            outline: 3px solid #142d4e;
            outline-offset: 3px;
        }

    /* صندوق الملاحظة */

    .registration-info-box {
        background: #f8f9fc;
        border: 1px solid #e5eaf0;
        border-radius: 11px;
        padding: 18px 20px;
        color: #52647b;
        line-height: 1.9;
        margin-top: 24px;
    }

    /* رسائل النظام */

    .registration-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        border-radius: 11px;
        padding: 15px 18px;
        margin-bottom: 20px;
    }

        .registration-alert i {
            font-size: 19px;
        }

    /* الشاشات الصغيرة */

    @@media (max-width: 768px) {
        .registration-page-header h2 {
            font-size: 23px;
        }

        .registration-card-body {
            padding: 20px;
        }

        .registration-card-header {
            padding: 17px 20px;
        }

        .registration-search-button {
            width: 100%;
        }
    }
</style>

<div class="container-fluid registration-page" dir="rtl">

    <!-- عنوان الصفحة -->

    <div class="registration-page-header">

        <h2>
            <i class="bi bi-journal-check"></i>
            تسجيل المقررات الدراسية
        </h2>

        <p>
            إدارة تسجيل المقررات الدراسية للطلاب
            من خلال الرقم الجامعي.
        </p>

    </div>

    <!-- رسائل الخطأ -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger registration-alert">

            <i class="bi bi-exclamation-circle"></i>

            <span>
                @TempData["Error"]
            </span>

        </div>
    }

    <!-- رسائل النجاح -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success registration-alert">

            <i class="bi bi-check-circle"></i>

            <span>
                @TempData["Success"]
            </span>

        </div>
    }

    <!-- بطاقة البحث عن طالب -->

    <div class="registration-search-card">

        <!-- عنوان البطاقة -->

        <div class="registration-card-header">

            <i class="bi bi-search"></i>

            البحث عن طالب

        </div>

        <!-- محتوى البطاقة -->

        <div class="registration-card-body">

            <form asp-controller="Registrations"
                  asp-action="StudentCourses"
                  method="get">

                <!-- الرقم الجامعي -->

                <label for="universityNumber"
                       class="registration-field-label">

                    الرقم الجامعي

                </label>

                <div class="row g-3 align-items-end">

                    <!-- حقل إدخال الرقم الجامعي -->

                    <div class="col-md-9">

                        <input type="text"
                               id="universityNumber"
                               name="universityNumber"
                               class="registration-number-input"
                               placeholder="أدخل الرقم الجامعي"
                               autocomplete="off"
                               required />

                    </div>

                    <!-- زر البحث -->

                    <div class="col-md-3">

                        <button type="submit"
                                class="registration-search-button">

                            <i class="bi bi-search"></i>

                            بحث

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>
