@{
    ViewData["Title"] = "تسجيل المقررات الدراسية";
}

<style>
    .registration-page {
        direction: rtl;
        color: #142d4e;
    }

    .registration-page-header {
        margin-bottom: 28px;
    }

        .registration-page-header h2 {
            font-size: 27px;
            font-weight: 800;
            color: #142d4e;
            margin-bottom: 8px;
        }

        .registration-page-header p {
            color: #718096;
            margin-bottom: 0;
        }

    .registration-search-card {
        background: #ffffff;
        border: 1px solid #e2e7ee;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 3px 12px rgba(20,45,78,.05);
    }

    .registration-card-header {
        background: #142d4e;
        color: #ffffff;
        padding: 18px 24px;
        font-size: 18px;
        font-weight: 700;
    }

    .registration-card-body {
        padding: 30px;
    }

    .registration-field-label {
        display: block;
        font-weight: 700;
        margin-bottom: 10px;
        color: #142d4e;
    }

    .registration-number-input {
        width: 100%;
        min-height: 48px;
        border: 1px solid #d6dee9;
        border-radius: 8px;
        padding: 12px 15px;
        background: #fff;
        color: #142d4e;
    }

        .registration-number-input:focus {
            outline: none;
            border-color: #c9a24d;
            box-shadow: 0 0 0 3px rgba(201,162,77,.14);
        }

    .registration-search-button {
        background: #c9a24d;
        color: #142d4e;
        border: none;
        border-radius: 8px;
        padding: 12px 24px;
        min-height: 48px;
        font-weight: 800;
        white-space: nowrap;
    }

        .registration-search-button:hover {
            background: #b99343;
        }

    .registration-info-box {
        background: #f8f9fc;
        border: 1px solid #e2e7ee;
        border-radius: 9px;
        padding: 18px 20px;
        color: #52647b;
        line-height: 1.9;
        margin-top: 24px;
    }

    @@media (max-width: 768px) {
        .registration-card-body {
            padding: 20px;
        }

        .registration-search-button {
            width: 100%;
        }
    }
</style>

<div class="container-fluid py-4 registration-page">

    <!-- عنوان الصفحة -->
    <div class="registration-page-header">

        <h2>
            تسجيل المقررات الدراسية
        </h2>

        <p>
            إدارة تسجيل المقررات الدراسية للطلاب
            من خلال الرقم الجامعي.
        </p>

    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-circle"></i>
            @TempData["Error"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle"></i>
            @TempData["Success"]
        </div>
    }

    <!-- بطاقة البحث -->
    <div class="registration-search-card">

        <div class="registration-card-header">
            <i class="bi bi-search"></i>
            البحث عن طالب
        </div>

        <div class="registration-card-body">

            <form asp-controller="Registrations"
                  asp-action="StudentCourses"
                  method="get">

                <label for="universityNumber"
                       class="registration-field-label">
                    الرقم الجامعي
                </label>

                <div class="row g-3 align-items-end">

                    <div class="col-md-9">

                        <input type="text"
                               id="universityNumber"
                               name="universityNumber"
                               class="registration-number-input"
                               placeholder="أدخل الرقم الجامعي"
                               autocomplete="off"
                               required />

                    </div>

                    <div class="col-md-3">

                        <button type="submit"
                                class="registration-search-button w-100">

                            <i class="bi bi-search"></i>
                            بحث

                        </button>

                    </div>

                </div>

            </form>

         

        </div>

    </div>

</div>
