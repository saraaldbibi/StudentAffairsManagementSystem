
@model StudentAffairsManagementSystem.Models.Registration

@{
    ViewData["Title"] = "تسجيل طالب بمقرر";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 style="color:#142d4e; font-weight:800;">
                تسجيل طالب بمقرر دراسي
            </h2>

            <p class="text-muted mb-0">
                تسجيل الطلاب في المقررات المطروحة ضمن الفصول الدراسية الفعّالة
            </p>
        </div>

        <a asp-controller="Registrations"
           asp-action="Index"
           class="btn btn-outline-secondary px-4">
            العودة للتسجيلات
        </a>

    </div>

    <div class="row justify-content-center">

        <div class="col-lg-9 col-xl-8">

            <div class="card border-0 shadow-sm">

                <!-- رأس البطاقة -->
                <div class="card-header py-3"
                     style="background:#142d4e; color:white;">

                    <h5 class="mb-0">
                        بيانات التسجيل الجديد
                    </h5>

                </div>

                <div class="card-body p-4">

                    <form asp-controller="Registrations"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- رسائل أخطاء التحقق -->
                        <div asp-validation-summary="All"
                             class="alert alert-danger"
                             role="alert"
                             id="registrationValidationSummary"></div>

                        <div class="row g-4">

                            <!-- اختيار الطالب -->
                            <div class="col-md-12">

                                <label asp-for="StudentId"
                                       class="form-label fw-bold">
                                    الطالب
                                    <span class="text-danger">*</span>
                                </label>

                                <select asp-for="StudentId"
                                        asp-items="ViewBag.StudentId"
                                        class="form-select">
                                    <option value="0">
                                        -- اختاروا الطالب من القائمة --
                                    </option>
                                </select>

                                <span asp-validation-for="StudentId"
                                      class="text-danger small"></span>

                                <div class="form-text">
                                    تظهر أسماء الطلاب غير المحذوفين فقط،
                                    مع أرقامهم الجامعية.
                                </div>

                            </div>

                            <!-- اختيار المقرر المطروح -->
                            <div class="col-md-12">

                                <label asp-for="CourseOfferingId"
                                       class="form-label fw-bold">
                                    المقرر المطروح
                                    <span class="text-danger">*</span>
                                </label>

                                <select asp-for="CourseOfferingId"
                                        asp-items="ViewBag.CourseOfferingId"
                                        class="form-select">
                                    <option value="0">
                                        -- اختاروا المقرر المطروح --
                                    </option>
                                </select>

                                <span asp-validation-for="CourseOfferingId"
                                      class="text-danger small"></span>

                                <div class="form-text">
                                    تظهر فقط المقررات المطروحة ضمن
                                    الفصول الدراسية الفعّالة.
                                </div>

                            </div>

                        </div>

                        <!-- توضيح آلية التسجيل -->
                        <div class="alert alert-light border mt-4 mb-0">

                            <h6 class="fw-bold mb-3"
                                style="color:#142d4e;">
                                شروط تسجيل الطالب
                            </h6>

                            <ul class="mb-0">

                                <li class="mb-2">
                                    يجب أن يكون الطالب موجودًا وغير محذوف من النظام.
                                </li>

                                <li class="mb-2">
                                    يجب أن يكون المقرر مطروحًا ضمن فصل دراسي فعّال.
                                </li>

                                <li class="mb-2">
                                    لا يمكن تسجيل الطالب مرتين بنفس المقرر المطروح
                                    بحالة تسجيل فعّالة.
                                </li>

                                <li class="mb-2">
                                    يجب وجود مقعد شاغر ضمن السعة الاستيعابية.
                                </li>

                                <li>
                                    يتم تحديد تاريخ ووقت التسجيل تلقائيًا
                                    من السيرفر عند الحفظ.
                                </li>

                            </ul>

                        </div>

                        <!-- أزرار الإجراءات -->
                        <div class="d-flex justify-content-end gap-2 flex-wrap mt-4">

                            <a asp-controller="Registrations"
                               asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                إلغاء والعودة
                            </a>

                            <button type="submit"
                                    class="btn px-4"
                                    style="background:#c9a24d;
                                           color:#142d4e;
                                           font-weight:800;">
                                حفظ تسجيل الطالب
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const summary = document.getElementById(
                "registrationValidationSummary"
            );

            if (summary && summary.querySelectorAll("li").length === 0) {
                summary.style.display = "none";
            }
        });
    </script>
}
